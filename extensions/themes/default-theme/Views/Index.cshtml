@*
    The site root when no root page ("/") is published: a list of the live pages (Model = title + slug).
*@
@model List<(string Title, string Slug)>
@{
    ViewData["Title"] = null;
    var extension = (ExtensionContext)ViewData["Extension"]!;
}
<section class="hero">
    <h1>@ViewData["AppName"]</h1>
    <p class="lead">@extension.GetString("tagline")</p>
</section>
@if (Model.Count == 0)
{
    <p class="muted">Nothing is published yet. Create a page in the <a href="/admin/content">Content Manager</a>.</p>
}
else
{
    <ul class="page-list">
        @foreach (var item in Model)
        {
            <li><a href="/@item.Slug">@item.Title</a></li>
        }
    </ul>
}
