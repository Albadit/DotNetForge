{
  "id": "dotnetforge.connector.s3",
  "name": "S3 Media Storage",
  "description": "Stores and serves media in an S3-compatible bucket of its own instead of the CMS's configured storage.",
  "version": "3.0.0",
  "type": "connector",
  "author": "Cloudforge",
  "assembly": "bin/S3Storage.dll",
  "entryPoint": "S3Storage.S3StorageConnector",
  "permissions": ["media.read", "media.upload", "media.delete"],
  "website": "https://example.com/extensions/s3-storage",
  "license": "MIT",
  "dependencies": [],
  "routes": [],
  "settings": {
    // The defaults match the local S3 server of docker/s3/seaweedfs.yml (docker compose -f docker/s3/seaweedfs.yml up -d).
    // Credentials never go here: set S3_CONNECTOR_ACCESS_KEY_ID and S3_CONNECTOR_SECRET_ACCESS_KEY in .env.
    "serviceUrl": "http://localhost:8333",
    "bucket": "dotnetforge",
    "region": "auto",
    "forcePathStyle": true
  }
}
