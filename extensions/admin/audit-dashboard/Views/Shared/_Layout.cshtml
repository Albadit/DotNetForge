@{
    // Shared layout for the extension's views. The host passes the base URL for this extension's
    // static assets (served from Views/Resources) via ViewData["ResourceBase"].
    var resourceBase = ViewData["ResourceBase"] as string ?? string.Empty;
}<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="@resourceBase/css/index.css" />
</head>
<body>
    @RenderBody()
    <script src="@resourceBase/js/index.js"></script>
</body>
</html>
