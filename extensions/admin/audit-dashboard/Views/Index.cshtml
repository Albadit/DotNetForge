@*
    Audit Dashboard admin extension - main view. MVC-style layout within the extension:
      Views/Index.cshtml           (this page - a <main> body)
      Views/_ViewImports.cshtml    (@using + @inject shared by the extension's views)
      Views/_ViewStart.cshtml      (sets the shared layout)
      Views/Shared/_Layout.cshtml  (the document shell + asset links)
      Views/Resources/css|js/      (static assets, served via the extension resource endpoint)
    Rendered server-side via runtime Razor compilation; the manifest settings arrive in ViewData.
*@
@{
    ViewData["Title"] = "Audit Dashboard";
    var settings = ViewData["Settings"] as IDictionary<string, object?> ?? new Dictionary<string, object?>();
    var showFailedLogins = !(settings.TryGetValue("showFailedLogins", out var sfl) && sfl is bool sb && !sb);

    var entries = await Db.AuditLogs.AsNoTracking().OrderByDescending(a => a.Id).Take(50).ToListAsync();
    var failedLogins = await Db.AuditLogs.CountAsync(a => a.Action == AuditActions.UserLoginFailed);
    var lastActivity = entries.Count > 0 ? entries[0].Timestamp.ToLocalTime().ToString("g") : "-";
}
<main class="wrap">
    <header>
        <div>
            <h1>Audit Dashboard</h1>
            <div class="sub">Recent administrative activity across the CMS.</div>
        </div>
    </header>

    <div class="stats">
        <div class="stat"><div class="icon">📜</div><div><div class="v">@entries.Count</div><div class="l">Recent events</div></div></div>
        @if (showFailedLogins)
        {
            <div class="stat"><div class="icon">🛡️</div><div><div class="v">@failedLogins</div><div class="l">Failed logins</div></div></div>
        }
        <div class="stat"><div class="icon">⏱️</div><div><div class="v">@lastActivity</div><div class="l">Last activity</div></div></div>
    </div>

    @if (entries.Count == 0)
    {
        <div class="empty">No audit activity yet.</div>
    }
    else
    {
        <table>
            <thead>
                <tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Result</th><th>IP</th></tr>
            </thead>
            <tbody>
                @foreach (var a in entries)
                {
                    <tr>
                        <td class="muted">@a.Timestamp.ToLocalTime().ToString("g")</td>
                        <td>@(string.IsNullOrEmpty(a.UserDisplaySnapshot) ? "-" : a.UserDisplaySnapshot)</td>
                        <td><code>@a.Action</code></td>
                        <td>@(string.IsNullOrEmpty(a.EntityType) ? "-" : $"{a.EntityType} {a.EntityId}".Trim())</td>
                        <td>
                            @if (a.Success)
                            {
                                <span class="pill ok">ok</span>
                            }
                            else
                            {
                                <span class="pill fail">fail</span>
                            }
                        </td>
                        <td class="muted">@a.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <footer class="foot" id="ext-loaded"></footer>
</main>
