@*
    Audit Dashboard admin extension - main view. MVC-style layout within the extension:
      Views/Index.cshtml           (this page)
      Views/_ViewImports.cshtml    (@using + @inject + the DotNetForge UI tag helpers)
      Views/_ViewStart.cshtml      (sets the shared layout)
      Views/Shared/_Layout.cshtml  (the document shell: DotNetForge UI (dnf.css) + this extension's CSS/JS)
      Views/Resources/css|js/      (static assets, served via the extension resource endpoint)
    Rendered server-side via runtime Razor compilation; the manifest settings arrive in ViewData.
*@
@{
    ViewData["Title"] = "Audit Dashboard";
    var settings = ViewData["Settings"] as IDictionary<string, object?> ?? new Dictionary<string, object?>();
    var showFailedLogins = !(settings.TryGetValue("showFailedLogins", out var sfl) && sfl is bool sb && !sb);

    var logs = Db.AuditLogs.AsNoTracking();
    var entries = await logs.OrderByDescending(a => a.Id).Take(50).ToListAsync();
    var failedLogins = await logs.CountAsync(a => a.Action == AuditActions.UserLoginFailed);
}
<main class="audit-dashboard dnf-stack dnf-stack--lg">
    @* The admin shell around the iframe already shows the tab's title, so the page starts with its content. *@
    <h1 class="sr-only">Audit Dashboard</h1>
    <p class="text-muted">Recent administrative activity.</p>

    <div class="audit-dashboard__stats">
        <dnf-stat-card icon="activity" label="Recent events" value="@entries.Count.ToString()" />
        @if (showFailedLogins)
        {
            <dnf-stat-card icon="shield" label="Failed sign-ins" value="@failedLogins.ToString()" />
        }
        <dnf-stat-card icon="clock" label="Last activity" value="@(entries.Count > 0 ? DnfTimestampTagHelper.Relative(entries[0].Timestamp, DateTime.UtcNow) : "-")" />
    </div>

    <section class="dnf-card">
        @if (entries.Count == 0)
        {
            <dnf-empty-state icon="activity" title="No audit activity yet" />
        }
        else
        {
            <div class="dnf-table">
                <table class="dnf-table__table">
                    <thead>
                        <tr><th scope="col">When</th><th scope="col">User</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Result</th><th scope="col">IP</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in entries)
                        {
                            <tr>
                                <td class="text-nowrap"><dnf-timestamp value="@a.Timestamp" /></td>
                                <td>@(string.IsNullOrEmpty(a.UserDisplaySnapshot) ? "-" : a.UserDisplaySnapshot)</td>
                                <td><code>@a.Action</code></td>
                                <td>@(string.IsNullOrEmpty(a.EntityType) ? "-" : $"{a.EntityType} {a.EntityId}".Trim())</td>
                                <td>
                                    @if (a.Success)
                                    {
                                        <dnf-badge tone="Success" dot="true">ok</dnf-badge>
                                    }
                                    else
                                    {
                                        <dnf-badge tone="Danger" dot="true">fail</dnf-badge>
                                    }
                                </td>
                                <td class="text-muted font-mono text-sm">@a.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <footer class="text-xs text-subtle" id="ext-loaded"></footer>
</main>
