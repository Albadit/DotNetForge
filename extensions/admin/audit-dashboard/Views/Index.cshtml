@*
    Audit Dashboard admin extension - main view. MVC-style layout within the extension:
      Views/Index.cshtml           (this page)
      Views/_ViewImports.cshtml    (@using + @inject + the host's design-system tag helpers)
      Views/_ViewStart.cshtml      (sets the shared layout)
      Views/Shared/_Layout.cshtml  (the document shell: host design system + this extension's CSS/JS)
      Views/Resources/css|js/      (static assets, served via the extension resource endpoint)
    Rendered server-side via runtime Razor compilation; the manifest settings arrive in ViewData.
*@
@{
    ViewData["Title"] = "Audit Dashboard";
    var settings = ViewData["Settings"] as IDictionary<string, object?> ?? new Dictionary<string, object?>();
    var showFailedLogins = !(settings.TryGetValue("showFailedLogins", out var sfl) && sfl is bool sb && !sb);

    // Tenant-scoped like the core Audit Log screen: this tenant's entries plus system-wide ones (no tenant).
    Guid? tenantId = Guid.TryParse(User.FindFirst("dnf:tenant")?.Value, out var t) ? t : null;
    var scoped = Db.AuditLogs.AsNoTracking().Where(a => a.TenantId == tenantId || a.TenantId == null);
    var entries = await scoped.OrderByDescending(a => a.Id).Take(50).ToListAsync();
    var failedLogins = await scoped.CountAsync(a => a.Action == AuditActions.UserLoginFailed);
}
<main class="ext-page stack-lg">
    @* The admin shell around the iframe already shows the tab's title, so the page starts with its content. *@
    <h1 class="sr-only">Audit Dashboard</h1>
    <p class="text-muted">Recent administrative activity in this tenant.</p>

    <div class="ext-stats">
        <stat-card icon="activity" label="Recent events" value="@entries.Count.ToString()" />
        @if (showFailedLogins)
        {
            <stat-card icon="shield" label="Failed sign-ins" value="@failedLogins.ToString()" />
        }
        <stat-card icon="clock" label="Last activity" value="@(entries.Count > 0 ? TimestampTagHelper.Relative(entries[0].Timestamp, DateTime.UtcNow) : "-")" />
    </div>

    <section class="card">
        @if (entries.Count == 0)
        {
            <empty-state icon="activity" title="No audit activity yet" />
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr><th scope="col">When</th><th scope="col">User</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Result</th><th scope="col">IP</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in entries)
                        {
                            <tr>
                                <td class="text-nowrap"><timestamp value="@a.Timestamp" /></td>
                                <td>@(string.IsNullOrEmpty(a.UserDisplaySnapshot) ? "-" : a.UserDisplaySnapshot)</td>
                                <td><code>@a.Action</code></td>
                                <td>@(string.IsNullOrEmpty(a.EntityType) ? "-" : $"{a.EntityType} {a.EntityId}".Trim())</td>
                                <td>
                                    @if (a.Success)
                                    {
                                        <badge tone="Success" dot="true">ok</badge>
                                    }
                                    else
                                    {
                                        <badge tone="Danger" dot="true">fail</badge>
                                    }
                                </td>
                                <td class="text-muted text-mono text-sm">@a.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <footer class="text-xs text-subtle" id="ext-loaded"></footer>
</main>
