{
  "id": "dotnetforge.plugin.seo-toolkit",
  "name": "SEO Toolkit",
  "description": "Serves /sitemap.xml with every live page and /robots.txt pointing search engines at it.",
  "version": "3.2.0",
  "type": "plugin",
  "author": "RankForge",
  "assembly": "bin/SeoToolkit.dll",
  "entryPoint": "SeoToolkit.SeoToolkitPlugin",
  "permissions": ["content.read", "settings.read"],
  "website": "https://example.com/extensions/seo-toolkit",
  "license": "MIT",
  "dependencies": [],
  "routes": ["/sitemap.xml", "/robots.txt"],
  "settings": {
    "generateSitemap": true,
    // Extra "Disallow:" lines for robots.txt (the admin area is always disallowed).
    "disallow": ["/account/"]
  }
}
