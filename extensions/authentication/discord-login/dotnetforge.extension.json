{
  "id": "dotnetforge.auth.discord",
  "name": "Discord Login",
  "description": "Adds \"Sign in with Discord\" to the sign-in screen for users whose verified Discord email matches their CMS account.",
  "version": "2.0.0",
  "type": "authentication",
  "author": "Nimbus Integrations",
  "assembly": "bin/DiscordLogin.dll",
  "entryPoint": "DiscordLogin.DiscordLoginExtension",
  "permissions": ["users.read"],
  "website": "https://discord.com/developers/docs/topics/oauth2",
  "license": "Apache-2.0",
  "dependencies": [],
  "routes": ["/auth/discord/callback"],
  "settings": {
    // Register an application at https://discord.com/developers/applications, add the redirect
    // <APP_URL>/auth/discord/callback, then put DISCORD_CLIENT_ID and DISCORD_CLIENT_SECRET in .env.
    "scopes": ["identify", "email"]
  }
}
