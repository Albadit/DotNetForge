<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The code-size guardrails (.docs/guides/testing.md#guardrails): a Roslyn analyzer that every project of the solution
    runs at build time (Directory.Build.props) and the IDE shows while you type. Build tooling only: never part of the
    app. Analyzers load into the compiler, which needs netstandard2.0.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: release tracking is for analyzers shipped as packages; this one ships with the solution. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
