# ---- Secrets ----
# Secrets live in .env and must NEVER be committed. Only .env.example is tracked.
.env
.env.*
!.env.example

# ---- .NET build output ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# ---- Development runtime data ----
# storage/ only exists in Development (default SQLite database + local media). Production writes
# nothing here: the deployment directory is read-only (.docs/guides/deployment.md).
storage/

# SQLite database files.
*.db
*.db-shm
*.db-wal

# ---- Node / frontend tooling ----
node_modules/
npm-debug.log*
yarn-error.log*

# ---- IDE / OS ----
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Test / coverage ----
TestResults/
coverage/
*.coverage
*.trx

# Logs and local tool caches.
*.log
.cache/
