# ---- Secrets ----
# Secrets live in .env and must NEVER be committed. Only .env.example is tracked.
.env
.env.*
!.env.example

# ---- .NET build output ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# ---- Runtime artifacts (storage/) ----
# Uploaded media, backups, logs, and staged updates are never committed.
storage/media/
storage/backups/
storage/logs/
storage/updates/

# SQLite database files (default local provider).
*.db
*.db-shm
*.db-wal
storage/dotnetforge.db*

# ---- Node / frontend tooling ----
node_modules/
npm-debug.log*
yarn-error.log*

# ---- Admin SPA build output (run `npm run build` in Areas/admin-spa/) ----
wwwroot/admin/

# ---- IDE / OS ----
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Test / coverage ----
TestResults/
coverage/
*.coverage
*.trx

# Keep empty runtime folders in Git with .gitkeep but ignore their contents.
!storage/media/.gitkeep
!storage/backups/.gitkeep
!storage/logs/.gitkeep
!storage/updates/.gitkeep
