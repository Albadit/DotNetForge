# ---- Secrets ----
# Secrets live in .env and must NEVER be committed. Only .env.example and .env.developer (public development
# credentials for the containers in docker/) are tracked.
.env
.env.*
!.env.example
!.env.developer

# ---- .NET build output ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/

# ---- Development runtime data ----
# storage/ only exists in Development (local media). Production writes
# nothing here: the deployment directory is read-only (.docs/guides/deployment.md).
/storage/

# SQLite database files.
*.db
*.db-shm
*.db-wal

# ---- Node / frontend tooling ----
node_modules/
npm-debug.log*
yarn-error.log*

# ---- IDE / OS ----
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Test / coverage ----
TestResults/
coverage/
*.coverage
*.trx

# Logs and local tool caches.
*.log
.cache/

# ---- Tailwind CSS CLI (downloaded by src/DotNetForge.UI/build/Tailwind.targets) and its output ----
/tools/
src/DotNetForge.UI/wwwroot/dnf.css

# ---- UI test screenshots: baselines are recorded per machine on the first run (.docs/guides/testing.md#ui-tests) ----
tests/DotNetForge.UiTests/Baselines/
