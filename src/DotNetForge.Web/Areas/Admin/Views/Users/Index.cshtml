@model List<UsersController.UserListItem>
@{
    ViewData["Title"] = "Users";
    ViewData["Description"] = "People with access to the admin and the roles that decide what they can do.";
    var roles = Model.SelectMany(u => u.Roles).Distinct().Order().ToList();
    var canCreate = ViewData["CanCreate"] as bool? == true;
    var canUpdate = ViewData["CanUpdate"] as bool? == true;
    var canDelete = ViewData["CanDelete"] as bool? == true;

    static string Initials(string name, string email) =>
        string.Concat((string.IsNullOrWhiteSpace(name) ? email : name)
            .Split(new[] { ' ', '@', '.', '-', '_' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}

@section Actions {
    @if (canCreate)
    {
        <a class="dnf-button dnf-button--primary" href="/admin/users/create"><dnf-icon name="plus" /> Create user</a>
    }
}

<section class="dnf-card" aria-labelledby="users-title" data-collection data-page-size="25">
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="users-title">All users</h2>
            <p class="dnf-card__description" data-collection-count>@Model.Count total</p>
        </div>
    </div>
    <div class="dnf-toolbar" data-js-only hidden>
        <div class="dnf-toolbar__search dnf-input-group">
            <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
            <label class="sr-only" for="user-search">Search users</label>
            <input id="user-search" type="search" class="dnf-input dnf-input--sm" placeholder="Search by name or email" data-collection-search />
        </div>
        <label class="sr-only" for="user-role">Role</label>
        <select id="user-role" class="dnf-select dnf-select--sm" data-collection-filter="roles">
            <option value="">All roles</option>
            @foreach (var role in roles)
            {
                <option value="@role.Replace(' ', '-')">@role</option>
            }
        </select>
        <label class="sr-only" for="user-status">Status</label>
        <select id="user-status" class="dnf-select dnf-select--sm" data-collection-filter="status">
            <option value="">Any status</option>
            <option value="enabled">Enabled</option>
            <option value="disabled">Disabled</option>
        </select>
    </div>
    <div class="dnf-table dnf-table--stack">
        <table class="dnf-table__table">
            <thead>
                <tr>
                    <th scope="col" data-sort="text">User</th>
                    <th scope="col">Roles</th>
                    <th scope="col" data-sort="text">Status</th>
                    <th scope="col" data-sort="date">Last sign-in</th>
                    <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var enabled = user.Status == "Enabled";
                    <tr data-item data-status="@user.Status.ToLowerInvariant()" data-roles="@string.Join(' ', user.Roles.Select(r => r.Replace(' ', '-')))"
                        data-search="@user.Name @user.Email">
                        <td class="dnf-table__cell--lead" data-sort-value="@(string.IsNullOrWhiteSpace(user.Name) ? user.Email : user.Name)">
                            <div class="dnf-cluster">
                                <span class="dnf-avatar" aria-hidden="true">@Initials(user.Name, user.Email)</span>
                                <span>
                                    <a class="dnf-table__primary" href="/admin/users/@user.Id">@(string.IsNullOrWhiteSpace(user.Name) ? user.Email : user.Name)</a>
                                    @if (user.IsSelf)
                                    {
                                        <dnf-badge tone="Neutral">You</dnf-badge>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(user.Name))
                                    {
                                        <span class="dnf-table__secondary">@user.Email</span>
                                    }
                                </span>
                            </div>
                        </td>
                        <td data-label="Roles">
                            <div class="dnf-cluster">
                                @foreach (var role in user.Roles)
                                {
                                    <dnf-badge tone="@(role.Contains("Admin") ? DnfTone.Primary : DnfTone.Neutral)">@role</dnf-badge>
                                }
                                @if (user.Roles.Count == 0)
                                {
                                    <span class="text-subtle">No role</span>
                                }
                            </div>
                        </td>
                        <td data-label="Status"><dnf-badge tone="@(enabled ? DnfTone.Success : DnfTone.Danger)" dot="true">@user.Status</dnf-badge></td>
                        <td data-label="Last sign-in" data-sort-value="@(user.LastLogin?.ToString("O") ?? "")"><dnf-timestamp value="@user.LastLogin" empty="Never" /></td>
                        <td class="dnf-table__cell--actions">
                            <dnf-dropdown label="Actions for @user.Email">
                                <dnf-dropdown-link href="/admin/users/@user.Id" icon="@(canUpdate ? "pencil" : "eye")">@(canUpdate ? "Edit" : "View")</dnf-dropdown-link>
                                @if (canUpdate && !user.IsSelf)
                                {
                                    <dnf-dropdown-post action="/admin/users/@user.Id/@(enabled ? "disable" : "enable")" icon="power" field-returnTo="list">@(enabled ? "Disable" : "Enable")</dnf-dropdown-post>
                                }
                                @if (canDelete && !user.IsSelf)
                                {
                                    <dnf-dropdown-separator />
                                    <dnf-dropdown-post action="/admin/users/@user.Id/delete" icon="trash" danger="true" field-returnTo="list"
                                               confirm="Delete @user.Email? They can't sign in any more. This can't be undone." confirm-title="Delete user" confirm-action="Delete user">Delete</dnf-dropdown-post>
                                }
                            </dnf-dropdown>
                        </td>
                    </tr>
                }
                <tr class="dnf-table__empty" data-collection-empty hidden><td colspan="5">No user matches the search or filters.</td></tr>
                @if (Model.Count == 0)
                {
                    <tr class="dnf-table__empty"><td colspan="5">No users yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="dnf-pagination" data-collection-pagination hidden></div>
</section>
