        <div class="dnf-stack dnf-stack--sm">
            <div class="rounded-md border border-border bg-surface-muted p-3 text-sm">Small</div>
            <div class="rounded-md border border-border bg-surface-muted p-3 text-sm">gap</div>
        </div>
        <div class="dnf-stack">
            <div class="rounded-md border border-border bg-surface-muted p-3 text-sm">Default</div>
            <div class="rounded-md border border-border bg-surface-muted p-3 text-sm">gap</div>
        </div>
        <div class="dnf-stack dnf-stack--lg">
            <div class="rounded-md border border-border bg-surface-muted p-3 text-sm">Large</div>
            <div class="rounded-md border border-border bg-surface-muted p-3 text-sm">gap</div>
        </div>
    </div>
</ui-doc-example>

<ui-doc-example id="cluster" title="Cluster" description="A wrapping row of inline things, vertically centred: dnf-cluster (space-2) and --lg (space-4)." layout="stack">
