<ui-doc-example id="collection" title="Collection" description="With data-collection on the card, dnf.js adds search, a select and a segmented filter, sortable headers, row selection with the bulk bar, the count and the pager - over the rows already in the page." layout="block">
    <div class="dnf-card" data-collection data-page-size="10">
        <div class="dnf-card__header">
            <h3 class="dnf-card__title">Pages</h3>
            <span class="text-sm text-muted" data-collection-count></span>
        </div>
        <div class="dnf-collection-bar">
            <div class="dnf-toolbar">
                <div class="dnf-input-group dnf-toolbar__search">
                    <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                    <input class="dnf-input" type="search" aria-label="Search" data-collection-search />
                </div>
                <select class="dnf-select" aria-label="Status" data-collection-filter="status">
                    <option value="">All statuses</option>
                    <option value="published">Published</option>
                    <option value="draft">Draft</option>
                </select>
                <span class="dnf-toolbar__spacer"></span>
                <div class="dnf-segmented" role="group" aria-label="Quick filter">
                    <button type="button" class="dnf-segmented__item" data-collection-filter="status" data-value="" aria-pressed="true">All</button>
                    <button type="button" class="dnf-segmented__item" data-collection-filter="status" data-value="published" aria-pressed="false">Published</button>
                </div>
            </div>
            <div class="dnf-bulk-bar" data-bulk-bar hidden>
                <span class="dnf-bulk-bar__count" data-bulk-count></span>
                <button type="button" class="dnf-button dnf-button--danger-soft dnf-button--sm"
                        data-docs-confirm="Delete the selected pages? This can't be undone." data-docs-confirm-title="Delete pages" data-docs-confirm-action="Delete">Delete</button>
                <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm" data-bulk-clear>Clear</button>
            </div>
        </div>
        <div class="dnf-table dnf-table--stack">
            <table class="dnf-table__table">
                <thead>
                    <tr>
                        <th class="dnf-table__cell--check"><input type="checkbox" class="dnf-checkbox" data-select-all aria-label="Select all" /></th>
                        <th scope="col" data-sort="text">Title</th>
                        <th scope="col" data-sort="text">Status</th>
                        <th scope="col" data-sort="number">Views</th>
                        <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (title, status, views) in new[]
                    {
                        ("Home", "published", 1204), ("About us", "published", 312), ("Pricing", "draft", 0),
                        ("Blog", "published", 845), ("Careers", "draft", 12), ("Contact", "published", 220),
                        ("Imprint", "published", 31), ("Privacy", "published", 58), ("Terms", "published", 44),
                        ("Docs", "draft", 3), ("Changelog", "published", 77), ("Status", "published", 19),
                    })
                    {
                        var slug = title == "Home" ? "/" : "/" + title.ToLowerInvariant().Replace(' ', '-');
                        <tr data-item data-status="@status">
                            <td class="dnf-table__cell--check"><input type="checkbox" class="dnf-checkbox" data-select-item aria-label="Select @title" /></td>
                            <td class="dnf-table__cell--lead">
                                <span class="dnf-table__primary">@title</span>
                                <span class="dnf-table__secondary">@slug</span>
                            </td>
                            <td data-label="Status"><dnf-badge tone="@(status == "published" ? DnfTone.Success : DnfTone.Neutral)" dot="true">@(status == "published" ? "Published" : "Draft")</dnf-badge></td>
                            <td data-label="Views" data-sort-value="@views">@views</td>
                            <td class="dnf-table__cell--actions">
                                <dnf-dropdown label="Actions for @title">
                                    <dnf-dropdown-link href="#collection" icon="pencil">Edit</dnf-dropdown-link>
                                    <dnf-dropdown-note>A demo: nothing is saved.</dnf-dropdown-note>
                                </dnf-dropdown>
                            </td>
                        </tr>
                    }
                    <tr class="dnf-table__empty" data-collection-empty hidden><td colspan="5">No pages match.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="dnf-pagination" data-collection-pagination hidden></div>
    </div>
</ui-doc-example>

