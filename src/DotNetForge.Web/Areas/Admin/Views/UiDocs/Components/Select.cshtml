<ui-doc-example id="invalid-disabled" title="Invalid and disabled" description="The same states as an input: aria-invalid (or the field's data-invalid) for the danger border, disabled for the muted look." layout="block">
    <div class="dnf-form-grid">
        <div class="dnf-field">
            <label class="dnf-field__label" for="select-invalid">Parent page</label>
            <select class="dnf-select" id="select-invalid" aria-invalid="true" aria-describedby="select-invalid-error">
                <option value="">Choose a page</option>
                <option>Home</option>
                <option>About us</option>
