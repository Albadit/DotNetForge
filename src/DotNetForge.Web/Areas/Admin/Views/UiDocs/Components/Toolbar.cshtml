@* Toolbar (UI docs): the toolbar, the bulk bar and the collection bar. Sections: Usage, Examples, Customization,
   Styling reference, API, Accessibility, Guidelines. *@

<ul class="dnf-docs-source">
    <li>CSS <code>src/DotNetForge.UI/Styles/components/table.css</code></li>
    <li>Behaviour <code>src/DotNetForge.UI/wwwroot/dnf.js</code> (collections: search, filters, selection)</li>
</ul>

<h2 id="usage">Usage</h2>
<p>A <code>dnf-toolbar</code> is the row above a collection: a search field, filters, then - after a spacer - the actions.
    It sits directly in the card, between the card header and the <a href="@UiDocsCatalog.Root/components/table">table</a> or
    <a href="@UiDocsCatalog.Root/components/list">list</a>, and draws a line below itself.</p>

<ui-doc-example id="basic" layout="block">
    <div class="dnf-card">
        <div class="dnf-toolbar">
            <div class="dnf-input-group dnf-toolbar__search">
                <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                <input class="dnf-input" type="search" aria-label="Search pages" placeholder="Search pages" />
            </div>
            <select class="dnf-select" aria-label="Status">
                <option value="">All statuses</option>
                <option value="published">Published</option>
                <option value="draft">Draft</option>
            </select>
            <span class="dnf-toolbar__spacer"></span>
            <dnf-button variant="Primary" size="Sm" icon="plus">New page</dnf-button>
        </div>
        <p class="dnf-card__body text-muted">The rows go here.</p>
    </div>
</ui-doc-example>

<h2 id="examples">Examples</h2>

<ui-doc-example id="filters" title="Several filters" description="Selects keep their natural width (at least 9rem) and are as tall as the search field; a segmented control works as a set of exclusive filter buttons." layout="block">
    <div class="dnf-card">
        <div class="dnf-toolbar">
            <div class="dnf-input-group dnf-toolbar__search">
                <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                <input class="dnf-input" type="search" aria-label="Search users" placeholder="Search by name or email" />
            </div>
            <select class="dnf-select" aria-label="Role">
                <option value="">All roles</option>
                <option>Administrator</option>
                <option>Editor</option>
            </select>
            <div class="dnf-segmented" role="group" aria-label="Status">
                <button type="button" class="dnf-segmented__item" aria-pressed="true">All</button>
                <button type="button" class="dnf-segmented__item" aria-pressed="false">Enabled</button>
                <button type="button" class="dnf-segmented__item" aria-pressed="false">Disabled</button>
            </div>
        </div>
        <p class="dnf-card__body text-muted">The rows go here.</p>
    </div>
</ui-doc-example>

<ui-doc-example id="actions-only" title="Actions only" description="Without a search field the spacer pushes the actions to the end of the row." layout="block">
    <div class="dnf-card">
        <div class="dnf-toolbar">
            <span class="text-sm text-muted">24 files</span>
            <span class="dnf-toolbar__spacer"></span>
            <dnf-button size="Sm" icon="download">Export</dnf-button>
            <dnf-button variant="Primary" size="Sm" icon="upload">Upload</dnf-button>
        </div>
        <p class="dnf-card__body text-muted">The files go here.</p>
    </div>
</ui-doc-example>

<ui-doc-example id="bulk-bar" title="Bulk bar" description="While items are selected the bulk bar covers the toolbar - the collection bar positions it on top, so nothing below moves. At 64rem and below it wraps and replaces the toolbar instead. Here it is shown as if three items were selected." layout="block">
    <div class="dnf-card">
        <div class="dnf-collection-bar">
            <div class="dnf-toolbar">
                <div class="dnf-input-group dnf-toolbar__search">
                    <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                    <input class="dnf-input" type="search" aria-label="Search media" />
                </div>
            </div>
            <div class="dnf-bulk-bar">
                <span class="dnf-bulk-bar__count">3 selected</span>
                <select class="dnf-select dnf-select--sm" aria-label="Bulk action">
                    <option>Move to folder</option>
                    <option>Delete</option>
                </select>
                <dnf-button size="Sm">Apply</dnf-button>
                <dnf-button variant="Ghost" size="Sm">Clear</dnf-button>
            </div>
        </div>
        <p class="dnf-card__body text-muted">The selected files go here.</p>
    </div>
</ui-doc-example>

<ui-doc-example id="wired" title="Wired to a collection" description="With data-collection on the card, dnf.js filters the items as you type or choose, shows the count, and swaps in the bulk bar when an item is checked." layout="block">
    <div class="dnf-card" data-collection>
        <div class="dnf-collection-bar">
            <div class="dnf-toolbar">
                <input type="checkbox" class="dnf-checkbox" data-select-all aria-label="Select all files" />
                <div class="dnf-input-group dnf-toolbar__search">
                    <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                    <input class="dnf-input" type="search" aria-label="Search files" data-collection-search />
                </div>
                <select class="dnf-select" aria-label="Type" data-collection-filter="type">
                    <option value="">All types</option>
                    <option value="image">Images</option>
                    <option value="document">Documents</option>
                </select>
                <span class="dnf-toolbar__spacer"></span>
                <span class="text-sm text-muted" data-collection-count></span>
            </div>
            <div class="dnf-bulk-bar" data-bulk-bar hidden>
                <span class="dnf-bulk-bar__count" data-bulk-count aria-live="polite"></span>
                <button type="button" class="dnf-button dnf-button--danger-soft dnf-button--sm"
                        data-docs-confirm="Delete the selected files? This can't be undone." data-docs-confirm-title="Delete files" data-docs-confirm-action="Delete">Delete</button>
                <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm" data-bulk-clear>Clear</button>
            </div>
        </div>
        <ul class="dnf-list">
            <li class="dnf-list__item" data-item data-type="image">
                <input type="checkbox" class="dnf-checkbox" data-select-item aria-label="Select hero.jpg" />
                <span class="dnf-list__icon"><dnf-icon name="image" /></span>
                <div class="dnf-list__content"><span class="font-semibold">hero.jpg</span><span class="text-sm text-muted">1.2 MB</span></div>
            </li>
            <li class="dnf-list__item" data-item data-type="image">
                <input type="checkbox" class="dnf-checkbox" data-select-item aria-label="Select team.png" />
                <span class="dnf-list__icon"><dnf-icon name="image" /></span>
                <div class="dnf-list__content"><span class="font-semibold">team.png</span><span class="text-sm text-muted">640 KB</span></div>
            </li>
            <li class="dnf-list__item" data-item data-type="document">
                <input type="checkbox" class="dnf-checkbox" data-select-item aria-label="Select brochure.pdf" />
                <span class="dnf-list__icon"><dnf-icon name="file" /></span>
                <div class="dnf-list__content"><span class="font-semibold">brochure.pdf</span><span class="text-sm text-muted">840 KB</span></div>
            </li>
            <li class="dnf-list__item text-muted" data-collection-empty hidden>No files match.</li>
        </ul>
    </div>
</ui-doc-example>

<h2 id="customization">Customization</h2>
