    <div class="dnf-card">
        <div class="dnf-toolbar border-b-0">
            <div class="dnf-input-group dnf-toolbar__search max-w-none">
                <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                <input class="dnf-input" type="search" aria-label="Search the documentation" placeholder="Search the documentation" />
            </div>
        </div>
    </div>
</ui-doc-example>

