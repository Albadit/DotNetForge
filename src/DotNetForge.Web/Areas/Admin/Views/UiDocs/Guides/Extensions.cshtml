                <div class="dnf-cluster">
                    <dnf-button variant="Primary" icon="download">Export</dnf-button>
                    <dnf-button>Schedule</dnf-button>
                </div>
                <a class="text-sm" href="#isolation">How reports are built</a>
            </div>
        </div>
        <div class="dnf-scope rounded-lg border border-border bg-surface p-5" data-dnf-extension="yourcompany.admin.reports">
