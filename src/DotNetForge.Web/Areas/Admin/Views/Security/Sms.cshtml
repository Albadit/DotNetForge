@using DotNetForge.Shared.Enums
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = "Add a phone for SMS codes";
    ViewData["Description"] = "We text a code to check the number.";
}

<form method="post" action="/admin/profile/security/code/send" class="dnf-form dnf-form--narrow">
    @Html.AntiForgeryToken()
    <input type="hidden" name="type" value="@MfaMethodType.Sms" />
    <section class="dnf-card" aria-labelledby="phone-title">
        <div class="dnf-card__header"><h2 class="dnf-card__title" id="phone-title">Phone number</h2></div>
        <div class="dnf-card__body dnf-stack">
            <dnf-validation-summary />
            <div class="dnf-field">
                <label class="dnf-field__label" for="phone">Mobile number<span class="dnf-field__required" aria-hidden="true">*</span></label>
                <input id="phone" class="dnf-input" name="phone" type="tel" required autocomplete="tel" value="@ViewData["Phone"]" placeholder="+41 79 123 45 67" aria-describedby="phone-hint" />
                <span class="dnf-field__description" id="phone-hint">With the country code (+41, +1, +49 ...). Text messages may cost the site owner a small fee.</span>
            </div>
        </div>
        <div class="dnf-card__footer">
            <a class="dnf-button dnf-button--secondary" href="/admin/profile/security">Cancel</a>
            <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="send" /> Send code</button>
        </div>
    </section>
</form>
