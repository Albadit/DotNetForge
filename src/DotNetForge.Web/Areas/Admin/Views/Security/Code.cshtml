@using DotNetForge.Shared.Enums
@using DotNetForge.Web.Services.Mfa
@model SecurityController.CodeSetupViewModel
@{
    var sms = Model.Type == MfaMethodType.Sms;
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = sms ? "Check your phone" : "Check your email";
    ViewData["Description"] = sms
        ? $"We texted a 6-digit code to {MfaService.MaskPhone(Model.Target)}."
        : $"We emailed a 6-digit code to {Model.Target}.";
}

<form method="post" action="/admin/profile/security/code" class="dnf-form dnf-form--narrow">
    @Html.AntiForgeryToken()
    <input type="hidden" name="type" value="@Model.Type" />
    <input type="hidden" name="target" value="@Model.Target" />
    <input type="hidden" name="token" value="@Model.Token" />
    <section class="dnf-card" aria-labelledby="code-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="code-title">Enter the code</h2>
                <p class="dnf-card__description">It works for @MfaService.CodeLifetime.TotalMinutes.ToString("0") minutes.</p>
            </div>
        </div>
        <div class="dnf-card__body dnf-stack">
            <dnf-validation-summary />
            <div class="dnf-field">
                <label class="dnf-field__label" for="code">6-digit code</label>
                <input id="code" name="code" required inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" autofocus class="dnf-input dnf-input--code" />
            </div>
        </div>
        <div class="dnf-card__footer">
            <a class="dnf-button dnf-button--secondary" href="/admin/profile/security">Cancel</a>
            <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="check" /> Turn on</button>
        </div>
    </section>
</form>
