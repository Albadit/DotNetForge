@model DotNetForge.Web.Services.Mfa.AuthenticatorSetup
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = "Set up an authenticator app";
    ViewData["Description"] = "Scan the code with the app, then enter the 6-digit code it shows.";
}

<form method="post" action="/admin/profile/security/authenticator" class="stack-lg form-narrow">
    @Html.AntiForgeryToken()
    <input type="hidden" name="token" value="@Model.Token" />
    <section class="card" aria-labelledby="scan-title">
        <div class="card-header"><h2 class="card-title" id="scan-title">1. Scan this QR code</h2></div>
        <div class="card-body stack">
            <img class="mfa-qr" src="@Model.QrCodeDataUri" alt="QR code for your authenticator app" width="246" height="246" />
            <p class="text-sm text-muted">Can't scan it? Enter this key in the app instead (time-based):</p>
            <pre class="code-block">@Model.Secret<button type="button" class="btn btn-secondary btn-sm" data-copy-target="#totp-secret" data-js-only hidden><icon name="copy" size="sm" /> Copy</button></pre>
            <span id="totp-secret" hidden>@Model.Secret</span>
        </div>
    </section>
    <section class="card" aria-labelledby="verify-title">
        <div class="card-header"><h2 class="card-title" id="verify-title">2. Enter the code from the app</h2></div>
        <div class="card-body stack">
            <form-errors />
            <div class="field">
                <label class="field-label" for="code">6-digit code</label>
                <input id="code" name="code" required inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" class="input-code" />
            </div>
        </div>
        <div class="card-footer">
            <a class="btn" href="/admin/profile/security">Cancel</a>
            <button type="submit" class="btn btn-primary"><icon name="check" /> Turn on</button>
        </div>
    </section>
</form>
