@model List<AuditLogEntry>
@{
    ViewData["Title"] = "Audit Logs";
    ViewData["Description"] = "The 100 most recent actions. Entries are append-only: they can't be edited or deleted.";
    var areas = Model.Select(e => e.Action.Split('.')[0]).Distinct().Order().ToList();
}

<section class="card" aria-labelledby="audit-title" data-collection data-page-size="25">
    <div class="card-header">
        <div>
            <h2 class="card-title" id="audit-title">Activity</h2>
            <p class="card-description" data-collection-count>@Model.Count total</p>
        </div>
    </div>
    <div class="toolbar" data-js-only hidden>
        <div class="toolbar-search input-icon">
            <icon name="search" size="sm" />
            <label class="sr-only" for="audit-search">Search activity</label>
            <input id="audit-search" type="search" class="input-sm" placeholder="Search user, action, entity or IP" data-collection-search />
        </div>
        <label class="sr-only" for="audit-area">Area</label>
        <select id="audit-area" class="input-sm" data-collection-filter="area">
            <option value="">All areas</option>
            @foreach (var area in areas)
            {
                <option value="@area">@area</option>
            }
        </select>
        <label class="sr-only" for="audit-result">Result</label>
        <select id="audit-result" class="input-sm" data-collection-filter="result">
            <option value="">Any result</option>
            <option value="ok">Succeeded</option>
            <option value="fail">Failed</option>
        </select>
    </div>
    <div class="table-wrap">
        <table class="table table-stack">
            <thead>
                <tr>
                    <th scope="col" data-sort="date">When</th>
                    <th scope="col" data-sort="text">Action</th>
                    <th scope="col" data-sort="text">User</th>
                    <th scope="col">Entity</th>
                    <th scope="col">Result</th>
                    <th scope="col">IP address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr data-item data-area="@entry.Action.Split('.')[0]" data-result="@(entry.Success ? "ok" : "fail")">
                        <td data-label="When" data-sort-value="@entry.Timestamp.ToString("O")" class="text-nowrap"><timestamp value="@entry.Timestamp" /></td>
                        <td data-label="Action">
                            <span class="cell-primary">@AuditPresentation.Label(entry.Action)</span>
                            <code class="cell-sub">@entry.Action</code>
                        </td>
                        <td data-label="User">@(entry.UserDisplaySnapshot ?? "System")</td>
                        <td data-label="Entity">
                            @if (entry.EntityType is null)
                            {
                                <span class="text-subtle">-</span>
                            }
                            else
                            {
                                <span class="text-muted">@entry.EntityType</span> @entry.EntityDisplaySnapshot
                            }
                        </td>
                        <td data-label="Result">
                            @if (entry.Success)
                            {
                                <badge tone="Success" dot="true">Succeeded</badge>
                            }
                            else
                            {
                                <badge tone="Danger" dot="true">Failed</badge>
                            }
                        </td>
                        <td data-label="IP address" class="text-muted text-mono text-sm">@entry.IpAddress</td>
                    </tr>
                }
                <tr class="table-empty" data-collection-empty hidden><td colspan="6">No entry matches the search or filters.</td></tr>
                @if (Model.Count == 0)
                {
                    <tr class="table-empty"><td colspan="6">No audit entries yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination" data-collection-pagination hidden></div>
</section>
