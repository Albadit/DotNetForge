@using Microsoft.AspNetCore.Html
@model List<(string Name, IHtmlContent Html)>
@* Widget extensions (extensions/widgets/*), enabled on the Plugins screen (.docs/pages/dashboard.md#widgets). *@
@if (Model.Count > 0)
{
    <section aria-labelledby="widgets-title" class="dnf-stack">
        <h2 id="widgets-title" class="sr-only">Widgets</h2>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(18rem,1fr))] gap-5">
            @foreach (var widget in Model)
            {
                <section class="dnf-card">
                    <div class="dnf-card__header"><h3 class="dnf-card__title">@widget.Name</h3></div>
                    <div class="dnf-card__body">@widget.Html</div>
                </section>
            }
        </div>
    </section>
}
