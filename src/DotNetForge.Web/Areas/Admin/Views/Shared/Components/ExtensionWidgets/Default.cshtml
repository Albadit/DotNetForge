@using Microsoft.AspNetCore.Html
@model List<(string Name, IHtmlContent Html)>
@* Widget extensions (extensions/widgets/*), enabled on the Plugins screen (.docs/pages/dashboard.md#widgets). *@
@if (Model.Count > 0)
{
    <section aria-labelledby="widgets-title" class="stack">
        <h2 id="widgets-title" class="sr-only">Widgets</h2>
        <div class="widget-grid">
            @foreach (var widget in Model)
            {
                <section class="card widget">
                    <div class="card-header"><h3 class="card-title">@widget.Name</h3></div>
                    <div class="card-body">@widget.Html</div>
                </section>
            }
        </div>
    </section>
}
