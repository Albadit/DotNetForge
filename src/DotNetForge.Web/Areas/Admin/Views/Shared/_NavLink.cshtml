@using DotNetForge.Web.Areas.Admin.Navigation
@model NavLinkView
<a class="dnf-nav__link" href="@Model.Href" aria-current="@(Model.Active ? "page" : null)">
    <dnf-icon name="@Model.Icon" />
    <span class="dnf-nav__link-label">@Model.Label</span>
    @if (Model.Planned)
    {
        <span class="dnf-nav__badge" title="Planned - not built yet">Soon</span>
    }
</a>
