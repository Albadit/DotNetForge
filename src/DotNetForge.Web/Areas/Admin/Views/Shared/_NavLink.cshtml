@using DotNetForge.Web.Areas.Admin.Navigation
@model NavLinkView
<a class="nav-link" href="@Model.Href" aria-current="@(Model.Active ? "page" : null)">
    <icon name="@Model.Icon" />
    <span class="nav-link-label">@Model.Label</span>
    @if (Model.Planned)
    {
        <span class="nav-badge" title="Planned - not built yet">Soon</span>
    }
</a>
