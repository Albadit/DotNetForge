@using DotNetForge.Web.Areas.Admin.Navigation
@model AdminNavModel
@*
    Admin sidebar (.docs/architecture/pages.md#navigation), built by AdminNavigationService from AdminNavigation.Tree:
    only links the user may open, the active one marked with aria-current. Settings sub-groups are <details>: the one
    holding the active screen is open; nav-state.js remembers what the user opened or closed.
*@
<nav class="dnf-nav" aria-label="Main navigation">
    @foreach (var navSection in Model.Sections)
    {
        <div class="dnf-nav__section">
            <p class="dnf-nav__section-title">@navSection.Label</p>
            @if (navSection.Links.Count > 0)
            {
                <ul class="dnf-nav__list">
                    @foreach (var link in navSection.Links)
                    {
                        <li><partial name="_NavLink" model="link" /></li>
                    }
                </ul>
            }
            @foreach (var group in navSection.Groups)
            {
                <details class="dnf-nav__group" data-nav-group="@group.Label" open="@(group.ContainsActive ? "open" : null)"
                         data-nav-active="@(group.ContainsActive ? "true" : "false")">
                    <summary class="dnf-nav__group-title">
                        <span>@group.Label</span>
                        <dnf-icon name="chevron-right" size="Sm" class="dnf-nav__group-chevron" />
                    </summary>
                    <ul class="dnf-nav__list">
                        @foreach (var link in group.Links)
                        {
                            <li><partial name="_NavLink" model="link" /></li>
                        }
                    </ul>
                </details>
            }
        </div>
    }
</nav>
