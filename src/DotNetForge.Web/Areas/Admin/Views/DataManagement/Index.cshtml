@model DataManagementController.DataManagementViewModel
@using DotNetForge.Shared.Enums
@using DotNetForge.Web.Services
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = "Data Management";
    ViewData["Description"] = "Export the CMS data and the media files, keep backups, and - in Development - import an export into this site.";
    static string Size(long bytes) => bytes switch
    {
        < 1024 => bytes + " B",
        < 1024 * 1024 => (bytes / 1024d).ToString("0.#") + " KB",
        _ => (bytes / 1024d / 1024d).ToString("0.#") + " MB",
    };
    string By(Guid? id) => id is { } user ? Model.Users.GetValueOrDefault(user) ?? "Deleted user" : "Automatic";
    static string Kind(TransferRecord r) => r.Automatic ? "Automatic" : r.Note is not null ? "Safety copy" : "Manual";
}

<div class="dnf-stack">
    <dnf-validation-summary />

    <section class="dnf-card" aria-labelledby="export-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="export-title">Export</h2>
                <p class="dnf-card__description">Download the database, the media files, or both as one .zip file - to keep, or to bring this site's data into another site.</p>
            </div>
        </div>
        @* One form, one button per export: each button posts to its own action. *@
        <form method="post" action="/admin/data/export">
            @Html.AntiForgeryToken()
            <div class="dnf-card__body dnf-stack">
                @if (Model.ExportDatabases.Count > 1)
                {
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="database">Database</label>
                        <select id="database" name="database" class="dnf-select" aria-describedby="database-hint">
                            @foreach (var (name, label) in Model.ExportDatabases)
                            {
                                <option value="@name">@label</option>
                            }
                        </select>
                        <span class="dnf-field__description" id="database-hint">For Database and Database and media. The CMS database is the default. An additional database (<code>DATABASES_&lt;NAME&gt;_*</code>) is exported table by table as JSON - for your own use; only CMS exports can be imported.</span>
                    </div>
                }
                <dl class="dnf-description-list dnf-description-list--compact">
                    <dt>Database</dt>
                    <dd>@Model.Provider: pages, content types and entries, media details, users and roles, settings, email templates, API tokens and endpoints, webhooks, extensions and the audit log - not the uploaded files, and not this site's encryption keys (on another site custom API endpoint tokens must be regenerated).</dd>
                    <dt>Media</dt>
                    <dd>@Model.Media.Files.ToString("N0") files (@Size(Model.Media.Bytes)) in their library folders, e.g. <code>Photos/2026/beach.jpg</code>, private files too, plus <code>media.json</code> with every file's id, link, folder, visibility and sizes. A download only; it is not imported.</dd>
                    <dt>Database and media</dt>
                    <dd>Both in one file: the database export unchanged at the top (import it as it is), the files under <code>media/</code>.</dd>
                </dl>
                <p class="dnf-note text-sm text-muted"><dnf-icon name="shield" size="Sm" /><span>The database export contains password hashes and personal data: store it like a database backup. Media is streamed straight from the storage, so a large library takes a while.</span></p>
            </div>
            <div class="dnf-card__footer">
                <button type="submit" class="dnf-button dnf-button--secondary" formaction="/admin/data/export-media" disabled="@(Model.Media.Files == 0 ? "disabled" : null)"><dnf-icon name="download" /> Media</button>
                <button type="submit" class="dnf-button dnf-button--secondary"><dnf-icon name="download" /> Database</button>
                <button type="submit" class="dnf-button dnf-button--primary" formaction="/admin/data/export-all"><dnf-icon name="download" /> Database and media</button>
            </div>
        </form>
    </section>

    <form method="post" action="/admin/data/backups/schedule">
        @Html.AntiForgeryToken()
        <section class="dnf-card" aria-labelledby="schedule-title">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="schedule-title">Automatic backups</h2>
                    <p class="dnf-card__description">Stored in the media storage under <code>backups/</code> - not public, listed below.</p>
                </div>
                <dnf-badge tone="@(Model.Schedule.Enabled ? DnfTone.Success : DnfTone.Neutral)" dot="true">@(Model.Schedule.Enabled ? "On" : "Off")</dnf-badge>
            </div>
            <div class="dnf-card__body dnf-stack">
                <label class="dnf-switch-row">
                    <span class="dnf-check__text">
                        <span>Back up automatically</span>
                        <span class="dnf-check__description">Recommended. Runs in the background when the interval since the last backup has passed.</span>
                    </span>
                    @* The checkbox first: a bound bool takes the first posted value. *@
                    <input type="checkbox" class="dnf-switch" role="switch" name="enabled" value="true" checked="@(Model.Schedule.Enabled ? "checked" : null)" />
                    <input type="hidden" name="enabled" value="false" />
                </label>
                <div class="dnf-form-grid">
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="intervalHours">Every</label>
                        <select id="intervalHours" name="intervalHours" class="dnf-select">
                            @foreach (var hours in DatabaseTransferService.Intervals)
                            {
                                <option value="@hours" selected="@(hours == Model.Schedule.IntervalHours ? "selected" : null)">@DataManagementController.Describe(hours)</option>
                            }
                        </select>
                    </div>
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="keep">Keep</label>
                        <input id="keep" name="keep" type="number" class="dnf-input" min="1" max="100" required value="@Model.Schedule.Keep" aria-describedby="keep-hint" />
                        <span class="dnf-field__description" id="keep-hint">The newest automatic backups; older ones are deleted. Manual backups stay until you delete them.</span>
                    </div>
                </div>
            </div>
            <div class="dnf-card__footer">
                <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="check" /> Save schedule</button>
            </div>
        </section>
    </form>

    <section class="dnf-card" aria-labelledby="backups-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="backups-title">Backups</h2>
                <p class="dnf-card__description">@Model.Backups.Count stored</p>
            </div>
            <form method="post" action="/admin/data/backups">
                @Html.AntiForgeryToken()
                <button type="submit" class="dnf-button dnf-button--secondary dnf-button--sm"><dnf-icon name="archive" /> Back up now</button>
            </form>
        </div>
        @if (Model.Backups.Count == 0)
        {
            <dnf-empty-state icon="archive" title="No backups yet" description="Back up now, or turn on automatic backups." />
        }
        else
        {
            <div class="dnf-table dnf-table--stack">
                <table class="dnf-table__table">
                    <thead>
                        <tr>
                            <th scope="col">Backup</th>
                            <th scope="col">Kind</th>
                            <th scope="col">Records</th>
                            <th scope="col">Size</th>
                            <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var backup in Model.Backups)
                        {
                            <tr>
                                <td class="dnf-table__cell--lead">
                                    <span class="dnf-table__primary"><dnf-timestamp value="@backup.StartedAt" /></span>
                                    <span class="dnf-table__secondary">@backup.FileName</span>
                                </td>
                                <td data-label="Kind">
                                    <dnf-badge tone="@(backup.Automatic ? DnfTone.Neutral : DnfTone.Info)">@Kind(backup)</dnf-badge>
                                    @if (backup.Note is not null)
                                    {
                                        <span class="dnf-table__secondary">@backup.Note</span>
                                    }
                                </td>
                                <td data-label="Records">@backup.RecordCount.ToString("N0")</td>
                                <td data-label="Size">@Size(backup.SizeBytes)</td>
                                <td class="dnf-table__cell--actions">
                                    <dnf-dropdown label="Actions for the backup of @backup.StartedAt.ToString("u")">
                                        <dnf-dropdown-post action="/admin/data/backups/@backup.Id/download" icon="download">Download</dnf-dropdown-post>
                                        @if (Model.ImportAllowed)
                                        {
                                            <dnf-dropdown-post action="/admin/data/backups/@backup.Id/restore" icon="rotate-ccw"
                                                       confirm="Replace ALL current data with this backup? The current data is backed up first, and you are signed out afterwards."
                                                       confirm-title="Restore backup" confirm-action="Restore">Restore</dnf-dropdown-post>
                                        }
                                        <dnf-dropdown-separator />
                                        <dnf-dropdown-post action="/admin/data/backups/@backup.Id/delete" icon="trash" danger="true"
                                                   confirm="Delete this backup? The file is removed from the storage; this can't be undone."
                                                   confirm-title="Delete backup" confirm-action="Delete">Delete</dnf-dropdown-post>
                                    </dnf-dropdown>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="dnf-card" aria-labelledby="import-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="import-title">Import</h2>
                <p class="dnf-card__description">Replace all data of this site with an export - e.g. a copy of another site, or a backup.</p>
            </div>
            <dnf-badge tone="Warning">Development only</dnf-badge>
        </div>
        @if (Model.ImportAllowed)
        {
            <form method="post" action="/admin/data/import" enctype="multipart/form-data"
                  data-confirm="Replace ALL data of this site with the file's? The current data is backed up first, and you are signed out afterwards."
                  data-confirm-title="Import export" data-confirm-action="Import">
                @Html.AntiForgeryToken()
                <div class="dnf-card__body dnf-stack">
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="file">Export file<span class="dnf-field__required" aria-hidden="true">*</span></label>
                        <input id="file" name="file" type="file" class="block w-full text-sm file:me-3 file:h-8 file:px-3 file:rounded-md file:border file:border-border-strong file:bg-surface file:font-semibold file:text-foreground file:cursor-pointer hover:file:bg-surface-hover" accept=".zip,application/zip" required aria-describedby="file-hint" />
                        <span class="dnf-field__description" id="file-hint">
                            A .zip from Download export or a backup of the same CMS version.
                            It is checked completely - format, checksums, versions, a Super Admin - before anything changes.
                        </span>
                    </div>
                    <label class="dnf-check">
                        <input type="checkbox" class="dnf-checkbox" name="confirm" value="true" required />
                        <span class="dnf-check__text">
                            <span>Replace all current data</span>
                            <span class="dnf-check__description">Content, users, settings and the audit log are replaced in one step; a failure changes nothing. A backup of the current data is stored first.</span>
                        </span>
                    </label>
                </div>
                <div class="dnf-card__footer">
                    <button type="submit" class="dnf-button dnf-button--danger"><dnf-icon name="upload" /> Import and replace data</button>
                </div>
            </form>
        }
        else
        {
            <div class="dnf-card__body">
                <dnf-alert tone="Info" title="Not available in production">Import and restore replace all data, so they only run when the app runs in Development. Export and backups work here; import the file into a development copy, or restore through your database's own tools.</dnf-alert>
            </div>
        }
    </section>

    <section class="dnf-card" aria-labelledby="history-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="history-title">History</h2>
                <p class="dnf-card__description">The latest exports, backups, imports and restores.</p>
            </div>
        </div>
        @if (Model.History.Count == 0)
        {
            <dnf-empty-state icon="history" title="Nothing yet" description="Exports, backups and imports are listed here." />
        }
        else
        {
            <div class="dnf-table dnf-table--stack">
                <table class="dnf-table__table">
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Operation</th>
                            <th scope="col">Result</th>
                            <th scope="col">Records</th>
                            <th scope="col">By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in Model.History)
                        {
                            var ok = run.Status == TransferStatus.Success;
                            <tr>
                                <td class="dnf-table__cell--lead">
                                    <span class="dnf-table__primary"><dnf-timestamp value="@run.StartedAt" /></span>
                                    <span class="dnf-table__secondary">@run.FileName</span>
                                </td>
                                <td data-label="Operation">
                                    @(run.Operation == TransferOperation.MediaExport ? "Media export" : run.Operation.ToString())
                                    @if (run.SourceProvider is not null)
                                    {
                                        <span class="dnf-table__secondary">@run.SourceProvider › @run.Provider</span>
                                    }
                                    else if (run.Operation == TransferOperation.MediaExport && run.Note is not null)
                                    {
                                        <span class="dnf-table__secondary">@run.Note</span>
                                    }
                                </td>
                                <td data-label="Result">
                                    <dnf-badge tone="@(ok ? DnfTone.Success : DnfTone.Danger)" dot="true">@(ok ? "Succeeded" : "Failed")</dnf-badge>
                                    @if (run.Error is not null)
                                    {
                                        <span class="dnf-table__secondary">@run.Error</span>
                                    }
                                </td>
                                <td data-label="Records">@(ok ? run.RecordCount.ToString("N0") : "-")</td>
                                <td data-label="By">@By(run.InitiatedById)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
