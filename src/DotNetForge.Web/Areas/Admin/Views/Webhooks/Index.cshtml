@using DotNetForge.Shared.Enums
@model WebhooksController.WebhooksViewModel
@{
    ViewData["Title"] = "Webhooks";
    ViewData["Description"] = "Notify other systems - a search index, a cache, a build - with a signed POST when entries or media change.";
}

@section Actions {
    @if (Model.CanCreate)
    {
        <a class="dnf-button dnf-button--primary" href="/admin/webhooks/create"><dnf-icon name="plus" /> Create webhook</a>
    }
}

<section class="dnf-card" aria-labelledby="webhooks-title">
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="webhooks-title">Webhooks</h2>
            <p class="dnf-card__description">@Model.Rows.Count total · @Model.Rows.Count(r => r.Webhook.Enabled) enabled</p>
        </div>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <dnf-empty-state icon="webhook" title="No webhooks yet" description="Create one to send entry and media changes to another system as they happen." />
    }
    else
    {
        <div class="dnf-table dnf-table--stack">
            <table class="dnf-table__table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Events</th>
                        <th scope="col">Status</th>
                        <th scope="col">Last delivery</th>
                        <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var w = row.Webhook;
                        <tr>
                            <td class="dnf-table__cell--lead">
                                <a class="dnf-table__primary" href="/admin/webhooks/@w.Id">@w.Name</a>
                                <span class="dnf-table__secondary truncate max-w-[28rem]" title="@w.Url">@w.Url</span>
                            </td>
                            <td data-label="Events">
                                <span class="dnf-cluster">
                                    @foreach (var e in w.Events)
                                    {
                                        <dnf-badge><code>@e</code></dnf-badge>
                                    }
                                </span>
                            </td>
                            <td data-label="Status"><dnf-badge tone="@(w.Enabled ? DnfTone.Success : DnfTone.Neutral)" dot="true">@(w.Enabled ? "Enabled" : "Disabled")</dnf-badge></td>
                            <td data-label="Last delivery">
                                @if (row.Last is { } last)
                                {
                                    <span class="dnf-cluster">
                                        <dnf-badge tone="@(last.Outcome == WebhookOutcome.Success ? DnfTone.Success : DnfTone.Danger)">@(last.ResponseStatusCode?.ToString() ?? "failed")</dnf-badge>
                                        <dnf-timestamp value="@last.RequestTimestamp" />
                                    </span>
                                    @if (row.Failures24h > 0)
                                    {
                                        <span class="dnf-table__secondary">@row.Failures24h failed attempt@(row.Failures24h == 1 ? "" : "s") in 24 h</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-subtle">Never</span>
                                }
                            </td>
                            <td class="dnf-table__cell--actions">
                                <dnf-dropdown label="Actions for @w.Name">
                                    <dnf-dropdown-link href="/admin/webhooks/@w.Id" icon="pencil">@(Model.CanUpdate ? "Edit" : "View")</dnf-dropdown-link>
                                    <dnf-dropdown-link href="/admin/webhooks/@w.Id/deliveries" icon="list">Delivery log</dnf-dropdown-link>
                                    @if (Model.CanUpdate)
                                    {
                                        <dnf-dropdown-post action="/admin/webhooks/@w.Id/test" icon="send">Send test delivery</dnf-dropdown-post>
                                        <dnf-dropdown-post action="/admin/webhooks/@w.Id/@(w.Enabled ? "disable" : "enable")" icon="power">@(w.Enabled ? "Disable" : "Enable")</dnf-dropdown-post>
                                    }
                                    @if (Model.CanDelete)
                                    {
                                        <dnf-dropdown-separator />
                                        <dnf-dropdown-post action="/admin/webhooks/@w.Id/delete" icon="trash" danger="true"
                                                   confirm="Delete '@w.Name' and its delivery log? Its receiver gets nothing more."
                                                   confirm-title="Delete webhook" confirm-action="Delete">Delete</dnf-dropdown-post>
                                    }
                                </dnf-dropdown>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
