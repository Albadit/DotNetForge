@using DotNetForge.Shared.Constants
@using DotNetForge.Web.Services.Webhooks
@model WebhooksController.WebhookEditViewModel
@{
    var creating = Model.Id is null;
    var input = Model.Input;
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = creating ? "Create webhook" : input.Name;
    ViewData["Description"] = creating
        ? "Where to send which changes. The signing secret is made for you and shown once after saving."
        : "Where it sends which changes. The secret is never shown again - rotate it to get a new one.";
    var action = creating ? "/admin/webhooks/create" : $"/admin/webhooks/{Model.Id}";
    // The filled-in headers plus one empty row, so one can be added without JavaScript; webhooks.js adds more.
    var headers = input.Headers.Where(h => !string.IsNullOrEmpty(h.Key) || !string.IsNullOrEmpty(h.Value)).ToList();
    if (headers.Count < WebhookService.MaxHeaders)
    {
        headers.Add(new WebhookHeader());
    }

    (string Key, string Label, string Hint)[] events =
    {
        (WebhookEvents.EntryCreate, "Entry created", "A new entry in the Content Manager or through the API."),
        (WebhookEvents.EntryUpdate, "Entry updated", "Its fields were saved."),
        (WebhookEvents.EntryPublish, "Entry published", "In the Content Manager or through the API."),
        (WebhookEvents.EntryUnpublish, "Entry unpublished", "No longer live."),
        (WebhookEvents.EntryDelete, "Entry deleted", "The payload has no data, only the id."),
        (WebhookEvents.MediaCreate, "Media uploaded", "A new file in the media library."),
        (WebhookEvents.MediaUpdate, "Media updated", "Renamed, moved, or made public or private."),
        (WebhookEvents.MediaDelete, "Media deleted", "The payload has no data, only the id."),
    };
}

@section Actions {
    @if (!creating)
    {
        <a class="btn btn-secondary" href="/admin/webhooks/@Model.Id/deliveries"><icon name="list" /> Delivery log</a>
        @if (Model.CanSave)
        {
            <form method="post" action="/admin/webhooks/@Model.Id/test">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnTo" value="edit" />
                <button type="submit" class="btn btn-secondary"><icon name="send" /> Send test delivery</button>
            </form>
        }
    }
}

<div class="editor">
    <div class="editor-main">
        <form method="post" action="@action" class="stack-lg" data-webhook-form>
            @Html.AntiForgeryToken()
            <form-errors />
            <fieldset class="fieldset stack-lg" disabled="@(Model.CanSave ? null : "disabled")">
                <legend class="sr-only">Webhook</legend>
                <section class="card" aria-labelledby="target-title">
                    <div class="card-header"><h2 class="card-title" id="target-title">Receiver</h2></div>
                    <div class="card-body stack">
                        <div class="field">
                            <label class="field-label" for="Name">Name<span class="field-required" aria-hidden="true">*</span></label>
                            <input id="Name" name="Name" value="@input.Name" required maxlength="@WebhookService.MaxNameLength" placeholder="Search index" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="Url">URL<span class="field-required" aria-hidden="true">*</span></label>
                            <input id="Url" name="Url" type="url" value="@input.Url" required maxlength="@WebhookService.MaxUrlLength"
                                   placeholder="https://example.com/hooks/cms" aria-describedby="url-hint" />
                            <span class="field-hint" id="url-hint">An https address. Each event is a POST with a JSON body, signed in the <code>@WebhookEvents.SignatureHeader</code> header.</span>
                        </div>
                        <label class="switch-row">
                            <span class="check-text">
                                <span>Enabled</span>
                                <span class="check-hint">Off: it doesn't fire, and pending retries are cancelled. The settings are kept.</span>
                            </span>
                            @* The checkbox first: a bound bool takes the first posted value. *@
                            <input type="checkbox" class="switch" role="switch" name="Enabled" value="true" checked="@(input.Enabled ? "checked" : null)" />
                            <input type="hidden" name="Enabled" value="false" />
                        </label>
                    </div>
                </section>

                <section class="card" aria-labelledby="events-title">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title" id="events-title">Events<span class="field-required" aria-hidden="true">*</span></h2>
                            <p class="card-description">At least one. Each change sends one POST; a failed one is retried @(WebhookDispatcher.MaxAttempts - 1) times with growing pauses.</p>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="form-grid">
                            @foreach (var (key, label, hint) in events)
                            {
                                <label class="check">
                                    <input type="checkbox" name="Events" value="@key" checked="@(input.Events.Contains(key) ? "checked" : null)" />
                                    <span class="check-text"><span>@label <code class="text-xs">@key</code></span><span class="check-hint">@hint</span></span>
                                </label>
                            }
                        </div>
                    </div>
                </section>

                <section class="card" aria-labelledby="headers-title">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title" id="headers-title">Headers</h2>
                            <p class="card-description">Sent with every request, e.g. an <code>Authorization</code> token the receiver expects. The value may be empty.</p>
                        </div>
                    </div>
                    <div class="card-body stack-sm">
                        <div class="webhook-headers stack-sm" data-webhook-headers data-max="@WebhookService.MaxHeaders">
                            @for (var i = 0; i < headers.Count; i++)
                            {
                                <div class="webhook-header-row" data-webhook-header>
                                    <label class="sr-only" for="Headers_@(i)__Key">Header name</label>
                                    <input id="Headers_@(i)__Key" name="Headers[@i].Key" value="@headers[i].Key" placeholder="Name, e.g. Authorization" maxlength="100" spellcheck="false" />
                                    <label class="sr-only" for="Headers_@(i)__Value">Header value</label>
                                    <input id="Headers_@(i)__Value" name="Headers[@i].Value" value="@headers[i].Value" placeholder="Value" maxlength="1000" spellcheck="false" autocomplete="off" />
                                    <button type="button" class="btn btn-ghost btn-icon btn-sm" data-webhook-header-remove aria-label="Remove header" data-js-only hidden><icon name="x" /></button>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm webhook-header-add" data-webhook-header-add data-js-only hidden><icon name="plus" size="sm" /> Add header</button>
                    </div>
                    @if (Model.CanSave)
                    {
                        <div class="card-footer">
                            <a class="btn" href="/admin/webhooks">Cancel</a>
                            <button type="submit" class="btn btn-primary"><icon name="check" /> @(creating ? "Create webhook" : "Save")</button>
                        </div>
                    }
                </section>
            </fieldset>
        </form>
    </div>

    @if (!creating)
    {
        <aside class="editor-aside">
            <section class="card" aria-labelledby="about-title">
                <div class="card-header"><h2 class="card-title" id="about-title">Webhook</h2></div>
                <div class="card-body">
                    <dl class="dl dl-compact">
                        <dt>Created</dt>
                        <dd><timestamp value="@Model.Created" /></dd>
                        <dt>Last delivery</dt>
                        <dd><timestamp value="@Model.LastDelivery" empty="Never" /></dd>
                    </dl>
                </div>
            </section>

            @if (Model.CanSave)
            {
                <section class="card" aria-labelledby="secret-title">
                    <div class="card-header"><h2 class="card-title" id="secret-title">Signing secret</h2></div>
                    <div class="card-body stack-sm">
                        <p class="text-sm text-muted">Shown once, after it was made. A new one replaces it at once: update the receiver too, or its signature checks fail.</p>
                        <form method="post" action="/admin/webhooks/@Model.Id/rotate"
                              data-confirm="Make a new secret? Deliveries are signed with it from now on; the receiver must use it to check them."
                              data-confirm-title="Rotate secret" data-confirm-action="Rotate secret">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-secondary btn-sm"><icon name="refresh-cw" /> Rotate secret</button>
                        </form>
                    </div>
                </section>
            }

            @if (Model.CanDelete)
            {
                <section class="card card-danger" aria-labelledby="delete-title">
                    <div class="card-header"><h2 class="card-title" id="delete-title">Delete webhook</h2></div>
                    <div class="card-body stack-sm">
                        <p class="text-sm text-muted">Removes the webhook and its delivery log.</p>
                        <form method="post" action="/admin/webhooks/@Model.Id/delete"
                              data-confirm="Delete '@input.Name' and its delivery log?" data-confirm-title="Delete webhook" data-confirm-action="Delete">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger-soft btn-sm"><icon name="trash" /> Delete webhook</button>
                        </form>
                    </div>
                </section>
            }
        </aside>
    }
</div>

<template id="webhook-header-template">
    <div class="webhook-header-row" data-webhook-header>
        <label class="sr-only">Header name</label>
        <input data-part="Key" placeholder="Name, e.g. Authorization" maxlength="100" spellcheck="false" />
        <label class="sr-only">Header value</label>
        <input data-part="Value" placeholder="Value" maxlength="1000" spellcheck="false" autocomplete="off" />
        <button type="button" class="btn btn-ghost btn-icon btn-sm" data-webhook-header-remove aria-label="Remove header"><icon name="x" /></button>
    </div>
</template>

@section Scripts {
    <script src="~/js/forge/webhooks.js" asp-append-version="true" defer></script>
}
