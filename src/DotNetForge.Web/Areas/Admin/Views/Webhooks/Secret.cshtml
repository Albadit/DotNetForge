@using DotNetForge.Shared.Constants
@model WebhooksController.SecretViewModel
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = Model.Created ? T["Webhook created"] : T["New signing secret"];
    ViewData["Description"] = T["'{0}' signs every delivery with this secret.", Model.Name];
}

<div class="dnf-stack dnf-stack--lg max-w-(--dnf-form-max)">
    <dnf-alert tone="Warning" title="@T["Copy the secret now"]">
        @T["This is the only time it is shown. Store it with the receiver; to get another one, rotate it on the webhook."]
        @(Model.Created ? "" : T["The old secret stopped working: deliveries are signed with this one from now on."])
    </dnf-alert>

    <section class="dnf-card dnf-card--accent" aria-labelledby="secret-title">
        <div class="dnf-card__header"><h2 class="dnf-card__title" id="secret-title">@T["Signing secret"]</h2></div>
        <div class="dnf-card__body dnf-stack">
            <pre class="dnf-code-block">@Model.Secret<button type="button" class="dnf-button dnf-button--secondary dnf-button--sm dnf-code-block__copy" data-copy-target="#secret-text" data-js-only hidden><dnf-icon name="copy" size="Sm" /> @T["Copy"]</button></pre>
            <span id="secret-text" hidden>@Model.Secret</span>
            <div class="dnf-stack dnf-stack--sm">
                <span class="dnf-field__label">@T["Check a delivery on the receiver"]</span>
                <p class="text-sm text-muted">
                    @T["The"] <code>@WebhookEvents.SignatureHeader</code> @T["header is the lowercase hex HMAC-SHA256 of the raw request body with this secret. Compute it over the bytes as received - before parsing the JSON - and compare in constant time."]
                    <code>X-DotNetForge-Delivery</code> @T["is the event id: the same on every retry, so you can skip duplicates."]
                </p>
                <pre class="dnf-code-block">// Node.js
const expected = crypto.createHmac("sha256", secret).update(rawBody).digest("hex");
const ok = crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(req.headers["x-dotnetforge-signature"]));</pre>
            </div>
        </div>
        <div class="dnf-card__footer">
            <a class="dnf-button dnf-button--secondary" href="/admin/webhooks/@Model.Id">@T["Edit webhook"]</a>
            <a class="dnf-button dnf-button--primary" href="/admin/webhooks">@T["Done"]</a>
        </div>
    </section>
</div>
