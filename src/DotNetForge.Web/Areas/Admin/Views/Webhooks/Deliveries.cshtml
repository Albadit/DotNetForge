@using DotNetForge.Shared.Enums
@model WebhooksController.DeliveriesViewModel
@{
    var w = Model.Webhook;
    var current = (int)ViewData["Page"]!;
    var pages = (int)ViewData["Pages"]!;
    // Indented for reading; what was sent (and signed) is the compact original.
    static string? Pretty(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return json;
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
    ViewData["Title"] = "Delivery log";
    ViewData["Description"] = $"Every attempt of '{w.Name}' in the last 30 days, newest first.";
}

@section Actions {
    <a class="dnf-button dnf-button--secondary" href="/admin/webhooks/@w.Id"><dnf-icon name="pencil" /> Edit webhook</a>
    @if (Model.CanUpdate)
    {
        <form method="post" action="/admin/webhooks/@w.Id/test">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnTo" value="deliveries" />
            <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="send" /> Send test delivery</button>
        </form>
    }
}

<section class="dnf-card" aria-labelledby="log-title">
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="log-title">Attempts</h2>
            <p class="dnf-card__description">@Model.Total total · to <code>@w.Url</code></p>
        </div>
        <dnf-badge tone="@(w.Enabled ? DnfTone.Success : DnfTone.Neutral)" dot="true">@(w.Enabled ? "Enabled" : "Disabled")</dnf-badge>
    </div>
    @if (Model.Deliveries.Count == 0)
    {
        <dnf-empty-state icon="send" title="Nothing sent yet" description="Attempts appear here when a subscribed event happens, or after a test delivery." />
    }
    else
    {
        <ul class="dnf-list">
            @foreach (var d in Model.Deliveries)
            {
                var tone = d.Outcome switch { WebhookOutcome.Success => DnfTone.Success, WebhookOutcome.Failure => DnfTone.Danger, _ => DnfTone.Neutral };
                var label = d.Outcome switch { WebhookOutcome.Success => d.ResponseStatusCode?.ToString() ?? "OK", WebhookOutcome.Failure => d.ResponseStatusCode?.ToString() ?? "Failed", _ => "Waiting" };
                <li class="dnf-list__item block p-0">
                    <details class="dnf-delivery">
                        <summary class="dnf-delivery__summary">
                            <dnf-badge tone="@tone" dot="true">@label</dnf-badge>
                            <code class="text-sm">@d.Event</code>
                            <span class="text-sm text-muted">attempt @d.AttemptNumber</span>
                            <span class="grow min-w-0"></span>
                            <span class="text-sm text-muted">@(d.ResponseTimeMs is { } ms ? $"{ms} ms" : "")</span>
                            <dnf-timestamp value="@d.RequestTimestamp" absolute="true" />
                        </summary>
                        <div class="dnf-delivery__body dnf-stack dnf-stack--sm">
                            @if (d.Detail is not null)
                            {
                                <p class="text-sm @(d.Outcome == WebhookOutcome.Failure ? "text-danger" : "text-muted")">@d.Detail</p>
                            }
                            <dl class="dnf-description-list dnf-description-list--compact">
                                <dt>Event id</dt>
                                <dd><code>@d.EventId</code></dd>
                                <dt>Target</dt>
                                <dd><code>@d.TargetUrl</code></dd>
                            </dl>
                            <span class="dnf-field__label">Request body</span>
                            <pre class="dnf-code-block dnf-code-block--scroll">@Pretty(d.RequestBody)</pre>
                            @if (d.ResponseBody is not null)
                            {
                                <span class="dnf-field__label">Response (start)</span>
                                <pre class="dnf-code-block dnf-code-block--scroll">@Pretty(d.ResponseBody)</pre>
                            }
                        </div>
                    </details>
                </li>
            }
        </ul>
        @if (pages > 1)
        {
            <div class="dnf-card__footer">
                <span class="text-sm text-muted">Page @current of @pages</span>
                @if (current > 1)
                {
                    <a class="dnf-button dnf-button--secondary dnf-button--sm" href="?page=@(current - 1)"><dnf-icon name="chevron-left" size="Sm" /> Newer</a>
                }
                @if (current < pages)
                {
                    <a class="dnf-button dnf-button--secondary dnf-button--sm" href="?page=@(current + 1)">Older <dnf-icon name="chevron-right" size="Sm" /></a>
                }
            </div>
        }
    }
</section>
