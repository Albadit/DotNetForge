@model MediaSettingsController.MediaSettingsViewModel
@using DotNetForge.Web.Services
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = T["Media Library"];
    ViewData["Description"] = T["Upload limits, and how uploads are optimized to keep storage small."];
    var storage = Model.Storage;
    var savedPercent = storage.SavedBytes > 0 ? (int)Math.Round(storage.SavedBytes * 100d / (storage.StoredBytes + storage.SavedBytes)) : 0;
}

<div class="dnf-stack">
    <section class="dnf-card" aria-labelledby="storage-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="storage-title">@T["Storage"]</h2>
                <p class="dnf-card__description">@T["What the"] <a href="/admin/media">@T["media library"]</a> @T["uses in the media storage now."]</p>
            </div>
        </div>
        <div class="dnf-stat-group">
            <div class="dnf-stat-card">
                <span class="dnf-stat-card__icon" aria-hidden="true"><dnf-icon name="image" /></span>
                <span class="dnf-stat-card__text"><span class="dnf-stat-card__value">@storage.Files.ToString("N0")</span><span class="dnf-stat-card__label">@T["files"]</span></span>
            </div>
            <div class="dnf-stat-card">
                <span class="dnf-stat-card__icon" aria-hidden="true"><dnf-icon name="database" /></span>
                <span class="dnf-stat-card__text"><span class="dnf-stat-card__value">@MediaPresentation.Size(storage.StoredBytes)</span><span class="dnf-stat-card__label">@T["stored"]</span></span>
            </div>
            <div class="dnf-stat-card">
                <span class="dnf-stat-card__icon" aria-hidden="true"><dnf-icon name="gauge" /></span>
                <span class="dnf-stat-card__text">
                    <span class="dnf-stat-card__value">@MediaPresentation.Size(storage.SavedBytes)</span>
                    <span class="dnf-stat-card__label">@T["saved by optimization"]@(savedPercent > 0 ? $" ({savedPercent}%)" : null)</span>
                </span>
            </div>
        </div>
        @if (storage.Queued > 0 || storage.Failed > 0)
        {
            <div class="dnf-card__body">
                <p class="text-sm text-muted">
                    <dnf-icon name="info" size="Sm" />
                    @if (storage.Queued > 0)
                    {
                        <text>@T["{0} video(s) waiting for compression.", storage.Queued] </text>
                    }
                    @if (storage.Failed > 0)
                    {
                        <text>@T["{0} video(s) could not be compressed and are kept as uploaded (see the application log).", storage.Failed]</text>
                    }
                </p>
            </div>
        }
    </section>

    <form method="post" action="/admin/media-settings" class="dnf-stack">
        @Html.AntiForgeryToken()
        <dnf-validation-summary />
        <fieldset class="dnf-fieldset dnf-stack" disabled="@(Model.CanEdit ? null : "disabled")">
            <legend class="sr-only">@T["Media Library settings"]</legend>

            <section class="dnf-card" aria-labelledby="limits-title">
                <div class="dnf-card__header">
                    <div>
                        <h2 class="dnf-card__title" id="limits-title">@T["Upload limits"]</h2>
                        <p class="dnf-card__description">@T["The largest file people can upload, per kind - on the Media screen, in entry forms and in the page builder."]</p>
                    </div>
                </div>
                <div class="dnf-card__body dnf-stack">
                    <div class="dnf-form-grid dnf-form-grid--3">
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="MaxImageMb">@T["Images (MB)"]</label>
                            <input id="MaxImageMb" name="MaxImageMb" type="number" class="dnf-input" min="1" max="@MediaSettings.MaxLimitMb" required value="@Model.MaxImageMb" />
                        </div>
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="MaxVideoMb">@T["Videos and audio (MB)"]</label>
                            <input id="MaxVideoMb" name="MaxVideoMb" type="number" class="dnf-input" min="1" max="@MediaSettings.MaxLimitMb" required value="@Model.MaxVideoMb" />
                        </div>
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="MaxOtherMb">@T["Other files (MB)"]</label>
                            <input id="MaxOtherMb" name="MaxOtherMb" type="number" class="dnf-input" min="1" max="@MediaSettings.MaxLimitMb" required value="@Model.MaxOtherMb" />
                        </div>
                    </div>
                    <p class="dnf-note text-sm text-muted"><dnf-icon name="info" size="Sm" /><span>@T["Up to {0} MB. Behind a reverse proxy, allow large request bodies there too (nginx:", MediaSettings.MaxLimitMb] <code>client_max_body_size</code>).</span></p>
                </div>
            </section>

            <section class="dnf-card" aria-labelledby="images-title">
                <div class="dnf-card__header">
                    <div>
                        <h2 class="dnf-card__title" id="images-title">@T["Images"]</h2>
                        <p class="dnf-card__description">@T["JPEG, PNG and WebP uploads. GIF and AVIF, animations and very large images are stored as uploaded."]</p>
                    </div>
                </div>
                <div class="dnf-card__body dnf-stack">
                    <label class="dnf-switch-row">
                        <span class="dnf-check__text">
                            <span>@T["Optimize images on upload"]</span>
                            <span class="dnf-check__description">@T["Turned upright, scaled down to the size below and re-encoded at the quality below; camera metadata (EXIF, GPS) is removed. The smaller version is kept only when it is smaller than the upload."]</span>
                        </span>
                        @* The checkbox first: a bound bool takes the first posted value. *@
                        <input type="checkbox" class="dnf-switch" role="switch" name="OptimizeImages" value="true" checked="@(Model.OptimizeImages ? "checked" : null)" />
                        <input type="hidden" name="OptimizeImages" value="false" />
                    </label>
                    <div class="dnf-form-grid dnf-form-grid--3">
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="ImageMaxWidth">@T["Maximum width (px)"]</label>
                            <input id="ImageMaxWidth" name="ImageMaxWidth" type="number" class="dnf-input" min="320" max="10000" required value="@Model.ImageMaxWidth" />
                        </div>
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="ImageMaxHeight">@T["Maximum height (px)"]</label>
                            <input id="ImageMaxHeight" name="ImageMaxHeight" type="number" class="dnf-input" min="320" max="10000" required value="@Model.ImageMaxHeight" />
                        </div>
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="ImageQuality">@T["Quality (40-100)"]</label>
                            <input id="ImageQuality" name="ImageQuality" type="number" class="dnf-input" min="40" max="100" required value="@Model.ImageQuality" aria-describedby="quality-hint" />
                            <span class="dnf-field__description" id="quality-hint">@T["80-85 looks the same as the original for photos."]</span>
                        </div>
                    </div>
                    <label class="dnf-switch-row">
                        <span class="dnf-check__text">
                            <span>@T["Store as WebP"]</span>
                            <span class="dnf-check__description">@T["JPEG and PNG become WebP - usually 25-35% smaller, shown by every current browser. The file name gets the .webp extension."]</span>
                        </span>
                        <input type="checkbox" class="dnf-switch" role="switch" name="ConvertToWebP" value="true" checked="@(Model.ConvertToWebP ? "checked" : null)" />
                        <input type="hidden" name="ConvertToWebP" value="false" />
                    </label>
                </div>
            </section>

            <section class="dnf-card" aria-labelledby="videos-title">
                <div class="dnf-card__header">
                    <div>
                        <h2 class="dnf-card__title" id="videos-title">@T["Videos"]</h2>
                        <p class="dnf-card__description">@T["MP4 uploads, compressed with ffmpeg in the background after upload (H.264 video, AAC audio)."]</p>
                    </div>
                    @if (Model.Ffmpeg.Available)
                    {
                        <dnf-badge tone="Success" dot="true">@T["ffmpeg found"]</dnf-badge>
                    }
                    else
                    {
                        <dnf-badge dot="true">@T["No ffmpeg"]</dnf-badge>
                    }
                </div>
                <div class="dnf-card__body dnf-stack">
                    @if (Model.Ffmpeg.Available)
                    {
                        <p class="dnf-note text-sm text-muted"><dnf-icon name="check" size="Sm" /><span>@Model.Ffmpeg.Version - <code>@Model.Ffmpeg.Path</code></span></p>
                    }
                    else if (Model.Ffmpeg.Configured)
                    {
                        <dnf-alert tone="Warning" title="@T["ffmpeg doesn't run"]">@Model.Ffmpeg.Problem @T["Check"] <code>FFMPEG_PATH</code> @T["in"] <code>.env</code> @T["and restart."]</dnf-alert>
                    }
                    else
                    {
                        <dnf-alert tone="Info" title="@T["Video compression needs ffmpeg"]">@T["Install ffmpeg on the server and set"] <code>FFMPEG_PATH</code> @T["in"] <code>.env</code> (@T["for example"] <code>/usr/bin/ffmpeg</code>), @T["then restart. The Docker image includes it when built with"] <code>--build-arg WITH_FFMPEG=true</code>. @T["Until then videos are stored as uploaded."]</dnf-alert>
                    }
                    <label class="dnf-switch-row">
                        <span class="dnf-check__text">
                            <span>@T["Compress videos"]</span>
                            <span class="dnf-check__description">@T["The upload is available right away; when the compressed version is ready and smaller, it replaces it (same link). One video at a time."]</span>
                        </span>
                        <input type="checkbox" class="dnf-switch" role="switch" name="CompressVideos" value="true"
                               checked="@(Model.CompressVideos ? "checked" : null)" disabled="@(Model.Ffmpeg.Available ? null : "disabled")" />
                        <input type="hidden" name="CompressVideos" value="false" />
                    </label>
                    <div class="dnf-form-grid">
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="VideoResolution">@T["Maximum resolution"]</label>
                            <select id="VideoResolution" name="VideoResolution" class="dnf-select" aria-describedby="resolution-hint">
                                @foreach (var resolution in MediaSettings.VideoResolutions)
                                {
                                    <option value="@resolution" selected="@(resolution == Model.VideoResolution ? "selected" : null)">@(resolution == 2160 ? "4K (2160p)" : resolution + "p")</option>
                                }
                            </select>
                            <span class="dnf-field__description" id="resolution-hint">@T["Larger videos are scaled down (the short side); smaller ones keep their size."]</span>
                        </div>
                        <div class="dnf-field">
                            <label class="dnf-field__label" for="VideoCrf">@T["Quality"]</label>
                            <select id="VideoCrf" name="VideoCrf" class="dnf-select">
                                @foreach (var (label, crf) in MediaSettings.VideoQualities)
                                {
                                    <option value="@crf" selected="@(crf == Model.VideoCrf ? "selected" : null)">@T[label]</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                @if (Model.CanEdit)
                {
                    @* One form across the three cards: this saves the limits and image settings too. *@
                    <div class="dnf-card__footer">
                        <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="check" /> @T["Save settings"]</button>
                    </div>
                }
            </section>
        </fieldset>
    </form>
</div>
