@model MediaSettingsController.MediaSettingsViewModel
@using DotNetForge.Web.Services
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = "Media Library";
    ViewData["Description"] = "Upload limits, and how uploads are optimized to keep storage small.";
    var storage = Model.Storage;
    var savedPercent = storage.SavedBytes > 0 ? (int)Math.Round(storage.SavedBytes * 100d / (storage.StoredBytes + storage.SavedBytes)) : 0;
}

<div class="stack">
    <section class="card" aria-labelledby="storage-title">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="storage-title">Storage</h2>
                <p class="card-description">What the <a href="/admin/media">media library</a> uses in the media storage now.</p>
            </div>
        </div>
        <div class="stat-grid">
            <div class="stat">
                <span class="stat-icon" aria-hidden="true"><icon name="image" /></span>
                <span class="stat-text"><span class="stat-value">@storage.Files.ToString("N0")</span><span class="stat-label">files</span></span>
            </div>
            <div class="stat">
                <span class="stat-icon" aria-hidden="true"><icon name="database" /></span>
                <span class="stat-text"><span class="stat-value">@MediaPresentation.Size(storage.StoredBytes)</span><span class="stat-label">stored</span></span>
            </div>
            <div class="stat">
                <span class="stat-icon" aria-hidden="true"><icon name="gauge" /></span>
                <span class="stat-text">
                    <span class="stat-value">@MediaPresentation.Size(storage.SavedBytes)</span>
                    <span class="stat-label">saved by optimization@(savedPercent > 0 ? $" ({savedPercent}%)" : null)</span>
                </span>
            </div>
        </div>
        @if (storage.Queued > 0 || storage.Failed > 0)
        {
            <div class="card-body">
                <p class="text-sm text-muted">
                    <icon name="info" size="sm" />
                    @if (storage.Queued > 0)
                    {
                        <text>@storage.Queued video(s) waiting for compression. </text>
                    }
                    @if (storage.Failed > 0)
                    {
                        <text>@storage.Failed video(s) could not be compressed and are kept as uploaded (see the application log).</text>
                    }
                </p>
            </div>
        }
    </section>

    <form method="post" action="/admin/media-settings" class="stack">
        @Html.AntiForgeryToken()
        <form-errors />
        <fieldset class="fieldset stack" disabled="@(Model.CanEdit ? null : "disabled")">
            <legend class="sr-only">Media Library settings</legend>

            <section class="card" aria-labelledby="limits-title">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="limits-title">Upload limits</h2>
                        <p class="card-description">The largest file people can upload, per kind - on the Media screen, in entry forms and in the page builder.</p>
                    </div>
                </div>
                <div class="card-body stack">
                    <div class="form-grid form-grid-3">
                        <div class="field">
                            <label class="field-label" for="MaxImageMb">Images (MB)</label>
                            <input id="MaxImageMb" name="MaxImageMb" type="number" min="1" max="@MediaSettings.MaxLimitMb" required value="@Model.MaxImageMb" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="MaxVideoMb">Videos and audio (MB)</label>
                            <input id="MaxVideoMb" name="MaxVideoMb" type="number" min="1" max="@MediaSettings.MaxLimitMb" required value="@Model.MaxVideoMb" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="MaxOtherMb">Other files (MB)</label>
                            <input id="MaxOtherMb" name="MaxOtherMb" type="number" min="1" max="@MediaSettings.MaxLimitMb" required value="@Model.MaxOtherMb" />
                        </div>
                    </div>
                    <p class="note text-sm text-muted"><icon name="info" size="sm" /><span>Up to @MediaSettings.MaxLimitMb MB. Behind a reverse proxy, allow large request bodies there too (nginx: <code>client_max_body_size</code>).</span></p>
                </div>
            </section>

            <section class="card" aria-labelledby="images-title">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="images-title">Images</h2>
                        <p class="card-description">JPEG, PNG and WebP uploads. GIF and AVIF, animations and very large images are stored as uploaded.</p>
                    </div>
                </div>
                <div class="card-body stack">
                    <label class="switch-row">
                        <span class="check-text">
                            <span>Optimize images on upload</span>
                            <span class="check-hint">Turned upright, scaled down to the size below and re-encoded at the quality below; camera metadata (EXIF, GPS) is removed. The smaller version is kept only when it is smaller than the upload.</span>
                        </span>
                        @* The checkbox first: a bound bool takes the first posted value. *@
                        <input type="checkbox" class="switch" role="switch" name="OptimizeImages" value="true" checked="@(Model.OptimizeImages ? "checked" : null)" />
                        <input type="hidden" name="OptimizeImages" value="false" />
                    </label>
                    <div class="form-grid form-grid-3">
                        <div class="field">
                            <label class="field-label" for="ImageMaxWidth">Maximum width (px)</label>
                            <input id="ImageMaxWidth" name="ImageMaxWidth" type="number" min="320" max="10000" required value="@Model.ImageMaxWidth" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="ImageMaxHeight">Maximum height (px)</label>
                            <input id="ImageMaxHeight" name="ImageMaxHeight" type="number" min="320" max="10000" required value="@Model.ImageMaxHeight" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="ImageQuality">Quality (40-100)</label>
                            <input id="ImageQuality" name="ImageQuality" type="number" min="40" max="100" required value="@Model.ImageQuality" aria-describedby="quality-hint" />
                            <span class="field-hint" id="quality-hint">80-85 looks the same as the original for photos.</span>
                        </div>
                    </div>
                    <label class="switch-row">
                        <span class="check-text">
                            <span>Store as WebP</span>
                            <span class="check-hint">JPEG and PNG become WebP - usually 25-35% smaller, shown by every current browser. The file name gets the .webp extension.</span>
                        </span>
                        <input type="checkbox" class="switch" role="switch" name="ConvertToWebP" value="true" checked="@(Model.ConvertToWebP ? "checked" : null)" />
                        <input type="hidden" name="ConvertToWebP" value="false" />
                    </label>
                </div>
            </section>

            <section class="card" aria-labelledby="videos-title">
                <div class="card-header">
                    <div>
                        <h2 class="card-title" id="videos-title">Videos</h2>
                        <p class="card-description">MP4 uploads, compressed with ffmpeg in the background after upload (H.264 video, AAC audio).</p>
                    </div>
                    @if (Model.Ffmpeg.Available)
                    {
                        <badge tone="Success" dot="true">ffmpeg found</badge>
                    }
                    else
                    {
                        <badge dot="true">No ffmpeg</badge>
                    }
                </div>
                <div class="card-body stack">
                    @if (Model.Ffmpeg.Available)
                    {
                        <p class="note text-sm text-muted"><icon name="check" size="sm" /><span>@Model.Ffmpeg.Version - <code>@Model.Ffmpeg.Path</code></span></p>
                    }
                    else if (Model.Ffmpeg.Configured)
                    {
                        <alert tone="Warning" title="ffmpeg doesn't run">@Model.Ffmpeg.Problem Check <code>FFMPEG_PATH</code> in <code>.env</code> and restart.</alert>
                    }
                    else
                    {
                        <alert tone="Info" title="Video compression needs ffmpeg">Install ffmpeg on the server and set <code>FFMPEG_PATH</code> in <code>.env</code> (for example <code>/usr/bin/ffmpeg</code>), then restart. The Docker image includes it when built with <code>--build-arg WITH_FFMPEG=true</code>. Until then videos are stored as uploaded.</alert>
                    }
                    <label class="switch-row">
                        <span class="check-text">
                            <span>Compress videos</span>
                            <span class="check-hint">The upload is available right away; when the compressed version is ready and smaller, it replaces it (same link). One video at a time.</span>
                        </span>
                        <input type="checkbox" class="switch" role="switch" name="CompressVideos" value="true"
                               checked="@(Model.CompressVideos ? "checked" : null)" disabled="@(Model.Ffmpeg.Available ? null : "disabled")" />
                        <input type="hidden" name="CompressVideos" value="false" />
                    </label>
                    <div class="form-grid">
                        <div class="field">
                            <label class="field-label" for="VideoResolution">Maximum resolution</label>
                            <select id="VideoResolution" name="VideoResolution" aria-describedby="resolution-hint">
                                @foreach (var resolution in MediaSettings.VideoResolutions)
                                {
                                    <option value="@resolution" selected="@(resolution == Model.VideoResolution ? "selected" : null)">@(resolution == 2160 ? "4K (2160p)" : resolution + "p")</option>
                                }
                            </select>
                            <span class="field-hint" id="resolution-hint">Larger videos are scaled down (the short side); smaller ones keep their size.</span>
                        </div>
                        <div class="field">
                            <label class="field-label" for="VideoCrf">Quality</label>
                            <select id="VideoCrf" name="VideoCrf">
                                @foreach (var (label, crf) in MediaSettings.VideoQualities)
                                {
                                    <option value="@crf" selected="@(crf == Model.VideoCrf ? "selected" : null)">@label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                @if (Model.CanEdit)
                {
                    @* One form across the three cards: this saves the limits and image settings too. *@
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary"><icon name="check" /> Save settings</button>
                    </div>
                }
            </section>
        </fieldset>
    </form>
</div>
