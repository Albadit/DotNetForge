@{
    ViewData["Title"] = T["API Docs"];
    ViewData["Description"] = T["Try the API: the headless API with an API token, and your custom endpoints with their own tokens (filled in)."];
}

@section Actions {
    <a class="dnf-button dnf-button--secondary" href="/admin/api-tokens"><dnf-icon name="key" /> @T["API tokens"]</a>
    <a class="dnf-button dnf-button--secondary" href="/admin/api-endpoints"><dnf-icon name="code" /> @T["API endpoints"]</a>
    <a class="dnf-button dnf-button--secondary" href="/admin/api-docs/reference/" target="_blank" rel="noopener"><dnf-icon name="external-link" /> @T["Open full screen"]</a>
}

@* Scalar renders a full HTML page of its own, so it is isolated in a frame like an admin extension tab
   (.docs/pages/api-docs.md). A skeleton shows until the frame has loaded (dnf.js marks [data-frame-host] with data-loaded). *@
<div class="dnf-card dnf-ext-frame" data-frame-host>
    <div class="dnf-ext-frame__loading" aria-hidden="true" data-js-only hidden>
        <div class="dnf-skeleton dnf-skeleton--title"></div>
        <div class="dnf-skeleton dnf-skeleton--line"></div>
        <div class="dnf-skeleton dnf-skeleton--line w-2/3"></div>
        <div class="dnf-skeleton dnf-skeleton--line w-2/5"></div>
    </div>
    <iframe class="dnf-ext-frame__frame" src="/admin/api-docs/reference/" title="@T["API reference"]" data-frame></iframe>
</div>
