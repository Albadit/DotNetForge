@model List<ApiToken>
@{
    ViewData["Title"] = T["API Tokens"];
    ViewData["Description"] = T["Scoped tokens for the headless API. A token's secret is shown once, when it is created."];
}

@section Actions {
    <a class="dnf-button dnf-button--primary" href="/admin/api-tokens/create"><dnf-icon name="plus" /> @T["Create token"]</a>
}

<section class="dnf-card" aria-labelledby="tokens-title" data-collection data-page-size="25">
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="tokens-title">@T["Tokens"]</h2>
            <p class="dnf-card__description" data-collection-count>@T["{0} total", Model.Count]</p>
        </div>
        @if (Model.Count > 0)
        {
            <div class="dnf-segmented" role="group" aria-label="@T["Filter tokens"]" data-js-only hidden>
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="" aria-pressed="true">@T["All"]</button>
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="active" aria-pressed="false">@T["Active"]</button>
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="expired" aria-pressed="false">@T["Expired"]</button>
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="revoked" aria-pressed="false">@T["Revoked"]</button>
            </div>
        }
    </div>
    @if (Model.Count == 0)
    {
        <dnf-empty-state icon="key" title="@T["No API tokens yet"]" description="@T["Create a token to let an app or website read your content through the API."]" />
    }
    else
    {
        <div class="dnf-table dnf-table--stack">
            <table class="dnf-table__table">
                <thead>
                    <tr>
                        <th scope="col" data-sort="text">@T["Name"]</th>
                        <th scope="col">@T["Token"]</th>
                        <th scope="col" data-sort="number">@T["Scopes"]</th>
                        <th scope="col" data-sort="date">@T["Last used"]</th>
                        <th scope="col" data-sort="date">@T["Expires"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">@T["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var token in Model)
                    {
                        var expired = token.ExpirationDate is { } exp && exp < DateTime.UtcNow;
                        <tr data-item data-state="@(token.Revoked ? "revoked" : expired ? "expired" : "active")">
                            <td class="dnf-table__cell--lead">
                                <span class="dnf-table__primary">@token.Name</span>
                                <span class="dnf-table__secondary">@T["Created"] <dnf-timestamp value="@token.CreatedDate" /></span>
                            </td>
                            <td data-label="@T["Token"]"><code>@token.TokenPrefix…</code></td>
                            <td data-label="@T["Scopes"]" data-sort-value="@token.Permissions.Count">@token.Permissions.Count</td>
                            <td data-label="@T["Last used"]" data-sort-value="@(token.LastUsedDate?.ToString("O") ?? "")"><dnf-timestamp value="@token.LastUsedDate" /></td>
                            <td data-label="@T["Expires"]" data-sort-value="@(token.ExpirationDate?.ToString("O") ?? "9999")"><dnf-timestamp value="@token.ExpirationDate" empty="@T["Never"]" /></td>
                            <td data-label="@T["Status"]">
                                @if (token.Revoked)
                                {
                                    <dnf-badge tone="Danger" dot="true">@T["Revoked"]</dnf-badge>
                                }
                                else if (expired)
                                {
                                    <dnf-badge tone="Warning" dot="true">@T["Expired"]</dnf-badge>
                                }
                                else
                                {
                                    <dnf-badge tone="Success" dot="true">@T["Active"]</dnf-badge>
                                }
                            </td>
                            <td class="dnf-table__cell--actions">
                                @if (!token.Revoked && !expired)
                                {
                                    <form method="post" asp-action="Revoke" asp-route-id="@token.Id" class="inline"
                                          data-confirm="@T["Revoke '{0}'? Apps using it lose access immediately. This can't be undone.", token.Name]"
                                          data-confirm-title="@T["Revoke token"]" data-confirm-action="@T["Revoke token"]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dnf-button dnf-button--danger-soft dnf-button--sm">@T["Revoke"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="dnf-table__empty" data-collection-empty hidden><td colspan="7">@T["No token matches the filter."]</td></tr>
                </tbody>
            </table>
        </div>
        <div class="dnf-pagination" data-collection-pagination hidden></div>
    }
</section>
