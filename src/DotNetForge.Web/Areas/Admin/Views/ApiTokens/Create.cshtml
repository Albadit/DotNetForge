@using DotNetForge.Shared.Constants
@{
    ViewData["PageWidth"] = "narrow";
    ViewData["Title"] = T["Create API token"];
    ViewData["Description"] = T["Give the token a name you'll recognise, choose how long it lives and what it may do."];
    var permissions = ViewBag.Permissions as IReadOnlyList<string> ?? Array.Empty<string>();

    // After a validation error the view is shown again: keep what was entered.
    var posted = Context.Request.HasFormContentType ? Context.Request.Form : null;
    var name = posted?["name"].ToString();
    var description = posted?["description"].ToString();
    var duration = posted?["duration"].ToString() is { Length: > 0 } d ? d : "30";
    var chosen = posted is null ? new HashSet<string>() : posted["permissions"].Where(p => p is not null).Select(p => p!).ToHashSet();
    var groups = permissions.GroupBy(p => p.Split('.')[0]).ToList();
    var durations = new[] { ("7", T["7 days"]), ("30", T["30 days"]), ("90", T["90 days"]), ("unlimited", T["No expiry"]) };
}

<form method="post" asp-action="Create" class="dnf-form">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />

    <section class="dnf-card" aria-labelledby="details-title">
        <div class="dnf-card__header"><h2 class="dnf-card__title" id="details-title">@T["Details"]</h2></div>
        <div class="dnf-card__body dnf-form">
            <div class="dnf-field">
                <label class="dnf-field__label" for="name">@T["Name"]<span class="dnf-field__required" aria-hidden="true">*</span></label>
                <input id="name" class="dnf-input" name="name" required maxlength="200" value="@name" placeholder="@T["Marketing website"]" autocomplete="off" />
            </div>
            <div class="dnf-field">
                <label class="dnf-field__label" for="description">@T["Description"]<span class="dnf-field__optional">@T["optional"]</span></label>
                <input id="description" class="dnf-input" name="description" value="@description" placeholder="@T["What uses this token?"]" />
            </div>
            <fieldset class="dnf-fieldset">
                <legend class="dnf-fieldset__legend">@T["Expires after"]</legend>
                <div class="dnf-choice-cards">
                    @foreach (var (value, label) in durations)
                    {
                        <label class="dnf-choice-card">
                            <input class="dnf-radio" type="radio" name="duration" value="@value" checked="@(value == duration ? "checked" : null)" />
                            <span>@label</span>
                        </label>
                    }
                </div>
            </fieldset>
        </div>
    </section>

    <section class="dnf-card" aria-labelledby="scopes-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="scopes-title">@T["Permissions"]<span class="dnf-field__required" aria-hidden="true">*</span></h2>
                <p class="dnf-card__description">@T["Grant only what the app needs. Requests outside these scopes are refused."]</p>
            </div>
        </div>
        <div class="dnf-card__body">
            <div class="dnf-permission-groups">
                @foreach (var group in groups)
                {
                    <fieldset class="dnf-fieldset dnf-permission-group">
                        <legend class="dnf-fieldset__legend dnf-permission-group__head">
                            <span>@T[PermissionKeys.GroupLabel(group.Key)]</span>
                        </legend>
                        <label class="dnf-check text-sm text-muted" data-js-only hidden>
                            <input class="dnf-checkbox" type="checkbox" data-check-group="@group.Key" /> @T["All of {0}", T[PermissionKeys.GroupLabel(group.Key)]]
                        </label>
                        @foreach (var permission in group)
                        {
                            <label class="dnf-check">
                                <input class="dnf-checkbox" type="checkbox" name="permissions" value="@permission" data-check-member="@group.Key"
                                       checked="@(chosen.Contains(permission) ? "checked" : null)" />
                                <code>@permission</code>
                            </label>
                        }
                    </fieldset>
                }
            </div>
        </div>
        <div class="dnf-card__footer">
            <a class="dnf-button dnf-button--ghost" href="/admin/api-tokens">@T["Cancel"]</a>
            <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="key" /> @T["Generate token"]</button>
        </div>
    </section>
</form>
