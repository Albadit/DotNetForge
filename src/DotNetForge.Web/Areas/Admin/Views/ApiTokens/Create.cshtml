@using DotNetForge.Shared.Constants
@{
    ViewData["PageWidth"] = "narrow";
    ViewData["Title"] = "Create API token";
    ViewData["Description"] = "Give the token a name you'll recognise, choose how long it lives and what it may do.";
    var permissions = ViewBag.Permissions as IReadOnlyList<string> ?? Array.Empty<string>();

    // After a validation error the view is shown again: keep what was entered.
    var posted = Context.Request.HasFormContentType ? Context.Request.Form : null;
    var name = posted?["name"].ToString();
    var description = posted?["description"].ToString();
    var duration = posted?["duration"].ToString() is { Length: > 0 } d ? d : "30";
    var chosen = posted is null ? new HashSet<string>() : posted["permissions"].Where(p => p is not null).Select(p => p!).ToHashSet();
    var groups = permissions.GroupBy(p => p.Split('.')[0]).ToList();
    var durations = new[] { ("7", "7 days"), ("30", "30 days"), ("90", "90 days"), ("unlimited", "No expiry") };
}

<form method="post" asp-action="Create" class="dnf-form">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />

    <section class="dnf-card" aria-labelledby="details-title">
        <div class="dnf-card__header"><h2 class="dnf-card__title" id="details-title">Details</h2></div>
        <div class="dnf-card__body dnf-form">
            <div class="dnf-field">
                <label class="dnf-field__label" for="name">Name<span class="dnf-field__required" aria-hidden="true">*</span></label>
                <input id="name" class="dnf-input" name="name" required maxlength="200" value="@name" placeholder="Marketing website" autocomplete="off" />
            </div>
            <div class="dnf-field">
                <label class="dnf-field__label" for="description">Description<span class="dnf-field__optional">optional</span></label>
                <input id="description" class="dnf-input" name="description" value="@description" placeholder="What uses this token?" />
            </div>
            <fieldset class="dnf-fieldset">
                <legend class="dnf-fieldset__legend">Expires after</legend>
                <div class="dnf-choice-cards">
                    @foreach (var (value, label) in durations)
                    {
                        <label class="dnf-choice-card">
                            <input class="dnf-radio" type="radio" name="duration" value="@value" checked="@(value == duration ? "checked" : null)" />
                            <span>@label</span>
                        </label>
                    }
                </div>
            </fieldset>
        </div>
    </section>

    <section class="dnf-card" aria-labelledby="scopes-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="scopes-title">Permissions<span class="dnf-field__required" aria-hidden="true">*</span></h2>
                <p class="dnf-card__description">Grant only what the app needs. Requests outside these scopes are refused.</p>
            </div>
        </div>
        <div class="dnf-card__body">
            <div class="dnf-permission-groups">
                @foreach (var group in groups)
                {
                    <fieldset class="dnf-fieldset dnf-permission-group">
                        <legend class="dnf-fieldset__legend dnf-permission-group__head">
                            <span>@PermissionKeys.GroupLabel(group.Key)</span>
                        </legend>
                        <label class="dnf-check text-sm text-muted" data-js-only hidden>
                            <input class="dnf-checkbox" type="checkbox" data-check-group="@group.Key" /> All of @PermissionKeys.GroupLabel(group.Key)
                        </label>
                        @foreach (var permission in group)
                        {
                            <label class="dnf-check">
                                <input class="dnf-checkbox" type="checkbox" name="permissions" value="@permission" data-check-member="@group.Key"
                                       checked="@(chosen.Contains(permission) ? "checked" : null)" />
                                <code>@permission</code>
                            </label>
                        }
                    </fieldset>
                }
            </div>
        </div>
        <div class="dnf-card__footer">
            <a class="dnf-button dnf-button--ghost" href="/admin/api-tokens">Cancel</a>
            <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="key" /> Generate token</button>
        </div>
    </section>
</form>
