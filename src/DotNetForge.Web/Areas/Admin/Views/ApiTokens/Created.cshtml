@model CreatedTokenViewModel
@{
    ViewData["Title"] = "Token created";
    ViewData["Description"] = $"'{Model.Name}' is ready to use.";
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var apiBaseUrl = $"{origin}/api";
    var exampleUrl = $"{origin}/api/content/pages";
}

<div class="stack-lg form-narrow">
    <alert tone="Warning" title="Copy the token now">
        This is the only time it is shown. Only a hash is stored, so it can't be displayed again - if you lose it, revoke it
        and create a new one.
    </alert>

    <section class="card card-accent" aria-labelledby="token-title">
        <div class="card-header"><h2 class="card-title" id="token-title">Your token</h2></div>
        <div class="card-body">
            <pre class="code-block" id="token-value">@Model.Plaintext<button type="button" class="btn btn-secondary btn-sm" data-copy-target="#token-text" data-js-only hidden><icon name="copy" size="sm" /> Copy</button></pre>
            <span id="token-text" hidden>@Model.Plaintext</span>
        </div>
    </section>

    <section class="card" aria-labelledby="usage-title">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="usage-title">How to use it</h2>
                <p class="card-description">Send it in an <code>Authorization: Bearer</code> header.</p>
            </div>
        </div>
        <div class="card-body stack">
            <dl class="dl">
                <dt>API URL</dt>
                <dd><a href="@apiBaseUrl" target="_blank" rel="noopener"><code>@apiBaseUrl</code></a></dd>
            </dl>
            <div class="stack-sm">
                <span class="field-label">Example request</span>
                <pre class="code-block">curl -H "Authorization: Bearer @Model.Plaintext" @exampleUrl<button type="button" class="btn btn-secondary btn-sm" data-copy-target="#curl-text" data-js-only hidden><icon name="copy" size="sm" /> Copy</button></pre>
                <span id="curl-text" hidden>curl -H "Authorization: Bearer @Model.Plaintext" @exampleUrl</span>
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-primary" href="/admin/api-tokens">Done</a>
        </div>
    </section>
</div>
