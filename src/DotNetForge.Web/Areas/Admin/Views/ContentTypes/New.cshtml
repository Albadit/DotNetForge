@using DotNetForge.Core.Content
@using DotNetForge.Shared.Enums
@{
    ViewData["Title"] = T["New content type"];
    ViewData["Description"] = T["Name it and choose where to start. Every field of a template can be changed afterwards."];
    ViewData["PageWidth"] = "medium";
    var chosen = Context.Request.HasFormContentType ? Context.Request.Form["template"].ToString() : string.Empty;
    var name = Context.Request.HasFormContentType ? Context.Request.Form["name"].ToString() : string.Empty;
}

<form method="post" action="/admin/content-types/create" class="dnf-form" novalidate>
    @Html.AntiForgeryToken()
    <dnf-validation-summary />

    <section class="dnf-card" aria-labelledby="start-title">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="start-title">@T["Start from"]</h2>
                <p class="dnf-card__description">@T["A template creates the fields for you - and the types it links to (a blog also gets categories and authors)."]</p>
            </div>
        </div>
        <div class="dnf-card__body">
            <div class="dnf-choice-cards dnf-choice-cards--wide" role="radiogroup" aria-labelledby="start-title">
                <label class="dnf-choice-card dnf-choice-card--detailed">
                    <input type="radio" class="dnf-radio" name="template" value="" checked="@(chosen.Length == 0 ? "checked" : null)" />
                    <span class="dnf-type-icon" aria-hidden="true"><dnf-icon name="plus" /></span>
                    <span class="dnf-choice-card__text">
                        <strong class="dnf-choice-card__title">@T["Blank"]</strong>
                        <span class="dnf-choice-card__description">@T["A title field to start with; add your own."]</span>
                    </span>
                </label>
                @foreach (var template in ContentTypeTemplates.All)
                {
                    <label class="dnf-choice-card dnf-choice-card--detailed">
                        <input type="radio" class="dnf-radio" name="template" value="@template.Id" checked="@(chosen == template.Id ? "checked" : null)" />
                        <span class="dnf-type-icon" aria-hidden="true"><dnf-icon name="@template.Icon" /></span>
                        <span class="dnf-choice-card__text">
                            <strong class="dnf-choice-card__title">@T[template.Name] @if (template.Kind == ContentTypeKind.Single) { <dnf-badge tone="Info">@T["Single"]</dnf-badge> }</strong>
                            <span class="dnf-choice-card__description">@T[template.Description]</span>
                        </span>
                    </label>
                }
            </div>
        </div>
    </section>

    <section class="dnf-card" aria-labelledby="name-title">
        <div class="dnf-card__header"><h2 class="dnf-card__title" id="name-title">@T["Name"]</h2></div>
        <div class="dnf-card__body">
            <div class="dnf-field">
                <label class="dnf-field__label" for="name">@T["Name"]<span class="dnf-field__optional">@T["optional with a template"]</span></label>
                <input id="name" name="name" class="dnf-input" value="@name" maxlength="100" placeholder="@T["e.g. Blog posts, Products, Team members"]" aria-describedby="name-hint" />
                <span class="dnf-field__description" id="name-hint">@T["Plural for a collection (\"Products\"). The API id is made from it; you can change both later."]</span>
            </div>
        </div>
        <div class="dnf-card__footer dnf-form-actions dnf-form-actions--end">
            <a class="dnf-button dnf-button--ghost" href="/admin/content-types">@T["Cancel"]</a>
            <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="plus" /> @T["Create content type"]</button>
        </div>
    </section>
</form>
