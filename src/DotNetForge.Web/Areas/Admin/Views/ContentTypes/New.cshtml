@using DotNetForge.Core.Content
@using DotNetForge.Shared.Enums
@{
    ViewData["Title"] = "New content type";
    ViewData["Description"] = "Name it and choose where to start. Every field of a template can be changed afterwards.";
    ViewData["PageWidth"] = "medium";
    var chosen = Context.Request.HasFormContentType ? Context.Request.Form["template"].ToString() : string.Empty;
    var name = Context.Request.HasFormContentType ? Context.Request.Form["name"].ToString() : string.Empty;
}

<form method="post" action="/admin/content-types/create" class="form stack-lg" novalidate>
    @Html.AntiForgeryToken()
    <form-errors />

    <section class="card" aria-labelledby="start-title">
        <div class="card-header">
            <div>
                <h2 class="card-title" id="start-title">Start from</h2>
                <p class="card-description">A template creates the fields for you - and the types it links to (a blog also gets categories and authors).</p>
            </div>
        </div>
        <div class="card-body">
            <div class="template-grid" role="radiogroup" aria-labelledby="start-title">
                <label class="template-card">
                    <input type="radio" name="template" value="" checked="@(chosen.Length == 0 ? "checked" : null)" />
                    <span class="type-icon" aria-hidden="true"><icon name="plus" /></span>
                    <span class="template-text">
                        <strong>Blank</strong>
                        <span>A title field to start with; add your own.</span>
                    </span>
                </label>
                @foreach (var template in ContentTypeTemplates.All)
                {
                    <label class="template-card">
                        <input type="radio" name="template" value="@template.Id" checked="@(chosen == template.Id ? "checked" : null)" />
                        <span class="type-icon" aria-hidden="true"><icon name="@template.Icon" /></span>
                        <span class="template-text">
                            <strong>@template.Name @if (template.Kind == ContentTypeKind.Single) { <badge tone="Info">Single</badge> }</strong>
                            <span>@template.Description</span>
                        </span>
                    </label>
                }
            </div>
        </div>
    </section>

    <section class="card" aria-labelledby="name-title">
        <div class="card-header"><h2 class="card-title" id="name-title">Name</h2></div>
        <div class="card-body">
            <div class="field">
                <label class="field-label" for="name">Name<span class="field-optional">optional with a template</span></label>
                <input id="name" name="name" value="@name" maxlength="100" placeholder="e.g. Blog posts, Products, Team members" aria-describedby="name-hint" />
                <span class="field-hint" id="name-hint">Plural for a collection ("Products"). The API id is made from it; you can change both later.</span>
            </div>
        </div>
        <div class="card-footer form-actions end">
            <a class="btn btn-ghost" href="/admin/content-types">Cancel</a>
            <button type="submit" class="btn btn-primary"><icon name="plus" /> Create content type</button>
        </div>
    </section>
</form>
