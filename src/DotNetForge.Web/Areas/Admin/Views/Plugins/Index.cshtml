@model List<PluginRowViewModel>
@{
    ViewData["Title"] = "Plugins";
    ViewData["Description"] = "Extensions found in the extensions/ folder. Nothing an extension offers is used until you enable it; enabling and disabling take effect at once. Code changes need a restart.";
    var enabledCount = Model.Count(e => e.IsEnabled);
    var problemCount = Model.Count(e => e.Problem is not null);
    var types = Model.Select(e => e.Type).Where(t => t != "-").Distinct().Order().ToList();

    static string TypeIcon(string type) => type switch
    {
        "theme" => "palette",
        "authentication" => "log-in",
        "connector" => "plug",
        "library" => "package",
        "admin" => "panel",
        "widget" => "gauge",
        "provider" => "bell",
        "module" => "box",
        _ => "puzzle",
    };
    string State(PluginRowViewModel e) => e.IsEnabled ? "enabled" : "disabled";
}

<section class="dnf-card" aria-labelledby="extensions-title" data-collection>
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="extensions-title">Extensions</h2>
            <p class="dnf-card__description" data-collection-count>@Model.Count total</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <dnf-empty-state icon="puzzle" title="No extensions found" description="Put an extension folder with a dotnetforge.extension.json manifest under extensions/ and it appears here." />
    }
    else
    {
        <div class="dnf-toolbar" data-js-only hidden>
            <div class="dnf-segmented" role="group" aria-label="Filter by status">
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="" aria-pressed="true">All <span class="text-subtle">@Model.Count</span></button>
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="enabled" aria-pressed="false">Enabled <span class="text-subtle">@enabledCount</span></button>
                <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="disabled" aria-pressed="false">Disabled <span class="text-subtle">@(Model.Count - enabledCount)</span></button>
                @if (problemCount > 0)
                {
                    <button type="button" class="dnf-segmented__item" data-collection-filter="state" data-value="problem" aria-pressed="false">Needs attention <span class="text-subtle">@problemCount</span></button>
                }
            </div>
            <span class="dnf-toolbar__spacer"></span>
            <div class="dnf-toolbar__search dnf-input-group">
                <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                <label class="sr-only" for="extension-search">Search extensions</label>
                <input id="extension-search" type="search" class="dnf-input dnf-input--sm" placeholder="Search extensions" data-collection-search />
            </div>
            <label class="sr-only" for="extension-type">Type</label>
            <select id="extension-type" class="dnf-select dnf-select--sm" data-collection-filter="type">
                <option value="">All types</option>
                @foreach (var type in types)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>

        <div class="dnf-extension-list">
            @foreach (var ext in Model)
            {
                <article class="dnf-extension-card" data-enabled="@(ext.IsEnabled ? "true" : "false")" data-item data-type="@ext.Type"
                         data-state="@State(ext)@(ext.Problem is not null ? " problem" : null)" aria-labelledby="ext-@ext.Id">
                    <div class="dnf-extension-card__head">
                        <span class="dnf-extension-card__icon" aria-hidden="true"><dnf-icon name="@TypeIcon(ext.Type)" /></span>
                        <div class="grow min-w-0">
                            <div class="dnf-cluster">
                                <h3 class="dnf-extension-card__name" id="ext-@ext.Id">@ext.Name</h3>
                                <span class="text-xs text-subtle">v@(ext.Version)</span>
                                @if (ext.Problem is not null)
                                {
                                    @* The problem stays out of the card: an icon next to the name opens it (a dnf-popover, placed by dnf.js). *@
                                    var problemId = "problem-" + System.Text.RegularExpressions.Regex.Replace(ext.Id, "[^A-Za-z0-9]", "-");
                                    var problemTitle = ext.ValidManifest ? "Not running" : "Invalid manifest";
                                    <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm dnf-extension-card__problem-button" data-tone="@(ext.ValidManifest ? "warning" : "danger")"
                                            popovertarget="@problemId" aria-haspopup="dialog" aria-expanded="false"
                                            aria-label="@problemTitle - show why" data-tooltip="@problemTitle">
                                        <dnf-icon name="@(ext.ValidManifest ? "triangle-alert" : "circle-x")" />
                                    </button>
                                    <div class="dnf-popover dnf-popover--bare" id="@problemId" popover role="dialog" aria-label="@problemTitle" data-placement="bottom-start">
                                        <dnf-alert tone="@(ext.ValidManifest ? DnfTone.Warning : DnfTone.Danger)" title="@problemTitle">@ext.Problem</dnf-alert>
                                    </div>
                                }
                            </div>
                            <div class="text-xs text-muted truncate" title="@ext.Id · extensions/@ext.Folder">@ext.Id</div>
                        </div>
                        @if (ext.IsEnabled)
                        {
                            <dnf-badge tone="Success" dot="true">Enabled</dnf-badge>
                        }
                        else
                        {
                            <dnf-badge dot="true">Disabled</dnf-badge>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(ext.Description))
                    {
                        <p class="text-muted dnf-extension-card__description">@ext.Description</p>
                    }

                    <div class="dnf-cluster dnf-extension-card__badges">
                        <dnf-badge tone="Primary">@ext.Type</dnf-badge>
                        @if (ext.HasCode)
                        {
                            <dnf-badge><dnf-icon name="code" size="Sm" /> Code</dnf-badge>
                        }
                        @foreach (var dependency in ext.Dependencies)
                        {
                            <dnf-badge outline="true" title="Needs @dependency"><dnf-icon name="link" size="Sm" /> @dependency</dnf-badge>
                        }
                    </div>

                    <div class="dnf-extension-card__foot">
                        <span class="text-xs text-muted">by @ext.Author</span>
                        @if (ext.CanToggle && ext.IsEnabled)
                        {
                            <form method="post" action="/admin/plugins/@Uri.EscapeDataString(ext.Id)/disable" class="inline"
                                  data-confirm="Disable '@ext.Name'? Everything it adds stops working until you enable it again."
                                  data-confirm-title="Disable extension" data-confirm-action="Disable">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dnf-button dnf-button--secondary dnf-button--sm"><dnf-icon name="power" size="Sm" /> Disable</button>
                            </form>
                        }
                        else if (ext.CanToggle && ext.Problem is null)
                        {
                            <form method="post" action="/admin/plugins/@Uri.EscapeDataString(ext.Id)/enable" class="inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dnf-button dnf-button--primary dnf-button--sm"><dnf-icon name="power" size="Sm" /> Enable</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
        <dnf-empty-state icon="search" title="No matching extensions" description="Try another search or filter." compact="true" data-collection-empty hidden />
    }
</section>
