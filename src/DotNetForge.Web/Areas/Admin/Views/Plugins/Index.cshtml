@model List<PluginRowViewModel>
@{
    ViewData["Title"] = "Plugins";
}

<p class="muted">Installed extensions and extensions discovered under the <code>extensions/</code> folder.
    Invalid manifests are flagged and never loaded.</p>

<table class="data">
    <thead>
        <tr><th>Name</th><th>Version</th><th>Type</th><th>Status</th><th>Author</th><th>Manifest</th><th>Source</th></tr>
    </thead>
    <tbody>
    @foreach (var ext in Model)
    {
        <tr>
            <td><strong>@ext.Name</strong><br /><span class="muted">@ext.Id</span></td>
            <td>@ext.Version</td>
            <td>@ext.Type</td>
            <td>@ext.Status</td>
            <td>@ext.Author</td>
            <td>
                @if (ext.ValidManifest)
                {
                    <span class="badge ok">valid</span>
                }
                else
                {
                    <span class="badge warn">invalid</span>
                }
            </td>
            <td class="muted">@ext.Source</td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="7" class="muted">No extensions found.</td></tr>
    }
    </tbody>
</table>
