@model ContentIndexViewModel
@{
    ViewData["Title"] = "Pages";
    ViewData["Description"] = "Build the site's page tree, then edit each page's URL, SEO, publishing and layout. Structured content lives in the Content Manager.";
    ViewData["SelectedId"] = Model.SelectedId;
    var pageCount = CountPages(Model.Tree);

    static int CountPages(IReadOnlyList<PageTreeNode> nodes) => nodes.Sum(n => 1 + CountPages(n.Children));

    static IEnumerable<MoveTarget> MoveTargets(IReadOnlyList<PageTreeNode> nodes, int depth, IReadOnlyList<Guid> above) =>
        nodes.Where(n => !DotNetForge.Web.Services.PageService.IsHome(n.Slug)).SelectMany(n => MoveTargets(n.Children, depth + 1, above.Append(n.Id).ToList())
            .Prepend(new MoveTarget(n.Id, n.Title, "/" + n.Slug.TrimStart('/'), depth, above)));
}

@section Actions {
    @* One shared form: the header button and every "add child" button in the tree submit it via formaction (POST + antiforgery). *@
    <form id="treeActions" method="post" class="inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="dnf-button dnf-button--primary" formaction="/admin/pages/create"><dnf-icon name="plus" /> New page</button>
    </form>
}

<div class="dnf-content-manager">
    <aside class="dnf-card dnf-content-manager__tree" aria-labelledby="tree-title">
        <div class="dnf-card__header">
            <h2 class="dnf-card__title" id="tree-title">Pages</h2>
            <div class="flex items-center gap-1">
                @* Close / open every page with children at once (pages.js). *@
                <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm dnf-button--icon-only" data-tree-collapse-all data-js-only hidden
                        aria-label="Close all pages" data-tooltip="Close all">
                    <dnf-icon name="chevrons-down-up" size="Sm" />
                </button>
                <dnf-badge>@pageCount</dnf-badge>
            </div>
        </div>
        @if (pageCount > 0)
        {
            <div class="dnf-content-manager__search" data-js-only hidden>
                <label class="sr-only" for="tree-filter">Filter pages</label>
                <div class="dnf-input-group">
                    <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                    <input id="tree-filter" type="search" class="dnf-input dnf-input--sm" placeholder="Filter pages" autocomplete="off" data-tree-filter />
                </div>
            </div>
        }
        <div class="dnf-card__body">
            @if (Model.Tree.Count == 0)
            {
                <dnf-empty-state icon="pages" title="No pages yet" description="Create the first page of your site." compact="true">
                    <button type="submit" class="dnf-button dnf-button--primary dnf-button--sm" form="treeActions" formaction="/admin/pages/create"><dnf-icon name="plus" size="Sm" /> New page</button>
                </dnf-empty-state>
            }
            else
            {
                <partial name="_TreeNodes" model="Model.Tree" />
                <p class="text-xs text-muted" data-tree-empty hidden>No page matches the filter.</p>
            }
        </div>
    </aside>

    <section aria-label="Page editor">
        @if (Model.Selected is null)
        {
            <div class="dnf-card">
                <dnf-empty-state icon="pencil" title="Select a page to edit" description="Choose a page in the tree, or create a new one. Drag a page between two others, or onto one to put it inside; its child pages go with it." />
            </div>
        }
        else
        {
            ViewData["ParentOptions"] = Model.ParentOptions;
            ViewData["Extras"] = Model.Extras;
            <partial name="_PageForm" model="Model.Selected" />
        }
    </section>
</div>

@if (ViewData["CanReorder"] as bool? == true && pageCount > 0)
{
    @* Move… in a page's menu opens this (pages.js sets the form's action). *@
    <form id="page-move" method="post">@Html.AntiForgeryToken()</form>
    <partial name="_MoveDialog" model="@(new MoveDialogModel("page-move-dialog", "Move page", "parentId", "page-move", null, "pages", MoveTargets(Model.Tree, 0, Array.Empty<Guid>()).ToList()))" />
}

@section Scripts {
    <script src="~/js/admin/move-dialog.js" asp-append-version="true" defer></script>
    <script src="~/js/admin/pages.js" asp-append-version="true" defer></script>
}
