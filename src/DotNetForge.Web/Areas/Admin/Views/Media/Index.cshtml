@using DotNetForge.Web.Services
@using DotNetForge.Shared.Enums
@model MediaIndexViewModel
@{
    ViewData["Title"] = "Media";
    ViewData["Description"] = "Images, documents and other files for your pages. Public files are reachable by anyone with the link.";
    var accept = string.Join(",", MediaService.AllowedTypes.Keys);
    string Extensions(MediaKind kind) => string.Join(",", MediaService.AllowedTypes.Where(t => MediaSettings.KindOf(t.Value) == kind).Select(t => t.Key));
    static long Mb(int mb) => mb * 1024L * 1024;
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    // Folders are selectable too: moved with Media update, deleted (when empty) with Media delete.
    var foldersSelectable = Model.Folders.Count > 0 && (Model.CanEditFolders || Model.CanDeleteFolders);
    var anyDeletable = Model.Files.Any(f => f.CanDelete) || (Model.Folders.Count > 0 && Model.CanDeleteFolders);
    var anySelectable = Model.Files.Any(f => f.CanDelete || f.CanEdit) || foldersSelectable;
    var anyMovable = Model.Files.Any(f => f.CanEdit) || (Model.Folders.Count > 0 && Model.CanEditFolders);
    var here = Model.Current?.Id;
    var empty = Model.Files.Count == 0 && Model.Folders.Count == 0;
    static string Count(int n, string noun) => n == 1 ? $"1 {noun}" : $"{n} {noun}s";
    var anyRenamable = Model.Files.Any(f => f.CanEdit);
    // Info (media.js fills #file-info-dialog from it; the text is set as text, never as HTML).
    string Info(MediaRowViewModel file)
    {
        var saved = file.OriginalSizeBytes is > 0 and var before && before > file.SizeBytes
            ? $" - optimized from {MediaPresentation.Size(before)}, {(int)Math.Round(100 - file.SizeBytes * 100d / before)}% smaller"
            : null;
        return System.Text.Json.JsonSerializer.Serialize(new[]
        {
            new[] { "Name", file.FileName },
            new[] { "Uploaded as", string.IsNullOrEmpty(file.OriginalName) || file.OriginalName == file.FileName ? null : file.OriginalName },
            new[] { "Type", file.ContentType },
            new[] { "Size", MediaPresentation.Size(file.SizeBytes) + saved },
            new[] { "Access", file.IsPublic ? "Public - anyone with the link can open it" : "Private - only signed-in admin users can open it" },
            new[] { "Folder", Model.Current is null ? "Root" : "Library" + Model.Current.Path },
            new[] { "Uploaded", DnfTimestampTagHelper.Format(file.UploadedDate) + (file.UploadedBy is null ? null : " by " + file.UploadedBy) },
            new[] { "Link", origin + file.Url },
            new[] { "Id", file.Id.ToString() },
        }.Where(row => row[1] is not null));
    }
}

@section Actions {
    @if (Model.CanUpload)
    {
        <button type="button" class="dnf-button dnf-button--secondary" data-folder-new aria-controls="new-folder-dialog"><dnf-icon name="folder" /> New folder</button>
        <button type="button" class="dnf-button dnf-button--primary" data-upload-toggle aria-controls="upload"><dnf-icon name="upload" /> Upload</button>
    }
}

<div class="dnf-stack dnf-stack--lg">
    <section class="dnf-card" aria-labelledby="library-title" data-collection data-page-size="48">
        <div class="dnf-card__header">
            <div>
                <h2 class="dnf-card__title" id="library-title">
                    <nav class="dnf-folder-crumbs" aria-label="Folder">
                        @if (Model.Current is null)
                        {
                            <span aria-current="page">Library</span>
                        }
                        else
                        {
                            <a class="dnf-folder-crumbs__link" href="/admin/media" data-drop-folder="">Library</a>
                            @foreach (var crumb in Model.Breadcrumbs)
                            {
                                <span class="dnf-folder-crumbs__sep" aria-hidden="true">/</span>
                                @if (crumb.Id == here)
                                {
                                    <span aria-current="page">@crumb.Name</span>
                                }
                                else
                                {
                                    <a class="dnf-folder-crumbs__link" href="/admin/media?folder=@crumb.Id" data-drop-folder="@crumb.Id">@crumb.Name</a>
                                }
                            }
                        }
                    </nav>
                </h2>
                <p class="dnf-card__description" data-collection-count>@Count(Model.Folders.Count, "folder") · @Count(Model.Files.Count, "file")</p>
            </div>
            @if (!empty)
            {
                <div class="dnf-segmented" role="group" aria-label="Layout" data-view-switch="media" data-view-target="#media-items" data-default="grid" data-js-only hidden>
                    <button type="button" class="dnf-segmented__item" data-view-button="grid" aria-pressed="true" aria-label="Grid view"><dnf-icon name="grid" size="Sm" /></button>
                    <button type="button" class="dnf-segmented__item" data-view-button="list" aria-pressed="false" aria-label="List view"><dnf-icon name="list" size="Sm" /></button>
                </div>
            }
        </div>

        @if (empty)
        {
            @if (Model.Current is null)
            {
                <dnf-empty-state icon="image" title="No media yet" description="Uploaded files appear here, ready to use on your pages." />
            }
            else
            {
                <dnf-empty-state icon="folder" title="This folder is empty" description="Upload files into it, move files here, or create a folder inside it." />
            }
        }
        else
        {
            <div class="dnf-collection-bar">
            <div class="dnf-toolbar" data-js-only hidden>
                @if (anySelectable)
                {
                    <label class="dnf-check" aria-label="Select all"><input type="checkbox" class="dnf-checkbox" data-select-all /></label>
                }
                <div class="dnf-toolbar__search dnf-input-group">
                    <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                    <label class="sr-only" for="media-search">Search files</label>
                    <input id="media-search" type="search" class="dnf-input" placeholder="Search files" data-collection-search />
                </div>
                <label class="sr-only" for="media-kind">File type</label>
                <select id="media-kind" class="dnf-select" data-collection-filter="kind">
                    <option value="">All types</option>
                    <option value="image">Images</option>
                    <option value="video">Video</option>
                    <option value="audio">Audio</option>
                    <option value="document">Documents</option>
                    <option value="archive">Archives</option>
                </select>
                <label class="sr-only" for="media-access">Access</label>
                <select id="media-access" class="dnf-select" data-collection-filter="access">
                    <option value="">Public and private</option>
                    <option value="public">Public</option>
                    <option value="private">Private</option>
                </select>
            </div>

            @if (anySelectable)
            {
                <form method="post" action="/admin/media/delete-selected" id="bulkForm" class="dnf-bulk-bar" data-bulk-bar hidden>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnFolder" value="@here" />
                    <label class="dnf-check" aria-label="Select all"><input type="checkbox" class="dnf-checkbox" data-select-all /></label>
                    <span class="dnf-bulk-bar__count" data-bulk-count>0 selected</span>
                    <span class="flex-auto"></span>
                    <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm" data-bulk-clear>Clear</button>
                    @if (anyMovable)
                    {
                        <button type="button" class="dnf-button dnf-button--secondary dnf-button--sm" data-media-move aria-haspopup="dialog"><dnf-icon name="folder" size="Sm" /> Move…</button>
                    }
                    @if (anyDeletable)
                    {
                        <button type="submit" class="dnf-button dnf-button--danger dnf-button--sm"
                                data-confirm="Delete the selected items? Links to deleted files stop working; only empty folders can be deleted." data-confirm-title="Delete selected" data-confirm-action="Delete">
                            <dnf-icon name="trash" size="Sm" /> Delete selected
                        </button>
                    }
                </form>
            }
            </div>

            <div class="dnf-media-grid" id="media-items" data-view-mode="grid">
                @foreach (var folder in Model.Folders)
                {
                    var inside = string.Join(" · ", new[] { folder.Folders > 0 ? Count(folder.Folders, "folder") : null, Count(folder.Files, "file") }.OfType<string>());
                    <article class="dnf-media-card dnf-media-card--folder" data-item data-kind="folder" data-access="" data-search="@folder.Name"
                             data-drop-folder="@folder.Id" draggable="@(Model.CanEditFolders ? "true" : null)" data-drag-folder="@(Model.CanEditFolders ? (Guid?)folder.Id : null)">
                        @if (foldersSelectable)
                        {
                            <label class="dnf-media-card__select" aria-label="Select the folder @folder.Name">
                                <input type="checkbox" class="dnf-checkbox" name="folderIds" value="@folder.Id" form="bulkForm" data-select-item />
                            </label>
                        }
                        <a class="dnf-media-card__thumb" href="/admin/media?folder=@folder.Id" tabindex="-1" aria-hidden="true" draggable="false">
                            <dnf-icon name="folder" size="Xl" />
                        </a>
                        <div class="dnf-media-card__meta">
                            <a class="dnf-media-card__name" href="/admin/media?folder=@folder.Id" title="@folder.Name" draggable="false">@folder.Name</a>
                            <span class="text-xs text-muted">@inside</span>
                        </div>
                        @if (Model.CanEditFolders || Model.CanDeleteFolders)
                        {
                            <dnf-dropdown class="dnf-media-card__actions" variant="Secondary" label="Actions for the folder @folder.Name">
                                <dnf-dropdown-link href="/admin/media?folder=@folder.Id" icon="folder">Open</dnf-dropdown-link>
                                @if (Model.CanEditFolders)
                                {
                                    <dnf-dropdown-button icon="pencil" data-folder-edit="@folder.Id" data-folder-name="@folder.Name" data-folder-path="@folder.Path"
                                                 data-folder-parent="@here" data-js-only hidden>Edit…</dnf-dropdown-button>
                                    <dnf-dropdown-button icon="arrow-right" data-media-move-item="folderIds" data-move-id="@folder.Id" data-move-name="@folder.Name" data-js-only hidden>Move…</dnf-dropdown-button>
                                }
                                @if (Model.CanDeleteFolders)
                                {
                                    <dnf-dropdown-separator />
                                    <dnf-dropdown-post action="/admin/media/folders/@folder.Id/delete" icon="trash" danger="true"
                                               confirm="Delete the folder '@folder.Name'? Only an empty folder can be deleted." confirm-title="Delete folder" confirm-action="Delete folder">Delete</dnf-dropdown-post>
                                }
                            </dnf-dropdown>
                        }
                    </article>
                }
                @foreach (var file in Model.Files)
                {
                    var (kind, icon) = MediaPresentation.Classify(file.ContentType);
                    <article class="dnf-media-card" data-item data-kind="@kind" data-access="@(file.IsPublic ? "public" : "private")"
                             data-search="@file.FileName @file.ContentType"
                             data-preview="@file.Id" data-preview-url="@file.Url" data-preview-name="@file.FileName" data-preview-type="@file.ContentType"
                             data-preview-meta="@MediaPresentation.Size(file.SizeBytes) · @file.ContentType · @(file.IsPublic ? "Public" : "Private")" data-preview-link="@origin@file.Url"
                             draggable="@(file.CanEdit ? "true" : null)" data-drag-file="@(file.CanEdit ? (Guid?)file.Id : null)">
                        @if (file.CanDelete || file.CanEdit)
                        {
                            <label class="dnf-media-card__select" aria-label="Select @file.FileName">
                                <input type="checkbox" class="dnf-checkbox" name="ids" value="@file.Id" form="bulkForm" data-select-item />
                            </label>
                        }
                        <a class="dnf-media-card__thumb" href="@file.Url" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" draggable="false" data-preview-open>
                            @if (kind == "image")
                            {
                                <img src="@file.Url" alt="" loading="lazy" decoding="sync" draggable="false" />
                            }
                            else
                            {
                                <dnf-icon name="@icon" size="Xl" />
                            }
                        </a>
                        <div class="dnf-media-card__meta">
                            <a class="dnf-media-card__name" href="@file.Url" target="_blank" rel="noopener" title="@file.FileName" draggable="false" data-preview-open>@file.FileName</a>
                            <span class="text-xs text-muted">@MediaPresentation.Size(file.SizeBytes) · <dnf-timestamp value="@file.UploadedDate" /></span>
                            <span class="dnf-media-card__badges">
                                @if (file.IsPublic)
                                {
                                    <dnf-badge tone="Success">Public</dnf-badge>
                                }
                                else
                                {
                                    <dnf-badge tone="Warning"><dnf-icon name="lock" size="Sm" /> Private</dnf-badge>
                                }
                                @* Type and optimization savings are in Info. *@
                                @if (file.Optimization is MediaOptimization.Pending or MediaOptimization.Processing)
                                {
                                    <dnf-badge data-tooltip="The video is being compressed in the background">Optimizing…</dnf-badge>
                                }
                            </span>
                        </div>
                        <dnf-dropdown class="dnf-media-card__actions" variant="Secondary" label="Actions for @file.FileName">
                            <dnf-dropdown-button icon="eye" data-preview-open data-js-only hidden>Preview</dnf-dropdown-button>
                            <dnf-dropdown-link href="@file.Url" icon="external-link" new-tab="true">Open in new tab</dnf-dropdown-link>
                            <dnf-dropdown-button icon="link" data-copy-text="@origin@file.Url">Copy link</dnf-dropdown-button>
                            <dnf-dropdown-button icon="info" data-file-info="@Info(file)" data-js-only hidden>Info</dnf-dropdown-button>
                            @if (file.CanEdit)
                            {
                                <dnf-dropdown-button icon="pencil" data-file-rename="@file.Id" data-file-name="@System.IO.Path.GetFileNameWithoutExtension(file.FileName)"
                                             data-file-extension="@System.IO.Path.GetExtension(file.FileName)" data-js-only hidden>Rename…</dnf-dropdown-button>
                                <dnf-dropdown-button icon="arrow-right" data-media-move-item="ids" data-move-id="@file.Id" data-move-name="@file.FileName" data-js-only hidden>Move…</dnf-dropdown-button>
                                @if (file.IsPublic)
                                {
                                    <dnf-dropdown-post action="/admin/media/visibility/@file.Id" icon="lock" field-isPublic="false"
                                               confirm="Make '@file.FileName' private? Visitors can no longer open it - pages that show it display a broken image."
                                               confirm-title="Make file private" confirm-action="Make private" confirm-tone="primary">Make private</dnf-dropdown-post>
                                }
                                else
                                {
                                    <dnf-dropdown-post action="/admin/media/visibility/@file.Id" icon="globe" field-isPublic="true"
                                               confirm="Make '@file.FileName' public? Anyone with the link can open it."
                                               confirm-title="Make file public" confirm-action="Make public">Make public</dnf-dropdown-post>
                                }
                            }
                            @if (file.CanDelete)
                            {
                                <dnf-dropdown-separator />
                                <dnf-dropdown-post action="/admin/media/delete/@file.Id" icon="trash" danger="true"
                                           confirm="Delete '@file.FileName'? Links to it stop working." confirm-title="Delete file" confirm-action="Delete file">Delete</dnf-dropdown-post>
                            }
                        </dnf-dropdown>
                    </article>
                }
            </div>
            <dnf-empty-state icon="search" title="No matching files" description="Try another search or filter." compact="true" data-collection-empty hidden />
            <div class="dnf-pagination" data-collection-pagination hidden></div>
        }
    </section>
</div>

@if (Model.CanUpload)
{
    @* Upload (header), a file drag onto the page or #upload opens this; media.js shows it again after a failed upload. *@
    <dialog class="dnf-dialog dnf-dialog--lg dnf-dialog--bare" aria-labelledby="upload-title">
        <section class="dnf-card" id="upload" aria-labelledby="upload-title" data-upload-panel
                 data-upload-open="@(ViewData.ModelState.IsValid ? null : "true")"
                 data-max-image="@Mb(Model.Limits.MaxImageMb)" data-max-video="@Mb(Model.Limits.MaxVideoMb)" data-max-other="@Mb(Model.Limits.MaxOtherMb)"
                 data-image-types="@Extensions(MediaKind.Image)" data-video-types="@Extensions(MediaKind.Video)">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="upload-title">Upload</h2>
                    <p class="dnf-card__description">
                        Up to @MediaService.MaxFilesPerUpload files into <strong>@(Model.Current?.Path ?? "Root")</strong>:
                        images up to @Model.Limits.MaxImageMb MB, videos and audio up to @Model.Limits.MaxVideoMb MB, other files up to @Model.Limits.MaxOtherMb MB.
                        @if (Model.Limits.OptimizeImages)
                        {
                            <text>Images are optimized@(Model.Limits.ConvertToWebP ? " and stored as WebP" : null).</text>
                        }
                    </p>
                </div>
                <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-upload-close aria-label="Close upload" data-tooltip="Close">
                    <dnf-icon name="x" />
                </button>
            </div>
            <form method="post" asp-area="Admin" asp-controller="Media" asp-action="Upload" enctype="multipart/form-data" class="dnf-card__body dnf-stack">
                @Html.AntiForgeryToken()
                <input type="hidden" name="folderId" value="@here" />
                <dnf-validation-summary />
                <div class="dnf-file-upload">
                    <dnf-icon name="upload" size="Xl" />
                    <span class="dnf-file-upload__title">Drop files here or click to choose</span>
                    <span class="text-sm">@string.Join(" · ", MediaService.AllowedTypes.Keys)</span>
                    <label class="sr-only" for="files">Files to upload</label>
                    <input id="files" name="files" type="file" class="dnf-file-upload__input" multiple required accept="@accept" />
                </div>
                <ul class="dnf-upload-preview" data-upload-preview aria-label="Files to upload" hidden></ul>
                <template id="upload-icons">
                    <dnf-icon name="file" size="Xl" data-icon="file" />
                    <dnf-icon name="x" size="Sm" data-icon="remove" />
                </template>
                <div class="dnf-spread">
                    <label class="dnf-check">
                        <input type="checkbox" class="dnf-checkbox" name="isPublic" value="true" checked />
                        <span class="dnf-check__text"><span>Public</span><span class="dnf-check__description">Anyone with the link can open it. Private files need an admin sign-in.</span></span>
                    </label>
                    <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="upload" /> Upload</button>
                </div>
            </form>
        </section>
    </dialog>

    @* New folder (header) opens this. *@
    <dialog class="dnf-dialog dnf-dialog--md" id="new-folder-dialog" aria-labelledby="new-folder-title">
        <div class="dnf-dialog__header">
            <div>
                <h2 class="dnf-dialog__title" id="new-folder-title">New folder</h2>
                <p class="dnf-dialog__description">In Library@(Model.Current?.Path)</p>
            </div>
        </div>
        <div class="dnf-dialog__body">
            <form method="post" action="/admin/media/folders" id="folder-create" class="dnf-field">
                @Html.AntiForgeryToken()
                <input type="hidden" name="parentId" value="@here" />
                <label class="dnf-field__label" for="new-folder">Name</label>
                <input id="new-folder" name="name" class="dnf-input" required maxlength="@MediaFolderService.MaxNameLength" placeholder="New folder" autofocus />
            </form>
        </div>
        <form method="dialog" class="dnf-dialog__footer">
            <button type="submit" class="dnf-button dnf-button--secondary">Cancel</button>
            <button type="submit" class="dnf-button dnf-button--primary" form="folder-create"><dnf-icon name="folder" /> Create folder</button>
        </form>
    </dialog>
}

@if (Model.CanEditFolders)
{
    @* Edit… in a folder's menu opens this (media.js fills in the folder); without JavaScript the folder's own page has the same forms. *@
    <dialog class="dnf-dialog dnf-dialog--md" id="folder-dialog" aria-labelledby="folder-dialog-title">
        <div class="dnf-dialog__header">
            <h2 class="dnf-dialog__title" id="folder-dialog-title">Edit folder</h2>
        </div>
        <div class="dnf-dialog__body">
            <form method="post" data-folder-rename class="dnf-field">
                @Html.AntiForgeryToken()
                <label class="dnf-field__label" for="folder-dialog-name">Name</label>
                <div class="dnf-form-actions flex-nowrap">
                    <input id="folder-dialog-name" name="name" required maxlength="@MediaFolderService.MaxNameLength" class="dnf-input grow min-w-0" />
                    <button type="submit" class="dnf-button dnf-button--primary">Rename</button>
                </div>
            </form>
            <form method="post" data-folder-move class="dnf-field">
                @Html.AntiForgeryToken()
                <label class="dnf-field__label" for="folder-dialog-parent">Move into</label>
                <div class="dnf-form-actions flex-nowrap">
                    <select id="folder-dialog-parent" name="parentId" class="dnf-select grow min-w-0">
                        <option value="" data-path="">Root</option>
                        @foreach (var target in Model.AllFolders)
                        {
                            <option value="@target.Id" data-path="@target.Path">@(new string(' ', target.Depth * 3))@target.Path</option>
                        }
                    </select>
                    <button type="submit" class="dnf-button dnf-button--secondary">Move</button>
                </div>
            </form>
        </div>
        <form method="dialog" class="dnf-dialog__footer">
            <button type="submit" class="dnf-button dnf-button--secondary">Close</button>
        </form>
    </dialog>
}

@if (anyMovable)
{
    @* Move… in the bulk bar opens this (media.js) and the choice posts with #bulkForm; in a file's or folder's menu, with #item-move. *@
    <form method="post" action="/admin/media/move-selected" id="item-move">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnFolder" value="@here" />
        <input type="hidden" data-item-move />
    </form>
    var folderTargets = Model.AllFolders
        .Select(f => new MoveTarget(f.Id, f.Name, null, f.Depth, Model.AllFolders.Where(p => f.Path.StartsWith(p.Path + "/", StringComparison.Ordinal)).Select(p => p.Id).ToList()))
        .ToList();
    <partial name="_MoveDialog" model="@(new MoveDialogModel("media-move-dialog", "Move to", "folderId", "bulkForm", "/admin/media/move-selected", "folder", folderTargets))" />
}

@if (Model.Files.Count > 0)
{
    @* Info in a file's menu opens this (media.js fills in the file). *@
    <dialog class="dnf-dialog dnf-dialog--md" id="file-info-dialog" aria-labelledby="file-info-title">
        <div class="dnf-dialog__header">
            <h2 class="dnf-dialog__title" id="file-info-title">File info</h2>
        </div>
        <div class="dnf-dialog__body">
            <dl class="dnf-description-list dnf-description-list--compact" data-file-info-list></dl>
        </div>
        <form method="dialog" class="dnf-dialog__footer">
            <button type="submit" class="dnf-button dnf-button--secondary">Close</button>
        </form>
    </dialog>
}

@if (anyRenamable)
{
    @* Rename… in a file's menu opens this (media.js sets the form's action, the name and the extension). *@
    <dialog class="dnf-dialog dnf-dialog--md" id="file-rename-dialog" aria-labelledby="file-rename-title">
        <div class="dnf-dialog__header">
            <div>
                <h2 class="dnf-dialog__title" id="file-rename-title">Rename file</h2>
                <p class="dnf-dialog__description">The file keeps its type and its links - links with the old name keep working.</p>
            </div>
        </div>
        <div class="dnf-dialog__body">
            <form method="post" id="file-rename" class="dnf-field">
                @Html.AntiForgeryToken()
                <label class="dnf-field__label" for="file-rename-name">Name</label>
                <div class="dnf-input-group">
                    <input id="file-rename-name" name="name" class="dnf-input" required maxlength="@MediaService.MaxFileNameLength" />
                    <span class="dnf-input-group__suffix" data-file-rename-extension></span>
                </div>
            </form>
        </div>
        <form method="dialog" class="dnf-dialog__footer">
            <button type="submit" class="dnf-button dnf-button--secondary">Cancel</button>
            <button type="submit" class="dnf-button dnf-button--primary" form="file-rename"><dnf-icon name="pencil" /> Rename</button>
        </form>
    </dialog>
}

@if (Model.Files.Count > 0)
{
    @* Clicking a file opens this (media.js): images, video, audio and PDF/text shown; .zip listed; anything else described. *@
    <dialog class="dnf-dialog dnf-dialog--xl dnf-media-preview" id="media-preview" aria-labelledby="media-preview-title" tabindex="-1">
        <div class="dnf-media-preview__head">
            <div class="dnf-media-preview__title">
                <h2 class="dnf-dialog__title truncate" id="media-preview-title" data-preview-title></h2>
                <p class="text-xs text-muted truncate" data-preview-subtitle></p>
            </div>
            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-preview-step="-1" aria-label="Previous file" data-tooltip="Previous file"><dnf-icon name="chevron-left" /></button>
            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-preview-step="1" aria-label="Next file" data-tooltip="Next file"><dnf-icon name="chevron-right" /></button>
            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-preview-close aria-label="Close preview" data-tooltip="Close"><dnf-icon name="x" /></button>
        </div>
        <div class="dnf-media-preview__stage" data-preview-stage></div>
        <div class="dnf-dialog__footer">
            <button type="button" class="dnf-button dnf-button--secondary" data-copy-text="" data-preview-copy><dnf-icon name="link" /> Copy link</button>
            <a class="dnf-button dnf-button--secondary" href="#" target="_blank" rel="noopener" data-preview-tab><dnf-icon name="external-link" /> Open in new tab</a>
            <a class="dnf-button dnf-button--primary" href="#" data-preview-download><dnf-icon name="download" /> Download</a>
        </div>
        <template id="media-preview-icons">
            <dnf-icon name="file" size="Xl" data-icon="file" />
            <dnf-icon name="archive" size="Xl" data-icon="archive" />
            <dnf-icon name="folder" size="Sm" data-icon="folder" />
        </template>
    </dialog>
}

@* Drag and drop posts through this form (media.js); the Move controls work without it. *@
<form method="post" id="dragMove" data-return-folder="@here" hidden>
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="~/js/admin/move-dialog.js" asp-append-version="true" defer></script>
    <script src="~/js/admin/media.js" asp-append-version="true" defer></script>
}
