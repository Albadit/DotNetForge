@model PageBuilderController.BuilderViewModel
@{
    Layout = null;
    var api = Model.Api;
}
@*
    The page builder (.docs/pages/page-builder.md): a full-screen editor outside the admin shell. Everything is built
    by the plain-JS editor in wwwroot/js/builder (loaded as a module); this document only carries its configuration
    (data-* attributes) and the antiforgery token for its API calls. No inline script or style (CSP).
*@
<!DOCTYPE html>
<html lang="@T.Language.Code" dir="@(T.Language.RightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    @if (T.BuilderJson.Length > 0)
    {
        @* The editor's text in the admin language (wwwroot/js/builder/ui/i18n.js). *@
        <meta name="dnf-text" content="@T.BuilderJson" />
    }
    <title>@T["Edit layout"] · @Model.Title · DotNetForge</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/builder/editor.css" asp-append-version="true" />
    @* The --dnn-color-* variables, for the colour picker's "Site colors" swatches. *@
    <link rel="stylesheet" href="~/builder/site-colors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/builder/editor-host.css" asp-append-version="true" />
    <script type="module" src="~/js/builder/main.js" asp-append-version="true"></script>
</head>
<body>
    <h1 class="pe-sr-only">@T["Page builder: {0}", Model.Title]</h1>
    @Html.AntiForgeryToken()
    <div id="pe-editor-root" class="pe-host"
         data-api="@api"
         data-page-id="@Model.PageId"
         data-canvas-url="@(api)canvas"
         data-preview-url="@(api)preview"
         data-back-url="@Model.BackUrl"
         data-can-upload="@(ViewData["CanUpload"] as bool? == true ? "true" : "false")">
        <noscript>@T["The page builder needs JavaScript."] <a href="/admin/pages?selected=@Model.PageId">@T["Back to Pages"]</a></noscript>
    </div>
</body>
</html>
