@using DotNetForge.Shared.Enums
@using DotNetForge.Content
@using DotNetForge.Web.Services
@model EntryEditViewModel
@{
    var type = Model.Type;
    var entry = Model.Entry;
    var single = type.Kind == ContentTypeKind.Single;
    var title = entry is null ? "New entry" : single ? type.Name : ContentEntryService.Display(entry);
    ViewData["Title"] = title;
    ViewData["Description"] = single ? "A single entry: one set of values used across the site." : type.Name;
    ViewData["PageWidth"] = "medium";
    var action = entry is null ? $"/admin/content/{type.Slug}/new" : $"/admin/content/{type.Slug}/{entry.Id}";
    var readOnly = !Model.CanSave;
}

@section Actions {
    @if (!single)
    {
        <a class="dnf-button dnf-button--secondary" href="/admin/content/@type.Slug"><dnf-icon name="chevron-left" /> All @type.Name.ToLowerInvariant()</a>
    }
    @if (Model.CanCreate && entry is not null)
    {
        <a class="dnf-button dnf-button--secondary" href="/admin/content/@type.Slug/new"><dnf-icon name="plus" /> New entry</a>
    }
}

<form id="entryForm" method="post" action="@action" class="dnf-split" novalidate data-entry-form>
    @Html.AntiForgeryToken()
    @if (Model.BaseVersion is { } version)
    {
        <input type="hidden" name="baseVersion" value="@version" />
    }
    @if (Model.Conflict)
    {
        <input type="hidden" name="force" value="true" />
    }

    <div class="dnf-split__main">
        <dnf-validation-summary />
        @if (readOnly)
        {
            <dnf-alert tone="Info" title="View only">You can see this entry but not change it.</dnf-alert>
        }
        <section class="dnf-card" aria-label="Fields">
            <div class="dnf-card__body dnf-form-grid">
                @foreach (var field in Model.Fields)
                {
                    <partial name="_Field" model="new EntryFieldView(field, Model.Values[field.Key], field.Key, Model)" />
                }
                @if (Model.Fields.Count == 0)
                {
                    <p class="dnf-form-grid__full text-muted">This content type has no fields yet. <a href="/admin/content-types/@type.Id">Add fields</a> first.</p>
                }
            </div>
        </section>
    </div>

    <aside class="dnf-split__aside">
        <section class="dnf-card" aria-labelledby="status-title">
            <div class="dnf-card__header">
                <h2 class="dnf-card__title" id="status-title">Status</h2>
                @if (entry is null || !entry.Published)
                {
                    <dnf-badge tone="Neutral" dot="true">Draft</dnf-badge>
                }
                else if (entry.HasDraft)
                {
                    <dnf-badge tone="Warning" dot="true">Changes not published</dnf-badge>
                }
                else
                {
                    <dnf-badge tone="Success" dot="true">Published</dnf-badge>
                }
            </div>
            <div class="dnf-card__body dnf-stack dnf-stack--sm text-sm">
                @if (entry is null)
                {
                    <p class="text-muted">@(type.Drafts ? "Save a draft to keep working on it, or publish to show it on the site." : "Saving publishes it at once.")</p>
                }
                else
                {
                    <dl class="dnf-description-list dnf-description-list--compact">
                        @if (entry.PublishedDate is { } published)
                        {
                            <dt>Published</dt>
                            <dd><dnf-timestamp value="@published" /></dd>
                        }
                        <dt>Updated</dt>
                        <dd><dnf-timestamp value="@entry.UpdatedDate" />@(Model.UpdatedBy is null ? "" : " by " + Model.UpdatedBy)</dd>
                        <dt>Created</dt>
                        <dd><dnf-timestamp value="@entry.CreatedDate" /></dd>
                    </dl>
                    @if (entry.Published && entry.HasDraft)
                    {
                        <p class="text-muted">The site shows the published version until you publish these changes.</p>
                    }
                }
            </div>
            @if (!readOnly)
            {
                <div class="dnf-card__footer flex-col items-stretch">
                    @if (type.Drafts)
                    {
                        @if (Model.CanPublish)
                        {
                            <button type="submit" name="intent" value="publish" class="dnf-button dnf-button--primary dnf-button--full-width"><dnf-icon name="send" /> @(entry is { Published: true, HasDraft: true } ? "Publish changes" : "Publish")</button>
                        }
                        <button type="submit" name="intent" value="save" class="dnf-button dnf-button--secondary dnf-button--full-width"><dnf-icon name="save" /> Save draft</button>
                    }
                    else if (Model.CanPublish)
                    {
                        <button type="submit" name="intent" value="publish" class="dnf-button dnf-button--primary dnf-button--full-width"><dnf-icon name="save" /> Save</button>
                    }
                    else
                    {
                        <p class="text-sm text-muted">Saving this type publishes it, which needs the publish permission.</p>
                    }
                </div>
            }
        </section>

        @if (entry is not null && (Model.CanPublish && entry.Published || Model.CanCreate || Model.CanDelete))
        {
            <section class="dnf-card" aria-labelledby="more-title">
                <div class="dnf-card__header"><h2 class="dnf-card__title" id="more-title">More</h2></div>
                <div class="dnf-card__body dnf-stack dnf-stack--sm">
                    @if (Model.CanPublish && entry.Published)
                    {
                        <button type="submit" form="unpublishForm" class="dnf-button dnf-button--secondary dnf-button--full-width"
                                data-confirm="Take '@title' off the site and out of the API? Its values are kept." data-confirm-title="Unpublish" data-confirm-action="Unpublish" data-confirm-tone="primary">
                            <dnf-icon name="eye-off" /> Unpublish
                        </button>
                    }
                    @if (Model.CanCreate)
                    {
                        <button type="submit" form="duplicateForm" class="dnf-button dnf-button--secondary dnf-button--full-width"><dnf-icon name="copy" /> Duplicate</button>
                    }
                    @if (Model.CanDelete)
                    {
                        <button type="submit" form="deleteForm" class="dnf-button dnf-button--danger-soft dnf-button--full-width"
                                data-confirm="Delete '@title'? Pages that show it stop showing it. This can't be undone." data-confirm-title="Delete entry" data-confirm-action="Delete">
                            <dnf-icon name="trash" /> Delete
                        </button>
                    }
                </div>
            </section>
        }

        @if (entry is not null)
        {
            <section class="dnf-card" aria-labelledby="api-title">
                <div class="dnf-card__header"><h2 class="dnf-card__title" id="api-title">Use it</h2></div>
                <div class="dnf-card__body dnf-stack dnf-stack--sm text-sm">
                    <p class="text-muted">Show it on a page with a <strong>content list</strong> in the page builder, or read it from the API:</p>
                    <code class="dnf-code-block dnf-code-block--inline text-xs">GET /api/entries/@type.Slug/@entry.Id</code>
                </div>
            </section>
        }
    </aside>
</form>

@if (entry is not null)
{
    <form id="unpublishForm" method="post" action="/admin/content/@type.Slug/@entry.Id/unpublish" hidden>@Html.AntiForgeryToken()</form>
    <form id="duplicateForm" method="post" action="/admin/content/@type.Slug/@entry.Id/duplicate" hidden>@Html.AntiForgeryToken()</form>
    <form id="deleteForm" method="post" action="/admin/content/@type.Slug/@entry.Id/delete" hidden>@Html.AntiForgeryToken()</form>
}

@section Scripts {
    <script src="~/js/admin/entries.js" asp-append-version="true" defer></script>
}
