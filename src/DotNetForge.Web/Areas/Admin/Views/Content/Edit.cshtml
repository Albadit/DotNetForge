@using DotNetForge.Shared.Enums
@using DotNetForge.Content
@using DotNetForge.Web.Services
@model EntryEditViewModel
@{
    var type = Model.Type;
    var entry = Model.Entry;
    var single = type.Kind == ContentTypeKind.Single;
    var title = entry is null ? T["New entry"] : single ? type.Name : ContentEntryService.Display(entry);
    ViewData["Title"] = title;
    // Translating (.docs/features/internationalization.md#entries): only the text fields, posted to the translation.
    var translating = Model.TranslationCode is not null;
    ViewData["Description"] = translating ? T["{0} · {1} translation", type.Name, Model.TranslationName]
        : single ? T["A single entry: one set of values used across the site."] : type.Name;
    ViewData["PageWidth"] = "medium";
    var action = entry is null ? $"/admin/content/{type.Slug}/new"
        : translating ? $"/admin/content/{type.Slug}/{entry.Id}/translations/{Model.TranslationCode}" : $"/admin/content/{type.Slug}/{entry.Id}";
    var readOnly = !Model.CanSave;
}

@section Actions {
    @if (!single)
    {
        <a class="dnf-button dnf-button--secondary" href="/admin/content/@type.Slug"><dnf-icon name="chevron-left" /> @T["All {0}", type.Name.ToLowerInvariant()]</a>
    }
    @if (Model.CanCreate && entry is not null)
    {
        <a class="dnf-button dnf-button--secondary" href="/admin/content/@type.Slug/new"><dnf-icon name="plus" /> @T["New entry"]</a>
    }
}

<form id="entryForm" method="post" action="@action" class="dnf-split" novalidate data-entry-form>
    @Html.AntiForgeryToken()
    @if (Model.BaseVersion is { } version)
    {
        <input type="hidden" name="baseVersion" value="@version" />
    }
    @if (Model.Conflict)
    {
        <input type="hidden" name="force" value="true" />
    }

    <div class="dnf-split__main">
        <dnf-validation-summary />
        @if (Model.Languages.Count > 1)
        {
            <nav class="dnf-segmented" aria-label="@T["Language"]">
                @foreach (var language in Model.Languages)
                {
                    <a class="dnf-segmented__item" href="@language.Url" lang="@language.Code" aria-current="@(language.Current ? "page" : null)"
                       title="@(language.Translated ? null : T["Not translated yet"])">@language.Name@(language.Translated ? "" : " ·")</a>
                }
            </nav>
        }
        @if (translating)
        {
            <dnf-alert tone="Info" title="@T["Translating into {0}", Model.TranslationName]">@T["Only the text fields are translated; images, numbers, links and the other fields are shared by every language. An empty field shows the main text."]</dnf-alert>
        }
        @if (readOnly)
        {
            <dnf-alert tone="Info" title="@T["View only"]">@T["You can see this entry but not change it."]</dnf-alert>
        }
        <section class="dnf-card" aria-label="@T["Fields"]">
            <div class="dnf-card__body dnf-form-grid">
                @foreach (var field in Model.Fields)
                {
                    <partial name="_Field" model="new EntryFieldView(field, Model.Values[field.Key], field.Key, Model)" />
                }
                @if (Model.Fields.Count == 0)
                {
                    <p class="dnf-form-grid__full text-muted">@(translating ? T["This content type has no text fields to translate."] : T["This content type has no fields yet."]) <a href="/admin/content-types/@type.Id">@(translating ? T["Edit its fields"] : T["Add fields"])</a>@(translating ? "." : " " + T["first."])</p>
                }
            </div>
        </section>
    </div>

    <aside class="dnf-split__aside">
        <section class="dnf-card" aria-labelledby="status-title">
            <div class="dnf-card__header">
                <h2 class="dnf-card__title" id="status-title">@(translating ? T["Translation"] : T["Status"])</h2>
                @if (translating)
                {
                    @if (Model.TranslationPublished is null)
                    {
                        <dnf-badge tone="Neutral" dot="true">@T["Not translated"]</dnf-badge>
                    }
                    else if (Model.TranslationPublished == false || Model.TranslationHasDraft)
                    {
                        <dnf-badge tone="Warning" dot="true">@T["Changes not published"]</dnf-badge>
                    }
                    else
                    {
                        <dnf-badge tone="Success" dot="true">@T["Published"]</dnf-badge>
                    }
                }
                else if (entry is null || !entry.Published)
                {
                    <dnf-badge tone="Neutral" dot="true">@T["Draft"]</dnf-badge>
                }
                else if (entry.HasDraft)
                {
                    <dnf-badge tone="Warning" dot="true">@T["Changes not published"]</dnf-badge>
                }
                else
                {
                    <dnf-badge tone="Success" dot="true">@T["Published"]</dnf-badge>
                }
            </div>
            <div class="dnf-card__body dnf-stack dnf-stack--sm text-sm">
                @if (translating)
                {
                    <p class="text-muted">@(entry!.Published ? T["Published translations show on the site and in the API with ?locale={0}.", Model.TranslationCode] : T["The entry itself is not published yet: the translation shows once it is."]) @T["Publishing the entry publishes its translations too."]</p>
                }
                else if (entry is null)
                {
                    <p class="text-muted">@(type.Drafts ? T["Save a draft to keep working on it, or publish to show it on the site."] : T["Saving publishes it at once."])</p>
                }
                else
                {
                    <dl class="dnf-description-list dnf-description-list--compact">
                        @if (entry.PublishedDate is { } published)
                        {
                            <dt>@T["Published"]</dt>
                            <dd><dnf-timestamp value="@published" /></dd>
                        }
                        <dt>@T["Updated"]</dt>
                        <dd><dnf-timestamp value="@entry.UpdatedDate" />@(Model.UpdatedBy is null ? "" : " " + T["by {0}", Model.UpdatedBy])</dd>
                        <dt>@T["Created"]</dt>
                        <dd><dnf-timestamp value="@entry.CreatedDate" /></dd>
                    </dl>
                    @if (entry.Published && entry.HasDraft)
                    {
                        <p class="text-muted">@T["The site shows the published version until you publish these changes."]</p>
                    }
                }
            </div>
            @if (!readOnly)
            {
                <div class="dnf-card__footer flex-col items-stretch">
                    @if (type.Drafts)
                    {
                        @if (Model.CanPublish)
                        {
                            <button type="submit" name="intent" value="publish" class="dnf-button dnf-button--primary dnf-button--full-width"><dnf-icon name="send" /> @(entry is { Published: true, HasDraft: true } ? T["Publish changes"] : T["Publish"])</button>
                        }
                        <button type="submit" name="intent" value="save" class="dnf-button dnf-button--secondary dnf-button--full-width"><dnf-icon name="save" /> @T["Save draft"]</button>
                    }
                    else if (Model.CanPublish)
                    {
                        <button type="submit" name="intent" value="publish" class="dnf-button dnf-button--primary dnf-button--full-width"><dnf-icon name="save" /> @T["Save"]</button>
                    }
                    else
                    {
                        <p class="text-sm text-muted">@T["Saving this type publishes it, which needs the publish permission."]</p>
                    }
                </div>
            }
        </section>

        @if (entry is not null && !translating && (Model.CanPublish && entry.Published || Model.CanCreate || Model.CanDelete))
        {
            <section class="dnf-card" aria-labelledby="more-title">
                <div class="dnf-card__header"><h2 class="dnf-card__title" id="more-title">@T["More"]</h2></div>
                <div class="dnf-card__body dnf-stack dnf-stack--sm">
                    @if (Model.CanPublish && entry.Published)
                    {
                        <button type="submit" form="unpublishForm" class="dnf-button dnf-button--secondary dnf-button--full-width"
                                data-confirm="@T["Take '{0}' off the site and out of the API? Its values are kept.", title]" data-confirm-title="@T["Unpublish"]" data-confirm-action="@T["Unpublish"]" data-confirm-tone="primary">
                            <dnf-icon name="eye-off" /> @T["Unpublish"]
                        </button>
                    }
                    @if (Model.CanCreate)
                    {
                        <button type="submit" form="duplicateForm" class="dnf-button dnf-button--secondary dnf-button--full-width"><dnf-icon name="copy" /> @T["Duplicate"]</button>
                    }
                    @if (Model.CanDelete)
                    {
                        <button type="submit" form="deleteForm" class="dnf-button dnf-button--danger-soft dnf-button--full-width"
                                data-confirm="@T["Delete '{0}'? Pages that show it stop showing it. This can't be undone.", title]" data-confirm-title="@T["Delete entry"]" data-confirm-action="@T["Delete"]">
                            <dnf-icon name="trash" /> @T["Delete"]
                        </button>
                    }
                </div>
            </section>
        }

        @if (entry is not null)
        {
            <section class="dnf-card" aria-labelledby="api-title">
                <div class="dnf-card__header"><h2 class="dnf-card__title" id="api-title">@T["Use it"]</h2></div>
                <div class="dnf-card__body dnf-stack dnf-stack--sm text-sm">
                    <p class="text-muted">@T["Show it on a page with a"] <strong>@T["content list"]</strong> @T["in the page builder, or read it from the API:"]</p>
                    <code class="dnf-code-block dnf-code-block--inline text-xs">GET /api/entries/@type.Slug/@entry.Id@(translating ? "?locale=" + Model.TranslationCode : "")</code>
                </div>
            </section>
        }
    </aside>
</form>

@if (entry is not null)
{
    <form id="unpublishForm" method="post" action="/admin/content/@type.Slug/@entry.Id/unpublish" hidden>@Html.AntiForgeryToken()</form>
    <form id="duplicateForm" method="post" action="/admin/content/@type.Slug/@entry.Id/duplicate" hidden>@Html.AntiForgeryToken()</form>
    <form id="deleteForm" method="post" action="/admin/content/@type.Slug/@entry.Id/delete" hidden>@Html.AntiForgeryToken()</form>
}

@section Scripts {
    <script src="~/js/admin/entries.js" asp-append-version="true" data-screen defer></script>
}
