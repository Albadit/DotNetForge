@model EntryListViewModel
@{
    var type = Model.Type;
    ViewData["Title"] = type.Name;
    ViewData["Description"] = string.IsNullOrEmpty(type.Description) ? $"Entries of {type.Name}. Show them on pages with a content list." : type.Description;
    var anyDeletable = Model.Rows.Any(r => r.CanDelete);
    var colspan = 4 + Model.Columns.Count + (anyDeletable ? 1 : 0);

    string SortUrl(string key) => Model.Url(q =>
    {
        var same = Model.Sort == key;
        q["sort"] = key;
        q["desc"] = same && !Model.Descending ? "true" : null;
    });
    string? AriaSort(string key) => Model.Sort == key ? (Model.Descending ? "descending" : "ascending") : null;
    string SortIcon(string key) => Model.Sort == key ? "arrow-up" : "sort";
}

@section Actions {
    @if (Model.CanEditType)
    {
        <a class="btn btn-secondary" href="/admin/content-types/@type.Id"><icon name="layers" /> Fields</a>
    }
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" href="/admin/content/@type.Slug/new"><icon name="plus" /> New entry</a>
    }
}

<section class="card" aria-labelledby="entries-title" data-collection>
    <div class="card-header">
        <div>
            <h2 class="card-title" id="entries-title">Entries</h2>
            <p class="card-description">@Model.Total @(Model.Total == 1 ? "entry" : "entries")@(Model.Search is { Length: > 0 } || Model.Status is not null ? " match" : "")</p>
        </div>
        <nav class="segmented" aria-label="Status">
            <a href="@Model.Url(q => q["status"] = null)" aria-current="@(Model.Status is null ? "true" : null)">All</a>
            <a href="@Model.Url(q => q["status"] = "published")" aria-current="@(Model.Status == "published" ? "true" : null)">Published</a>
            <a href="@Model.Url(q => q["status"] = "changed")" aria-current="@(Model.Status == "changed" ? "true" : null)">Changed</a>
            <a href="@Model.Url(q => q["status"] = "draft")" aria-current="@(Model.Status == "draft" ? "true" : null)">Draft</a>
        </nav>
    </div>

    <div class="collection-bar">
        <form method="get" action="/admin/content/@type.Slug" class="toolbar" role="search">
            @if (anyDeletable)
            {
                <label class="check" aria-label="Select all entries" data-js-only hidden><input type="checkbox" data-select-all /></label>
            }
            <div class="toolbar-search input-icon">
                <icon name="search" size="sm" />
                <label class="sr-only" for="entry-search">Search entries</label>
                <input id="entry-search" type="search" name="q" value="@Model.Search" class="input-sm" placeholder="Search @type.Name.ToLowerInvariant()" />
            </div>
            @if (Model.Status is not null)
            {
                <input type="hidden" name="status" value="@Model.Status" />
            }
            @if (Model.Sort != "sortOrder")
            {
                <input type="hidden" name="sort" value="@Model.Sort" />
            }
            @if (Model.Descending)
            {
                <input type="hidden" name="desc" value="true" />
            }
            <button type="submit" class="btn btn-secondary btn-sm">Search</button>
            @if (Model.Search is { Length: > 0 })
            {
                <a class="btn btn-ghost btn-sm" href="@Model.Url(q => q["q"] = null)">Clear</a>
            }
            @if (Model.CanReorder && Model.Rows.Count > 1)
            {
                <span class="toolbar-spacer"></span>
                <span class="text-xs text-subtle" data-js-only hidden><icon name="grip" size="sm" /> Drag rows to set the order content lists use by default</span>
            }
        </form>

        @if (anyDeletable)
        {
            <form method="post" action="/admin/content/@type.Slug/delete-selected" id="bulkDelete" class="bulk-bar" data-bulk-bar hidden
                  data-confirm="Delete the selected entries? Pages that show them stop showing them." data-confirm-title="Delete entries" data-confirm-action="Delete entries">
                @Html.AntiForgeryToken()
                <label class="check" aria-label="Select all entries"><input type="checkbox" data-select-all /></label>
                <span data-bulk-count>0 selected</span>
                <span class="toolbar-spacer"></span>
                <button type="button" class="btn btn-ghost btn-sm" data-bulk-clear>Clear</button>
                <button type="submit" class="btn btn-danger btn-sm"><icon name="trash" size="sm" /> Delete selected</button>
            </form>
        }
    </div>

    <div class="table-wrap">
        <table class="table table-stack entry-table">
            <thead>
                <tr>
                    @if (anyDeletable)
                    {
                        <th scope="col" class="col-check"><span class="sr-only">Select</span></th>
                    }
                    <th scope="col" aria-sort="@AriaSort("title")"><a class="th-sort" href="@SortUrl("title")">Title <icon name="@SortIcon("title")" size="sm" /></a></th>
                    @foreach (var (key, label) in Model.Columns)
                    {
                        <th scope="col" aria-sort="@AriaSort(key)"><a class="th-sort" href="@SortUrl(key)">@label <icon name="@SortIcon(key)" size="sm" /></a></th>
                    }
                    <th scope="col">Status</th>
                    <th scope="col" aria-sort="@AriaSort("updatedAt")"><a class="th-sort" href="@SortUrl("updatedAt")">Updated <icon name="@SortIcon("updatedAt")" size="sm" /></a></th>
                    <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody data-entry-rows="@(Model.CanReorder ? $"/admin/content/{type.Slug}/reorder" : null)">
                @foreach (var row in Model.Rows)
                {
                    var e = row.Entry;
                    var title = DotNetForge.Content.ContentEntryService.Display(e);
                    <tr data-item data-entry-id="@e.Id">
                        @if (anyDeletable)
                        {
                            <td class="col-check">
                                @if (row.CanDelete)
                                {
                                    <label class="check" aria-label="Select @title"><input type="checkbox" name="ids" value="@e.Id" form="bulkDelete" data-select-item /></label>
                                }
                            </td>
                        }
                        <td class="cell-lead">
                            <div class="cluster">
                                @if (Model.CanReorder)
                                {
                                    <span class="row-grip" data-js-only hidden aria-hidden="true"><icon name="grip" size="sm" /></span>
                                }
                                <a class="cell-primary@(e.Title.Length == 0 ? " text-subtle" : "")" href="/admin/content/@type.Slug/@e.Id">@title</a>
                            </div>
                        </td>
                        @for (var i = 0; i < Model.Columns.Count; i++)
                        {
                            <td data-label="@Model.Columns[i].Label">@row.Columns[i]</td>
                        }
                        <td data-label="Status">
                            @if (!e.Published)
                            {
                                <badge tone="Neutral" dot="true">Draft</badge>
                            }
                            else if (e.HasDraft)
                            {
                                <badge tone="Warning" dot="true">Changed</badge>
                            }
                            else
                            {
                                <badge tone="Success" dot="true">Published</badge>
                            }
                        </td>
                        <td data-label="Updated"><timestamp value="@e.UpdatedDate" /></td>
                        <td class="col-actions">
                            <action-menu label="Actions for @title">
                                <menu-link href="/admin/content/@type.Slug/@e.Id" icon="@(row.CanEdit ? "pencil" : "eye")">@(row.CanEdit ? "Edit" : "View")</menu-link>
                                @if (Model.CanCreate)
                                {
                                    <menu-post action="/admin/content/@type.Slug/@e.Id/duplicate" icon="copy">Duplicate</menu-post>
                                }
                                @if (Model.CanPublish)
                                {
                                    if (!e.Published || e.HasDraft)
                                    {
                                        <menu-post action="/admin/content/@type.Slug/@e.Id/publish" icon="send" field-returnTo="list">@(e.Published ? "Publish changes" : "Publish")</menu-post>
                                    }
                                    if (e.Published)
                                    {
                                        <menu-post action="/admin/content/@type.Slug/@e.Id/unpublish" icon="eye-off" field-returnTo="list">Unpublish</menu-post>
                                    }
                                }
                                @if (row.CanDelete)
                                {
                                    <menu-separator />
                                    <menu-post action="/admin/content/@type.Slug/@e.Id/delete" icon="trash" danger="true"
                                               confirm="Delete '@title'? Pages that show it stop showing it. This can't be undone." confirm-title="Delete entry" confirm-action="Delete">Delete</menu-post>
                                }
                            </action-menu>
                        </td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr class="table-empty">
                        <td colspan="@colspan">
                            @if (Model.Search is { Length: > 0 } || Model.Status is not null)
                            {
                                <text>No entry matches. <a href="/admin/content/@type.Slug">Show all entries</a></text>
                            }
                            else
                            {
                                <text>No entries yet.</text>
                                @if (Model.CanCreate)
                                {
                                    <a href="/admin/content/@type.Slug/new">Create the first one</a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.PageCount > 1)
    {
        <nav class="pagination" aria-label="Pages">
            <span>Page @Model.Page of @Model.PageCount</span>
            <div class="pagination-pages">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-secondary btn-sm" href="@Model.Url(q => q["page"] = (Model.Page - 1).ToString())" rel="prev"><icon name="chevron-left" size="sm" /> Previous</a>
                }
                @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.PageCount, Model.Page + 2); p++)
                {
                    var n = p;
                    <a class="btn btn-secondary btn-sm" href="@Model.Url(q => q["page"] = n.ToString())" aria-current="@(n == Model.Page ? "page" : null)">@n</a>
                }
                @if (Model.Page < Model.PageCount)
                {
                    <a class="btn btn-secondary btn-sm" href="@Model.Url(q => q["page"] = (Model.Page + 1).ToString())" rel="next">Next <icon name="chevron-right" size="sm" /></a>
                }
            </div>
        </nav>
    }
</section>

@section Scripts {
    <script src="~/js/forge/entries.js" asp-append-version="true" defer></script>
}
