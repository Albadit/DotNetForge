@model EntryListViewModel
@{
    var type = Model.Type;
    ViewData["Title"] = type.Name;
    ViewData["Description"] = string.IsNullOrEmpty(type.Description) ? $"Entries of {type.Name}. Show them on pages with a content list." : type.Description;
    var anyDeletable = Model.Rows.Any(r => r.CanDelete);
    var colspan = 4 + Model.Columns.Count + (anyDeletable ? 1 : 0);

    string SortUrl(string key) => Model.Url(q =>
    {
        var same = Model.Sort == key;
        q["sort"] = key;
        q["desc"] = same && !Model.Descending ? "true" : null;
    });
    string? AriaSort(string key) => Model.Sort == key ? (Model.Descending ? "descending" : "ascending") : null;
    string SortIcon(string key) => Model.Sort == key ? "chevron-up" : "sort";
}

@section Actions {
    @if (Model.CanEditType)
    {
        <a class="dnf-button dnf-button--secondary" href="/admin/content-types/@type.Id"><dnf-icon name="layers" /> Fields</a>
    }
    @if (Model.CanCreate)
    {
        <a class="dnf-button dnf-button--primary" href="/admin/content/@type.Slug/new"><dnf-icon name="plus" /> New entry</a>
    }
}

<section class="dnf-card" aria-labelledby="entries-title" data-collection>
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="entries-title">Entries</h2>
            <p class="dnf-card__description">@Model.Total @(Model.Total == 1 ? "entry" : "entries")@(Model.Search is { Length: > 0 } || Model.Status is not null ? " match" : "")</p>
        </div>
        <nav class="dnf-segmented" aria-label="Status">
            <a class="dnf-segmented__item" href="@Model.Url(q => q["status"] = null)" aria-current="@(Model.Status is null ? "true" : null)">All</a>
            <a class="dnf-segmented__item" href="@Model.Url(q => q["status"] = "published")" aria-current="@(Model.Status == "published" ? "true" : null)">Published</a>
            <a class="dnf-segmented__item" href="@Model.Url(q => q["status"] = "changed")" aria-current="@(Model.Status == "changed" ? "true" : null)">Changed</a>
            <a class="dnf-segmented__item" href="@Model.Url(q => q["status"] = "draft")" aria-current="@(Model.Status == "draft" ? "true" : null)">Draft</a>
        </nav>
    </div>

    <div class="dnf-collection-bar">
        <form method="get" action="/admin/content/@type.Slug" class="dnf-toolbar" role="search">
            @if (anyDeletable)
            {
                <label class="dnf-check" aria-label="Select all entries" data-js-only hidden><input type="checkbox" class="dnf-checkbox" data-select-all /></label>
            }
            <div class="dnf-toolbar__search dnf-input-group">
                <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                <label class="sr-only" for="entry-search">Search entries</label>
                <input id="entry-search" type="search" name="q" value="@Model.Search" class="dnf-input dnf-input--sm" placeholder="Search @type.Name.ToLowerInvariant()" />
            </div>
            @if (Model.Status is not null)
            {
                <input type="hidden" name="status" value="@Model.Status" />
            }
            @if (Model.Sort != "sortOrder")
            {
                <input type="hidden" name="sort" value="@Model.Sort" />
            }
            @if (Model.Descending)
            {
                <input type="hidden" name="desc" value="true" />
            }
            <button type="submit" class="dnf-button dnf-button--secondary dnf-button--sm">Search</button>
            @if (Model.Search is { Length: > 0 })
            {
                <a class="dnf-button dnf-button--ghost dnf-button--sm" href="@Model.Url(q => q["q"] = null)">Clear</a>
            }
            @if (Model.CanReorder && Model.Rows.Count > 1)
            {
                <span class="dnf-toolbar__spacer"></span>
                <span class="text-xs text-subtle" data-js-only hidden><dnf-icon name="grip" size="Sm" /> Drag rows, or use Move up and Move down in their menu, to set the order content lists use by default</span>
            }
        </form>

        @if (anyDeletable)
        {
            <form method="post" action="/admin/content/@type.Slug/delete-selected" id="bulkDelete" class="dnf-bulk-bar" data-bulk-bar hidden
                  data-confirm="Delete the selected entries? Pages that show them stop showing them." data-confirm-title="Delete entries" data-confirm-action="Delete entries">
                @Html.AntiForgeryToken()
                <label class="dnf-check" aria-label="Select all entries"><input type="checkbox" class="dnf-checkbox" data-select-all /></label>
                <span class="dnf-bulk-bar__count" data-bulk-count>0 selected</span>
                <span class="flex-auto"></span>
                <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm" data-bulk-clear>Clear</button>
                <button type="submit" class="dnf-button dnf-button--danger dnf-button--sm"><dnf-icon name="trash" size="Sm" /> Delete selected</button>
            </form>
        }
    </div>

    <div class="dnf-table dnf-table--stack">
        <table class="dnf-table__table">
            <thead>
                <tr>
                    @if (anyDeletable)
                    {
                        <th scope="col" class="dnf-table__cell--check"><span class="sr-only">Select</span></th>
                    }
                    <th scope="col" aria-sort="@AriaSort("title")"><a class="dnf-table__sort" href="@SortUrl("title")">Title <dnf-icon name="@SortIcon("title")" size="Sm" /></a></th>
                    @foreach (var (key, label) in Model.Columns)
                    {
                        <th scope="col" aria-sort="@AriaSort(key)"><a class="dnf-table__sort" href="@SortUrl(key)">@label <dnf-icon name="@SortIcon(key)" size="Sm" /></a></th>
                    }
                    <th scope="col">Status</th>
                    <th scope="col" aria-sort="@AriaSort("updatedAt")"><a class="dnf-table__sort" href="@SortUrl("updatedAt")">Updated <dnf-icon name="@SortIcon("updatedAt")" size="Sm" /></a></th>
                    <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody data-entry-rows="@(Model.CanReorder ? $"/admin/content/{type.Slug}/reorder" : null)">
                @foreach (var row in Model.Rows)
                {
                    var e = row.Entry;
                    var title = DotNetForge.Content.ContentEntryService.Display(e);
                    <tr data-item data-entry-id="@e.Id">
                        @if (anyDeletable)
                        {
                            <td class="dnf-table__cell--check">
                                @if (row.CanDelete)
                                {
                                    <label class="dnf-check" aria-label="Select @title"><input type="checkbox" class="dnf-checkbox" name="ids" value="@e.Id" form="bulkDelete" data-select-item /></label>
                                }
                            </td>
                        }
                        <td class="dnf-table__cell--lead">
                            <div class="dnf-cluster">
                                @if (Model.CanReorder)
                                {
                                    <span class="dnf-table__grip" data-js-only hidden aria-hidden="true"><dnf-icon name="grip" size="Sm" /></span>
                                }
                                <a class="dnf-table__primary@(e.Title.Length == 0 ? " text-subtle" : "")" href="/admin/content/@type.Slug/@e.Id">@title</a>
                            </div>
                        </td>
                        @for (var i = 0; i < Model.Columns.Count; i++)
                        {
                            <td data-label="@Model.Columns[i].Label">@row.Columns[i]</td>
                        }
                        <td data-label="Status">
                            @if (!e.Published)
                            {
                                <dnf-badge tone="Neutral" dot="true">Draft</dnf-badge>
                            }
                            else if (e.HasDraft)
                            {
                                <dnf-badge tone="Warning" dot="true">Changed</dnf-badge>
                            }
                            else
                            {
                                <dnf-badge tone="Success" dot="true">Published</dnf-badge>
                            }
                        </td>
                        <td data-label="Updated"><dnf-timestamp value="@e.UpdatedDate" /></td>
                        <td class="dnf-table__cell--actions">
                            <dnf-dropdown label="Actions for @title">
                                <dnf-dropdown-link href="/admin/content/@type.Slug/@e.Id" icon="@(row.CanEdit ? "pencil" : "eye")">@(row.CanEdit ? "Edit" : "View")</dnf-dropdown-link>
                                @if (Model.CanCreate)
                                {
                                    <dnf-dropdown-post action="/admin/content/@type.Slug/@e.Id/duplicate" icon="copy">Duplicate</dnf-dropdown-post>
                                }
                                @if (Model.CanReorder && row != Model.Rows[0])
                                {
                                    <dnf-dropdown-button icon="chevron-up" data-entry-move="up" data-js-only hidden>Move up</dnf-dropdown-button>
                                }
                                @if (Model.CanReorder && row != Model.Rows[Model.Rows.Count - 1])
                                {
                                    <dnf-dropdown-button icon="chevron-down" data-entry-move="down" data-js-only hidden>Move down</dnf-dropdown-button>
                                }
                                @if (Model.CanPublish)
                                {
                                    if (!e.Published || e.HasDraft)
                                    {
                                        <dnf-dropdown-post action="/admin/content/@type.Slug/@e.Id/publish" icon="send" field-returnTo="list">@(e.Published ? "Publish changes" : "Publish")</dnf-dropdown-post>
                                    }
                                    if (e.Published)
                                    {
                                        <dnf-dropdown-post action="/admin/content/@type.Slug/@e.Id/unpublish" icon="eye-off" field-returnTo="list">Unpublish</dnf-dropdown-post>
                                    }
                                }
                                @if (row.CanDelete)
                                {
                                    <dnf-dropdown-separator />
                                    <dnf-dropdown-post action="/admin/content/@type.Slug/@e.Id/delete" icon="trash" danger="true"
                                               confirm="Delete '@title'? Pages that show it stop showing it. This can't be undone." confirm-title="Delete entry" confirm-action="Delete">Delete</dnf-dropdown-post>
                                }
                            </dnf-dropdown>
                        </td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr class="dnf-table__empty">
                        <td colspan="@colspan">
                            @if (Model.Search is { Length: > 0 } || Model.Status is not null)
                            {
                                <text>No entry matches. <a href="/admin/content/@type.Slug">Show all entries</a></text>
                            }
                            else
                            {
                                <text>No entries yet.</text>
                                @if (Model.CanCreate)
                                {
                                    <a href="/admin/content/@type.Slug/new">Create the first one</a>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.PageCount > 1)
    {
        <nav class="dnf-pagination" aria-label="Pages">
            <span>Page @Model.Page of @Model.PageCount</span>
            <div class="dnf-pagination__pages">
                @if (Model.Page > 1)
                {
                    <a class="dnf-button dnf-button--secondary dnf-button--sm" href="@Model.Url(q => q["page"] = (Model.Page - 1).ToString())" rel="prev"><dnf-icon name="chevron-left" size="Sm" /> Previous</a>
                }
                @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.PageCount, Model.Page + 2); p++)
                {
                    var n = p;
                    <a class="dnf-button dnf-button--secondary dnf-button--sm" href="@Model.Url(q => q["page"] = n.ToString())" aria-current="@(n == Model.Page ? "page" : null)">@n</a>
                }
                @if (Model.Page < Model.PageCount)
                {
                    <a class="dnf-button dnf-button--secondary dnf-button--sm" href="@Model.Url(q => q["page"] = (Model.Page + 1).ToString())" rel="next">Next <dnf-icon name="chevron-right" size="Sm" /></a>
                }
            </div>
        </nav>
    }
</section>

@section Scripts {
    <script src="~/js/admin/entries.js" asp-append-version="true" defer></script>
}
