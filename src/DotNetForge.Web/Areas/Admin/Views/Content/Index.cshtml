@using DotNetForge.Shared.Enums
@model ContentManagerViewModel
@{
    ViewData["Title"] = "Content Manager";
    ViewData["Description"] = "Your structured content - blog posts, products, events - kept apart from the pages that show it.";
}

@section Actions {
    @if (Model.CanManageTypes)
    {
        <a class="btn btn-secondary" href="/admin/content-types"><icon name="layers" /> Content types</a>
    }
}

@if (Model.Types.Count == 0)
{
    <section class="card">
        <div class="card-body">
            <empty-state icon="database" title="Start with a content type"
                         text="Describe what you publish - a product has a name, a price and pictures - and the Content Manager builds the forms. Then show it on any page with a content list.">
                @if (Model.CanManageTypes)
                {
                    <a class="btn btn-primary" href="/admin/content-types/new"><icon name="plus" /> New content type</a>
                }
                else
                {
                    <p class="text-sm text-muted">Ask an administrator to create a content type.</p>
                }
            </empty-state>
        </div>
    </section>

    <section class="card workflow-card" aria-labelledby="how-title">
        <div class="card-header"><h2 class="card-title" id="how-title">How it fits together</h2></div>
        <ol class="workflow">
            <li><icon name="layers" /><strong>Content type</strong><span>Define the fields once.</span></li>
            <li><icon name="database" /><strong>Entries</strong><span>Add content with the generated form.</span></li>
            <li><icon name="pages" /><strong>Page builder</strong><span>Add a content list to a page.</span></li>
            <li><icon name="link" /><strong>Map fields</strong><span>Bind heading, image, price to fields.</span></li>
            <li><icon name="send" /><strong>Publish</strong><span>Edits to entries show everywhere at once.</span></li>
        </ol>
    </section>
}
else
{
    <section class="type-grid" aria-label="Content types">
        @foreach (var type in Model.Types)
        {
            var single = type.Kind == ContentTypeKind.Single;
            <article class="card type-card">
                <div class="type-card-head">
                    <span class="type-icon" aria-hidden="true"><icon name="@type.Icon" /></span>
                    <div class="type-card-title">
                        <h2 class="card-title"><a href="/admin/content/@type.Slug">@type.Name</a></h2>
                        <span class="text-xs text-subtle">@(single ? "Single entry" : $"{type.EntryCount} entr{(type.EntryCount == 1 ? "y" : "ies")} · {type.PublishedCount} published")</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(type.Description))
                {
                    <p class="text-sm text-muted">@type.Description</p>
                }
                <div class="type-card-actions">
                    <a class="btn btn-secondary btn-sm" href="/admin/content/@type.Slug">@(single ? "Edit" : "Open")</a>
                    @if (!single && Model.CanCreateEntries)
                    {
                        <a class="btn btn-ghost btn-sm" href="/admin/content/@type.Slug/new"><icon name="plus" size="sm" /> New entry</a>
                    }
                </div>
            </article>
        }
    </section>
}
