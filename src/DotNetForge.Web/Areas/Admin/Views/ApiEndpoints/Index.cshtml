@using DotNetForge.Content.Endpoints
@using DotNetForge.Shared.Enums
@model ApiEndpointsIndexViewModel
@{
    ViewData["Title"] = T["API Endpoints"];
    ViewData["Description"] = T["Your own APIs under /api/custom/: each endpoint answers GET, POST, PUT, PATCH or DELETE with its own SQL."];
}

@section Actions {
    <a class="dnf-button dnf-button--primary" href="/admin/api-endpoints/new"><dnf-icon name="plus" /> @T["New endpoint"]</a>
}

<section class="dnf-card" aria-labelledby="endpoints-title" data-collection data-page-size="25">
    <div class="dnf-card__header">
        <div>
            <h2 class="dnf-card__title" id="endpoints-title">@T["Endpoints"]</h2>
            <p class="dnf-card__description" data-collection-count>@T["{0} total", Model.Endpoints.Count]</p>
        </div>
    </div>
    @if (Model.Endpoints.Count == 0)
    {
        <dnf-empty-state icon="code" title="@T["No API endpoints yet"]" description="@T["Give it a path, add its operations - each a method with its own SQL - and call it at /api/custom/your-path."]" />
    }
    else
    {
        <div class="dnf-table dnf-table--stack">
            <table class="dnf-table__table">
                <thead>
                    <tr>
                        <th scope="col" data-sort="text">@T["Name"]</th>
                        <th scope="col" data-sort="text">@T["Path"]</th>
                        <th scope="col">@T["Operations"]</th>
                        <th scope="col">@T["Access"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col" data-sort="date">@T["Updated"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Endpoints)
                    {
                        <tr data-item>
                            <td class="dnf-table__cell--lead">
                                <a class="dnf-table__primary" href="/admin/api-endpoints/@e.Id">@e.Name</a>
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <span class="dnf-table__secondary">@e.Description</span>
                                }
                            </td>
                            <td data-label="@T["Path"]" data-sort-value="@e.Path">
                                <code>/api/custom/@e.Path</code>
                                @if (e.Database is not null)
                                {
                                    <span class="dnf-table__secondary">@T["on database"] <code>@e.Database</code></span>
                                }
                            </td>
                            <td data-label="@T["Operations"]">
                                <span class="dnf-cluster">
                                    @foreach (var operation in Model.Operations[e.Id])
                                    {
                                        <dnf-badge tone="@MethodTone(operation.Method)" class="dnf-badge--mono" title="@operation.Method /api/custom/@CustomEndpointService.Template(e, operation)">@operation.Method@(operation.Path.Length > 0 ? " /" + operation.Path : "")</dnf-badge>
                                    }
                                </span>
                            </td>
                            <td data-label="@T["Access"]">
                                @if (e.Access == EndpointAccess.Public)
                                {
                                    <dnf-badge tone="Warning">@T["Public"]</dnf-badge>
                                }
                                else
                                {
                                    <dnf-badge>@T["Token"]</dnf-badge>
                                }
                            </td>
                            <td data-label="@T["Status"]">
                                @if (e.Enabled)
                                {
                                    <dnf-badge tone="Success" dot="true">@T["Enabled"]</dnf-badge>
                                }
                                else
                                {
                                    <dnf-badge dot="true">@T["Disabled"]</dnf-badge>
                                }
                            </td>
                            <td data-label="@T["Updated"]" data-sort-value="@e.UpdatedDate.ToString("O")"><dnf-timestamp value="@e.UpdatedDate" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="dnf-pagination" data-collection-pagination hidden></div>
    }
</section>

@functions {
    private static DnfTone MethodTone(string method) => method switch
    {
        "GET" => DnfTone.Info,
        "POST" => DnfTone.Success,
        "DELETE" => DnfTone.Danger,
        _ => DnfTone.Warning,
    };
}
