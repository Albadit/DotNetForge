@using DotNetForge.Core.Endpoints
@using DotNetForge.Shared.Enums
@model ApiEndpointEditViewModel
@{
    var input = Model.Input;
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? T["New API endpoint"] : input.Name;
    ViewData["Description"] = isNew
        ? T["Name the API, give it a path and add its operations: GET, POST, PUT, PATCH or DELETE, each with its own SQL."]
        : "/api/custom/" + input.Path + " · " + (Model.Calls.Count == 1 ? T["1 operation"] : T["{0} operations", Model.Calls.Count]);
    var action = isNew ? "/admin/api-endpoints/new" : $"/admin/api-endpoints/{Model.Id}";
    var withToken = input.Access == EndpointAccess.Token;
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    string Curl(string method, string template) =>
        $"curl -X {method} \"{origin}/api/custom/{template}\""
        + (withToken ? $" \\\n  -H \"Authorization: Bearer {Model.Token ?? "<token>"}\"" : "")
        + (method is "POST" or "PUT" or "PATCH" ? " \\\n  -H \"Content-Type: application/json\" -d '{ ... }'" : "");
    DnfTone MethodTone(string method) => method switch { "GET" => DnfTone.Info, "POST" => DnfTone.Success, "DELETE" => DnfTone.Danger, _ => DnfTone.Warning };
}

@section Actions {
    <a class="dnf-button dnf-button--secondary" href="/admin/api-endpoints"><dnf-icon name="chevron-left" /> @T["All endpoints"]</a>
    <button type="submit" form="endpointForm" class="dnf-button dnf-button--primary"><dnf-icon name="save" /> @T["Save endpoint"]</button>
}

<form id="endpointForm" method="post" action="@action" class="dnf-split" novalidate data-endpoint-form
      data-methods="@System.Text.Json.JsonSerializer.Serialize(EndpointRules.Methods)"
      data-types="@System.Text.Json.JsonSerializer.Serialize(EndpointRules.Types)">
    @Html.AntiForgeryToken()
    <div class="dnf-split__main">
        <dnf-validation-summary />
        <section class="dnf-card" aria-labelledby="path-title">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="path-title">@T["Path"]</h2>
                    <p class="dnf-card__description">@T["Where the API lives. Each operation answers this path, or a sub-path of it such as"] <span class="font-mono">{id}</span>. @T["Write"] <span class="font-mono">{name}</span> @T["for a value taken from the URL."]</p>
                </div>
            </div>
            <div class="dnf-card__body">
                <div class="dnf-field">
                    <label class="dnf-field__label" for="Path">@T["Path"]<span class="dnf-field__required" aria-hidden="true">*</span></label>
                    <div class="dnf-input-group">
                        <span class="dnf-input-group__prefix font-mono max-sm:hidden" aria-hidden="true">/api/custom/</span>
                        <input id="Path" name="Path" value="@input.Path" maxlength="200" class="dnf-input dnf-input--mono max-sm:rounded-md" required
                               placeholder="products" aria-describedby="path-hint" data-endpoint-path />
                    </div>
                    <span class="dnf-field__description" id="path-hint">@T["Lower-case letters, digits, '-', '_' and '.'; up to 10 segments together with an operation's sub-path."]</span>
                </div>
            </div>
        </section>

        <section class="dnf-stack" aria-labelledby="operations-title">
            <div class="dnf-spread">
                <div>
                    <h2 class="text-md font-semibold" id="operations-title">@T["Operations"]</h2>
                    <p class="text-sm text-muted">@T["What the API answers: one per method and sub-path, each with its own SQL, parameters and test run."]</p>
                </div>
                <div class="dnf-cluster">
                    <button type="button" class="dnf-button dnf-button--ghost" data-op-toggle-all hidden><dnf-icon name="chevrons-up-down" /> <span data-op-toggle-all-label>@T["Open all"]</span></button>
                    <button type="button" class="dnf-button dnf-button--secondary" data-op-add data-js-only hidden><dnf-icon name="plus" /> @T["Add operation"]</button>
                </div>
            </div>
            @* Holds the place until endpoints.js draws the cards: one opens by itself, several start closed. *@
            <div class="dnf-stack" data-operations data-js-only hidden>
                @if (Model.Calls.Count <= 1)
                {
                    <div class="dnf-skeleton dnf-endpoint-op__placeholder"></div>
                }
                else
                {
                    @for (var i = 0; i < Model.Calls.Count; i++)
                    {
                        <div class="dnf-skeleton dnf-endpoint-op__placeholder dnf-endpoint-op__placeholder--closed"></div>
                    }
                }
            </div>
            <details>
                <summary class="cursor-pointer text-sm text-muted">@T["Operations as JSON"] <span class="text-subtle text-xs">@T["(the cards keep it in sync)"]</span></summary>
                <textarea id="OperationsJson" name="OperationsJson" rows="10" class="dnf-textarea dnf-textarea--code mt-2 text-xs" spellcheck="false"
                          aria-label="@T["Operations as JSON"]" data-operations-source>@input.OperationsJson</textarea>
            </details>
        </section>
    </div>

    <aside class="dnf-split__aside">
        <div class="dnf-card">
            <div class="dnf-card__header"><h2 class="dnf-card__title">@T["Settings"]</h2></div>
            <div class="dnf-card__body dnf-stack">
                <div class="dnf-field">
                    <label class="dnf-field__label" for="Name">@T["Name"]<span class="dnf-field__required" aria-hidden="true">*</span></label>
                    <input id="Name" name="Name" class="dnf-input" value="@input.Name" maxlength="100" required placeholder="@T["Products"]" />
                </div>
                <div class="dnf-field">
                    <label class="dnf-field__label" for="Description">@T["Description"]<span class="dnf-field__optional">@T["optional"]</span></label>
                    <textarea id="Description" name="Description" class="dnf-textarea" rows="2" maxlength="500">@input.Description</textarea>
                </div>
                @if (Model.Databases.Count > 1 || input.Database is not null)
                {
                    @* Additional databases come from DATABASES_<NAME>_* (.docs/database/configuration.md#more-databases). *@
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="Database">@T["Database"]</label>
                        <select id="Database" name="Database" class="dnf-select" aria-describedby="database-hint">
                            @foreach (var database in Model.Databases)
                            {
                                <option value="@database.Name" selected="@(database.Name == input.Database ? "selected" : null)">@database.Label</option>
                            }
                            @if (input.Database is not null && Model.Databases.All(d => d.Name != input.Database))
                            {
                                <option value="@input.Database" selected>@T["{0} (not configured)", input.Database]</option>
                            }
                        </select>
                        <span class="dnf-field__description" id="database-hint">@T["Where the SQL runs. More databases:"] <code>DATABASES_&lt;NAME&gt;_*</code> @T["in the configuration."]</span>
                    </div>
                }
                <fieldset class="dnf-fieldset">
                    <legend class="dnf-fieldset__legend">@T["Who may call it"]</legend>
                    <div class="dnf-choice-cards">
                        <label class="dnf-choice-card">
                            <input type="radio" class="dnf-radio" name="Access" value="Token" checked="@(input.Access == EndpointAccess.Token ? "checked" : null)" />
                            <span>@T["Token"]</span>
                        </label>
                        <label class="dnf-choice-card">
                            <input type="radio" class="dnf-radio" name="Access" value="Public" checked="@(input.Access == EndpointAccess.Public ? "checked" : null)" />
                            <span>@T["Anyone"]</span>
                        </label>
                    </div>
                </fieldset>
                <label class="dnf-switch-row">
                    <span class="dnf-check__text">
                        <span>@T["Enabled"]</span>
                    </span>
                    @* The checkbox first: a bound bool takes the first posted value. *@
                    <input type="checkbox" class="dnf-switch" role="switch" name="Enabled" value="true" checked="@(input.Enabled ? "checked" : null)" />
                    <input type="hidden" name="Enabled" value="false" />
                </label>
            </div>
            <div class="dnf-card__footer">
                <button type="submit" class="dnf-button dnf-button--primary dnf-button--full-width"><dnf-icon name="save" /> @T["Save endpoint"]</button>
            </div>
        </div>

        @if (!isNew)
        {
            <section class="dnf-card" aria-labelledby="call-title">
                <div class="dnf-card__header">
                    <div>
                        <h2 class="dnf-card__title" id="call-title">@T["Call it"]</h2>
                        @if (!withToken)
                        {
                            <p class="dnf-card__description">@T["Anyone can call it, no token needed."]</p>
                        }
                    </div>
                </div>
                <div class="dnf-card__body dnf-stack dnf-stack--sm">
                    @if (withToken)
                    {
                        <span class="text-sm font-semibold">@T["Token"]</span>
                        @if (Model.Token is null)
                        {
                            <p class="text-sm text-muted">@T["This endpoint has no token yet. Generate one below."]</p>
                        }
                        else
                        {
                            <div class="flex min-w-0 items-center gap-2">
                                <code class="min-w-0 flex-1 truncate text-xs" title="@Model.Token">@Model.Token</code>
                                <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-copy-text="@Model.Token" aria-label="@T["Copy the token"]" data-tooltip="@T["Copy token"]"><dnf-icon name="copy" size="Sm" /></button>
                            </div>
                        }
                    }
                    @if (Model.Calls.Count > 0)
                    {
                        <span class="text-sm font-semibold">@T["Operations"] <span class="ms-1 font-normal text-subtle">@T["under /api/custom - copy a ready curl command"]</span></span>
                        <ul class="flex flex-col gap-1">
                            @foreach (var (operation, template) in Model.Calls)
                            {
                                var route = $"/api/custom/{template}";
                                <li class="flex min-w-0 items-center gap-2">
                                    <dnf-badge tone="@MethodTone(operation.Method)" class="dnf-badge--mono">@operation.Method</dnf-badge>
                                    <code class="min-w-0 flex-1 truncate text-xs" title="@(string.IsNullOrEmpty(operation.Name) ? route : $"{operation.Name}: {route}")">/@template</code>
                                    <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-copy-text="@Curl(operation.Method, template)"
                                            aria-label="@T["Copy the curl command for {0}", operation.Method + " " + route]" data-tooltip="@T["Copy curl"]"><dnf-icon name="copy" size="Sm" /></button>
                                </li>
                            }
                        </ul>
                    }
                    <a class="dnf-button dnf-button--secondary dnf-button--sm dnf-button--full-width" href="/admin/api-docs"><dnf-icon name="book" size="Sm" /> @T["Try it in the API docs"]</a>
                    @if (withToken)
                    {
                        <button type="submit" form="tokenForm" class="dnf-button dnf-button--ghost dnf-button--sm dnf-button--full-width"
                                data-confirm="@T["Create a new token for '{0}'? Apps using the current token get 401 until they switch.", input.Name]"
                                data-confirm-title="@T["Regenerate token"]" data-confirm-action="@T["Regenerate"]">
                            <dnf-icon name="rotate-ccw" size="Sm" /> @(Model.Token is null ? T["Generate token"] : T["Regenerate token"])
                        </button>
                    }
                </div>
            </section>

            <section class="dnf-card dnf-card--danger" aria-labelledby="delete-title">
                <div class="dnf-card__header"><h2 class="dnf-card__title" id="delete-title">@T["Delete endpoint"]</h2></div>
                <div class="dnf-card__body dnf-stack dnf-stack--sm">
                    <button type="submit" form="deleteEndpointForm" class="dnf-button dnf-button--danger-soft dnf-button--full-width"
                            data-confirm="@T["Delete '{0}' and its operations? Apps calling them get 404. This can't be undone.", input.Name]"
                            data-confirm-title="@T["Delete endpoint"]" data-confirm-action="@T["Delete"]">
                        <dnf-icon name="trash" /> @T["Delete endpoint"]
                    </button>
                </div>
            </section>
        }
    </aside>
</form>

@if (!isNew)
{
    <form id="deleteEndpointForm" method="post" action="/admin/api-endpoints/@Model.Id/delete" hidden>
        @Html.AntiForgeryToken()
    </form>
    <form id="tokenForm" method="post" action="/admin/api-endpoints/@Model.Id/token" hidden>
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts {
    <script src="~/js/admin/endpoints.js" asp-append-version="true" data-screen defer></script>
}
