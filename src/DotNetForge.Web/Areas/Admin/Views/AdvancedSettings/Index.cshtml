@model AdvancedSettingsViewModel
@{
    ViewData["PageWidth"] = "medium";
    ViewData["Title"] = T["Advanced Settings"];
    ViewData["Description"] = T["How people get an account on the site: sign-ups, the role they get, and email confirmation."];
    var authenticatedId = Model.Roles.FirstOrDefault(r => r.Name == DotNetForge.Shared.Constants.Roles.Authenticated).Id;
    var selectedRole = Model.DefaultRoleId ?? authenticatedId;
}

<form method="post" action="/admin/advanced-settings" class="dnf-stack">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />
    <fieldset class="dnf-fieldset dnf-stack" disabled="@(Model.CanEdit ? null : "disabled")">
        <legend class="sr-only">@T["Advanced user settings"]</legend>

        <section class="dnf-card" aria-labelledby="signups-title">
            <div class="dnf-card__header"><h2 class="dnf-card__title" id="signups-title">@T["Sign-ups"]</h2></div>
            <div class="dnf-card__body dnf-stack">
                <label class="dnf-switch-row">
                    <span class="dnf-check__text">
                        <span>@T["Enable sign-ups"]</span>
                        <span class="dnf-check__description">@T["Visitors can create an account at"] <code>/register</code>, @T["and the sign-in page links to it; signing in with a provider (Providers) creates an account for a new email. When off,"] <code>/register</code> @T["answers 404 and providers sign in existing accounts only."]</span>
                    </span>
                    @* The checkbox first: a bound bool takes the first posted value. *@
                    <input type="checkbox" class="dnf-switch" role="switch" name="SignUps" value="true" checked="@(Model.SignUps ? "checked" : null)" />
                    <input type="hidden" name="SignUps" value="false" />
                </label>
                <div class="dnf-field">
                    <label class="dnf-field__label" for="DefaultRoleId">@T["Default role for new accounts"]</label>
                    <select id="DefaultRoleId" class="dnf-select" name="DefaultRoleId" aria-describedby="role-hint">
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Id" selected="@(role.Id == selectedRole ? "selected" : null)">@role.Name@(role.OpensAdmin ? " " + T["(opens the admin)"] : "")</option>
                        }
                    </select>
                    <span class="dnf-field__description" id="role-hint">@T["Authenticated is a site-only role: signed in, but no admin. Only a Super Admin can choose a role that opens the admin."]</span>
                </div>
                <p class="dnf-note text-sm text-muted"><dnf-icon name="info" size="Sm" /><span>@T["One account per email address - always on: a sign-up with an email that already has an account is refused."]</span></p>
            </div>
        </section>

        <section class="dnf-card" aria-labelledby="email-title">
            <div class="dnf-card__header"><h2 class="dnf-card__title" id="email-title">@T["Confirmation and password reset"]</h2></div>
            <div class="dnf-card__body dnf-stack">
                @if (!Model.EmailConfigured)
                {
                    <dnf-alert tone="Warning" title="@T["Email is not configured"]">@T["Set the SMTP server with"] <code>SMTP_*</code> @T["in"] <code>.env</code> (@T["see"] <a href="/admin/email/configuration">@T["Email › Configuration"]</a>). @T["Until then email confirmation stays off and the sign-in page has no \"Forgot password?\" link."]</dnf-alert>
                }
                <label class="dnf-switch-row">
                    <span class="dnf-check__text">
                        <span>@T["Enable email confirmation"]</span>
                        <span class="dnf-check__description">@T["New accounts get a confirmation link and can't sign in until they open it. Accounts created on the Users screen are confirmed already."]</span>
                    </span>
                    <input type="checkbox" class="dnf-switch" role="switch" name="EmailConfirmation" value="true"
                           checked="@(Model.EmailConfirmation ? "checked" : null)" disabled="@(Model.EmailConfigured ? null : "disabled")" />
                    <input type="hidden" name="EmailConfirmation" value="false" />
                </label>
                <div class="dnf-field">
                    <label class="dnf-field__label" for="ResetPasswordUrl">@T["Reset password page"]<span class="dnf-field__optional">@T["optional"]</span></label>
                    <input id="ResetPasswordUrl" class="dnf-input" name="ResetPasswordUrl" type="url" value="@Model.ResetPasswordUrl" placeholder="https://app.example.com/reset-password" aria-describedby="reset-hint" />
                    <span class="dnf-field__description" id="reset-hint">@T["For a front end with its own page: reset links point there with"] <code>?token=</code>, @T["and it posts a form with"] <code>token</code>, <code>password</code> @T["and"] <code>confirmPassword</code> @T["to"] <code>/reset-password</code>. @T["Empty: the built-in page."]</span>
                </div>
                <div class="dnf-field">
                    <label class="dnf-field__label" for="ConfirmationRedirectUrl">@T["Redirection after email confirmation"]<span class="dnf-field__optional">@T["optional"]</span></label>
                    <input id="ConfirmationRedirectUrl" class="dnf-input" name="ConfirmationRedirectUrl" type="url" value="@Model.ConfirmationRedirectUrl" placeholder="https://app.example.com/welcome" aria-describedby="confirm-hint" />
                    <span class="dnf-field__description" id="confirm-hint">@T["Where people land after opening the confirmation link. Empty: the sign-in page."]</span>
                </div>
            </div>
            @if (Model.CanEdit)
            {
                @* One form across both cards: this saves the sign-up settings too. *@
                <div class="dnf-card__footer">
                    <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="check" /> @T["Save settings"]</button>
                </div>
            }
        </section>
    </fieldset>
</form>
