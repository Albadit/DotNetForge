@using DotNetForge.Web.Services
@model IReadOnlyList<EmailTemplateState>
@{
    ViewData["Title"] = "Email Templates";
    ViewData["Description"] = "The emails the CMS sends. Change a subject or body; restore the default at any time.";
}

<section class="dnf-card" aria-labelledby="templates-title">
    <div class="dnf-card__header">
        <h2 class="dnf-card__title" id="templates-title">Templates</h2>
    </div>
    <div class="dnf-table dnf-table--stack">
        <table class="dnf-table__table">
            <thead>
                <tr>
                    <th scope="col">Template</th>
                    <th scope="col">Sent when</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="dnf-table__cell--lead">
                            <a class="dnf-table__primary" href="/admin/email/templates/@t.Definition.Key">@t.Definition.Name</a>
                            <span class="dnf-table__secondary font-mono">@t.Definition.Key</span>
                        </td>
                        <td data-label="Sent when" class="text-muted">@t.Definition.Trigger</td>
                        <td data-label="Status">
                            @if (t.IsCustomized)
                            {
                                <dnf-badge tone="Info" dot="true">Customized</dnf-badge>
                                <span class="dnf-table__secondary"><dnf-timestamp value="@t.UpdatedDate" /></span>
                            }
                            else
                            {
                                <dnf-badge tone="Neutral" dot="true">Default</dnf-badge>
                            }
                        </td>
                        <td class="dnf-table__cell--actions">
                            <a class="dnf-button dnf-button--ghost dnf-button--sm" href="/admin/email/templates/@t.Definition.Key"><dnf-icon name="pencil" size="Sm" /> Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
