@model EmailTemplatesController.EmailTemplateEditViewModel
@{
    var definition = Model.State.Definition;
    ViewData["Title"] = definition.Name;
    ViewData["Description"] = "Sent when: " + definition.Trigger;
    var action = "/admin/email/templates/" + definition.Key;
    // For the code editor (email-templates.js): IntelliSense, validation and highlighting of {{variables}}.
    var variablesJson = System.Text.Json.JsonSerializer.Serialize(definition.Variables.Select(v => new
    {
        name = v,
        required = definition.Required.Contains(v),
        sample = definition.SampleValues.GetValueOrDefault(v) ?? string.Empty,
    }));
}

@section Actions {
    <a class="dnf-button dnf-button--ghost" href="/admin/email/templates"><dnf-icon name="chevron-left" /> All templates</a>
}

<div class="dnf-split">
    <div class="dnf-split__main">
        <form method="post" action="@action" id="templateForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="version" value="@Model.Version" />
            <section class="dnf-card" aria-labelledby="template-title">
                <div class="dnf-card__header">
                    <div>
                        <h2 class="dnf-card__title" id="template-title">Message</h2>
                        <p class="dnf-card__description">
                            @if (Model.State.IsCustomized)
                            {
                                <dnf-badge tone="Info" dot="true">Customized</dnf-badge> <span>Saved <dnf-timestamp value="@Model.State.UpdatedDate" /></span>
                            }
                            else
                            {
                                <dnf-badge tone="Neutral" dot="true">Default</dnf-badge>
                            }
                        </p>
                    </div>
                </div>
                <fieldset class="dnf-fieldset dnf-card__body dnf-stack" disabled="@(Model.CanEdit ? null : "disabled")">
                    <legend class="sr-only">Message</legend>
                    <dnf-validation-summary />
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="subject">Subject<span class="dnf-field__required" aria-hidden="true">*</span></label>
                        <input id="subject" name="subject" class="dnf-input" value="@Model.Subject" required maxlength="500" />
                    </div>
                    <div class="dnf-field">
                        <label class="dnf-field__label" for="body">Body (HTML)<span class="dnf-field__required" aria-hidden="true">*</span></label>
                        @* Replaced by the Monaco editor when its scripts load; it stays the form field either way. *@
                        <textarea id="body" name="body" rows="14" required maxlength="20000" class="dnf-textarea dnf-textarea--code min-h-64" spellcheck="false" aria-describedby="body-hint"
                                  data-code-editor="html" data-template-variables="@variablesJson">@Model.Body</textarea>
                        <div class="dnf-code-editor" data-code-editor-frame hidden>
                            <div class="dnf-code-editor__surface" data-code-editor-host></div>
                            @* Filled by email-templates.js from the editor. *@
                            <div class="dnf-code-editor__status" role="group" aria-label="Editor status" data-code-editor-status>
                                <button type="button" class="dnf-code-editor__item" data-status-problems
                                        aria-label="Go to the next problem" data-tooltip="Go to the next problem (F8)">
                                    <span class="dnf-code-editor__count dnf-code-editor__count--errors"><dnf-icon name="circle-x" size="Sm" /><span data-status-errors>0</span></span>
                                    <span class="dnf-code-editor__count dnf-code-editor__count--warnings"><dnf-icon name="triangle-alert" size="Sm" /><span data-status-warnings>0</span></span>
                                </button>
                                <span class="flex-1"></span>
                                <span class="dnf-code-editor__item" data-status-position>Ln 1, Col 1</span>
                                <span class="dnf-code-editor__item" data-status-length data-max="@DotNetForge.Core.Email.EmailTemplateRenderer.MaxBodyLength"></span>
                                <span class="dnf-code-editor__item">Spaces: 2</span>
                                <span class="dnf-code-editor__item">HTML</span>
                                <button type="button" class="dnf-code-editor__item" data-status-wrap aria-pressed="true"
                                        data-tooltip="Wrap long lines (Alt+Z)">
                                    <dnf-icon name="wrap-text" size="Sm" /> Wrap
                                </button>
                            </div>
                        </div>
                        <span class="dnf-field__description" id="body-hint">Use the variables on the right as <code>{{name}}</code>. Their values are HTML-encoded; scripts don't run in email clients.</span>
                    </div>
                </fieldset>
                @if (Model.CanEdit)
                {
                    <div class="dnf-card__footer">
                        @if (Model.State.IsCustomized)
                        {
                            <button type="submit" form="restoreForm" class="dnf-button dnf-button--ghost"
                                    data-confirm="Replace your version of '@definition.Name' with the default? Your changes are lost."
                                    data-confirm-title="Restore default" data-confirm-action="Restore">
                                <dnf-icon name="rotate-ccw" /> Restore default
                            </button>
                        }
                        <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="check" /> Save template</button>
                    </div>
                }
            </section>
        </form>
        <form method="post" action="@action/restore" id="restoreForm">
            @Html.AntiForgeryToken()
        </form>
        @* email-templates.js copies the editor's text here and posts it into the preview frame while you type. *@
        <form method="post" action="@action/preview" target="email-preview" id="previewForm" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="subject" />
            <input type="hidden" name="body" />
        </form>

        <section class="dnf-card" aria-labelledby="preview-title">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="preview-title">Preview</h2>
                    <p class="dnf-card__description">The email as it is sent, with sample data. Follows your changes as you type; nothing is sent.</p>
                </div>
                @* Renders the editor's text again, e.g. after a link in the preview navigated the frame away (email-templates.js). *@
                <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm" data-preview-refresh data-js-only hidden
                        aria-controls="email-preview" data-tooltip="Render the preview again">
                    <dnf-icon name="refresh-cw" size="Sm" /> Refresh
                </button>
            </div>
            <div class="dnf-card__body">
                @* Administrator-written HTML: sandboxed (no scripts, no forms) and served with its own strict policy. *@
                <iframe id="email-preview" name="email-preview" class="dnf-email-preview" title="Email preview" sandbox src="@action/preview"></iframe>
            </div>
        </section>
    </div>

    <aside class="dnf-split__aside">
        <section class="dnf-card" aria-labelledby="variables-title">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="variables-title">Variables</h2>
                    <p class="dnf-card__description">Only these work in this template.</p>
                </div>
            </div>
            <ul class="dnf-card__body flex flex-col gap-3">
                @foreach (var variable in definition.Variables)
                {
                    var token = "{{" + variable + "}}";
                    <li class="flex flex-col gap-1">
                        <div class="flex items-center justify-between gap-2">
                            <code>@token</code>
                            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-copy-text="@token" aria-label="Copy @token" data-tooltip="Copy"><dnf-icon name="copy" size="Sm" /></button>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
                            @if (definition.Required.Contains(variable))
                            {
                                <dnf-badge tone="Warning">Required</dnf-badge>
                            }
                            <span class="min-w-0 wrap-anywhere">e.g. @definition.SampleValues.GetValueOrDefault(variable)</span>
                        </div>
                    </li>
                }
            </ul>
        </section>
    </aside>
</div>

@section Scripts {
    @* Monaco (self-hosted, wwwroot/lib/monaco, MIT) - its AMD loader first; email-templates.js starts the editor. *@
    <script src="~/lib/monaco/vs/loader.js" defer></script>
    <script src="~/js/admin/email-templates.js" asp-append-version="true" defer></script>
}
