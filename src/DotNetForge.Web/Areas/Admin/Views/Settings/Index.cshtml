@model SettingsIndexViewModel
@{
    ViewData["Title"] = "Settings";
    ViewData["Description"] = $"Key/value settings for {Model.AppName}. Saving creates a key or updates its value.";
}

<div class="dnf-split dnf-split--wide-aside">
    <div class="dnf-split__main">
        <section class="dnf-card" aria-labelledby="settings-title" data-collection data-page-size="25">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="settings-title">All settings</h2>
                    <p class="dnf-card__description" data-collection-count>@Model.Settings.Count total</p>
                </div>
            </div>
            @if (Model.Settings.Count == 0)
            {
                <dnf-empty-state icon="settings" title="No settings yet" description="Add the first key/value pair with the form." />
            }
            else
            {
                <div class="dnf-toolbar" data-js-only hidden>
                    <div class="dnf-toolbar__search dnf-input-group">
                        <dnf-icon name="search" size="Sm" class="dnf-input-group__icon" />
                        <label class="sr-only" for="settings-search">Search settings</label>
                        <input id="settings-search" type="search" class="dnf-input dnf-input--sm" placeholder="Search keys and values" data-collection-search />
                    </div>
                </div>
                <div class="dnf-table dnf-table--stack">
                    <table class="dnf-table__table">
                        <thead>
                            <tr><th scope="col" data-sort="text">Key</th><th scope="col">Value</th><th scope="col" class="dnf-table__cell--actions"><span class="sr-only">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Settings)
                            {
                                <tr data-item>
                                    <td class="dnf-table__cell--lead"><code>@s.Key</code></td>
                                    <td data-label="Value" class="text-muted">@(string.IsNullOrEmpty(s.Value) ? "(empty)" : s.Value)</td>
                                    <td class="dnf-table__cell--actions">
                                        <button type="button" class="dnf-button dnf-button--ghost dnf-button--sm" data-fill="#settingForm" data-fill-key="@s.Key" data-fill-value="@s.Value"
                                                data-js-only hidden aria-label="Edit @s.Key"><dnf-icon name="pencil" size="Sm" /> Edit</button>
                                    </td>
                                </tr>
                            }
                            <tr class="dnf-table__empty" data-collection-empty hidden><td colspan="3">No setting matches the search.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="dnf-pagination" data-collection-pagination hidden></div>
            }
        </section>
    </div>

    <div class="dnf-split__aside">
        <section class="dnf-card" aria-labelledby="setting-form-title">
            <div class="dnf-card__header">
                <div>
                    <h2 class="dnf-card__title" id="setting-form-title">Add or update</h2>
                    <p class="dnf-card__description">An existing key is overwritten.</p>
                </div>
            </div>
            <form method="post" asp-area="Admin" asp-controller="Settings" asp-action="Save" class="dnf-card__body dnf-form" id="settingForm">
                @Html.AntiForgeryToken()
                <dnf-validation-summary />
                <div class="dnf-field">
                    <label class="dnf-field__label" for="key">Key<span class="dnf-field__required" aria-hidden="true">*</span></label>
                    <input id="key" name="key" required class="dnf-input dnf-input--mono" placeholder="site.tagline" autocomplete="off" />
                </div>
                <div class="dnf-field">
                    <label class="dnf-field__label" for="value">Value<span class="dnf-field__optional">optional</span></label>
                    <textarea id="value" class="dnf-textarea" name="value" rows="3"></textarea>
                </div>
                <div class="dnf-form-actions dnf-form-actions--end">
                    <button type="reset" class="dnf-button dnf-button--ghost">Clear</button>
                    <button type="submit" class="dnf-button dnf-button--primary"><dnf-icon name="check" /> Save setting</button>
                </div>
            </form>
        </section>
    </div>
</div>
