@model SetupRequest
@{
    ViewData["Title"] = "Setup";
    Layout = "_AuthLayout";
}

<h2>Welcome - let's get set up</h2>
<p class="muted">Create the first administrator. This account becomes the <strong>Super Admin</strong>.</p>

<div asp-validation-summary="All" class="validation-summary"></div>

<form method="post" asp-controller="Setup" asp-action="Index">
    @Html.AntiForgeryToken()
    <div class="form-row two">
        <div>
            <label asp-for="FirstName">First name</label>
            <input asp-for="FirstName" autocomplete="given-name" />
        </div>
        <div>
            <label asp-for="LastName">Last name</label>
            <input asp-for="LastName" autocomplete="family-name" />
        </div>
    </div>
    <div class="form-row">
        <label asp-for="Email">Email <span class="req">*</span></label>
        <input asp-for="Email" type="email" required autocomplete="username" />
    </div>
    <div class="form-row">
        <label asp-for="Password">Password <span class="req">*</span></label>
        <input asp-for="Password" type="password" required autocomplete="new-password" />
        <small class="muted">At least 8 characters, including a letter and a number.</small>
    </div>
    <div class="form-row">
        <label asp-for="ConfirmPassword">Confirm password <span class="req">*</span></label>
        <input asp-for="ConfirmPassword" type="password" required autocomplete="new-password" />
    </div>
    <button type="submit" class="btn primary">Create admin &amp; install</button>
</form>
