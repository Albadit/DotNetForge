@model SetupRequest
@{
    ViewData["Title"] = "Setup";
    Layout = "_AuthLayout";
}

<div class="dnf-auth__heading">
    <h1>Welcome to DotNetForge</h1>
    <p class="text-muted">Create the first administrator. This account becomes the <strong>Super Admin</strong>, with full access to every setting.</p>
</div>

<form method="post" asp-controller="Setup" asp-action="Index" class="dnf-form">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />
    <partial name="_AccountFields" model="Model" />
    <button type="submit" class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width">Create admin and install</button>
</form>
