@model List<(string Title, string Slug)>
@{
    ViewData["Title"] = null;
    var appName = ViewData["AppName"] as string ?? "DotNetForge CMS";
    var publishedCount = (int)(ViewData["PublishedCount"] ?? 0);
}

<section class="site-hero">
    <h1>@appName</h1>
    <p class="site-lead">A modular, secure, hybrid CMS built on ASP.NET Core MVC.</p>
    <p class="text-muted">The CMS is installed and running. This is the built-in public site - enable a theme on the
        <a href="/admin/plugins">Plugins</a> screen to give it your own look.</p>
</section>

<section class="stack" aria-labelledby="pages-title">
    <h2 id="pages-title">Published pages</h2>
    @if (publishedCount == 0)
    {
        <div class="card">
            <empty-state icon="pages" title="Nothing published yet" text="Create and publish a page in Pages.">
                <a class="btn btn-primary" href="/admin/pages">Open Pages</a>
            </empty-state>
        </div>
    }
    else
    {
        <ul class="card site-page-list">
            @foreach (var item in Model)
            {
                <li><a href="/@item.Slug">@item.Title <icon name="arrow-right" size="sm" /></a> <span class="text-subtle text-sm">/@item.Slug</span></li>
            }
        </ul>
    }
</section>
