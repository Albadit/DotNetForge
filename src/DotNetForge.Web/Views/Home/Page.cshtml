@using DotNetForge.Shared.Entities
@using DotNetForge.Web.Services
@model Page
@{
    var draft = ViewData["DraftPreview"] as bool? == true;
    var canvas = ViewData["BuilderCanvas"] as bool? == true;
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;
    ViewData["MetaDescription"] = Model.MetaDescription;
    ViewData["CanonicalUrl"] = Model.CanonicalUrl;
    ViewData["NoIndex"] = Model.NoIndex || draft;
    ViewData["SocialImage"] = Model.SocialImageUrl;
    var routeValues = ViewData["RouteValues"] as IDictionary<string, string>;
    var hasLayout = canvas || (draft ? PageBuilderService.EditableJson(Model) : Model.LayoutJson) is not null;
    ViewData["FullWidth"] = hasLayout;
}

@if (draft)
{
    <div class="site-preview-bar" role="status">Preview of the unpublished draft. Visitors don't see these changes until you publish.</div>
}

@if (hasLayout)
{
    @* The page builder layout (.docs/features/page-builder.md#rendering). *@
    <h1 class="sr-only">@Model.Title</h1>
    @await Component.InvokeAsync("PageLayout", new { page = Model, draft })
    @await Component.InvokeAsync("ExtensionModules", new { page = Model })
}
else
{
    <article class="site-article">
        <header class="stack-sm">
            <h1>@Model.Title</h1>
            <p class="text-subtle text-sm text-mono">/@Model.Slug.TrimStart('/')</p>
            @if (routeValues is { Count: > 0 })
            {
                <p class="text-muted text-sm">Dynamic route: @string.Join(", ", routeValues.Select(kv => $"{kv.Key} = {kv.Value}"))</p>
            }
        </header>

        @await Component.InvokeAsync("ExtensionModules", new { page = Model })

        <alert tone="Info" title="No content yet">
            This page is published but has no layout yet. Design it in the <a href="/admin/content?selected=@Model.Id#layout">Content Manager</a>
            (Layout tab), or enable a theme to style the site.
        </alert>
    </article>
}
