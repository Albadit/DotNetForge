@using System.Security.Claims
@using DotNetForge.Shared.Constants
@using DotNetForge.Shared.Content
@{
    var appName = ViewData["AppName"] as string ?? "DotNetForge CMS";
    // Top-level live pages marked "display in menu" (HomeController); the current one is highlighted.
    var menu = ViewData["Menu"] as IReadOnlyList<PublishedPage> ?? Array.Empty<PublishedPage>();
    var current = Context.Request.Path.Value?.TrimEnd('/') is { Length: > 0 } path ? path : "/";
    // The Admin link only for signed-in users who may enter the admin; visitors don't see it.
    var canEnterAdmin = User.Identity?.IsAuthenticated == true && Roles.CanEnterAdmin(User.FindAll(ClaimTypes.Role).Select(c => c.Value));
    var title = ViewData["Title"] as string;
    var description = ViewData["MetaDescription"] as string;
    var canonical = ViewData["CanonicalUrl"] as string;
    var noIndex = ViewData["NoIndex"] as bool? == true;
    var socialImage = ViewData["SocialImage"] as string;
    var fullWidth = ViewData["FullWidth"] as bool? == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(string.IsNullOrEmpty(title) ? appName : $"{title} · {appName}")</title>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description" />
    }
    @if (!string.IsNullOrWhiteSpace(canonical))
    {
        <link rel="canonical" href="@canonical" />
    }
    @if (noIndex)
    {
        <meta name="robots" content="noindex" />
    }
    @if (!string.IsNullOrWhiteSpace(title))
    {
        <meta property="og:title" content="@title" />
    }
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta property="og:description" content="@description" />
    }
    @if (!string.IsNullOrWhiteSpace(socialImage))
    {
        <meta property="og:image" content="@(socialImage.StartsWith('/') ? $"{Context.Request.Scheme}://{Context.Request.Host}{socialImage}" : socialImage)" />
    }
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <script src="~/_content/DotNetForge.UI/dnf-theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/_content/DotNetForge.UI/dnf.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@*
    The built-in public layout (.docs/architecture/design-system.md#public-fallback): used for the site root, content
    pages and the error page while no theme extension is enabled. An enabled theme replaces these views entirely.
    Styles: the Dnf components (dnf.css) plus /css/site.css. No dnf.js: nothing here needs a behaviour (no toasts, no
    theme menu); dnf-theme.js still applies a saved light/dark choice.
*@
<body class="dnf-site">
    <a class="dnf-skip-link" href="#main">Skip to content</a>
    <header class="dnf-site__header">
        <div class="dnf-site__wrap">
            <a class="dnf-site__brand" href="/">
                <img src="~/img/logo-mark.svg" alt="" width="28" height="28" />
                <span>@appName</span>
            </a>
            @if (menu.Count > 0)
            {
                <nav class="dnf-site__nav" aria-label="Site">
                    @foreach (var item in menu)
                    {
                        var active = string.Equals(item.Path, current, StringComparison.OrdinalIgnoreCase);
                        <a href="@item.Path" aria-current="@(active ? "page" : null)">@item.Title</a>
                    }
                </nav>
            }
            @if (canEnterAdmin)
            {
                <a class="dnf-button dnf-button--secondary dnf-button--sm" href="/admin">Admin <dnf-icon name="chevron-right" size="Sm" /></a>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                @* A site-only account (e.g. one that signed up at /register) signs out here; admins do it in the admin. *@
                <form method="post" action="/account/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dnf-button dnf-button--secondary dnf-button--sm"><dnf-icon name="log-out" size="Sm" /> Sign out</button>
                </form>
            }
        </div>
    </header>
    @* A page builder layout spans the full width (its sections set their own content width). *@
    <main id="main" class="@(fullWidth ? "dnf-site__main dnf-site__main--full" : "dnf-site__wrap dnf-site__main")" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="dnf-site__footer">
        <div class="dnf-site__wrap">Powered by DotNetForge CMS</div>
    </footer>
</body>
</html>
