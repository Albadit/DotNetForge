@{
    var appName = ViewData["AppName"] as string ?? "DotNetForge CMS";
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@(title is null ? "" : title + " · ")@appName</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <script src="~/_content/DotNetForge.UI/dnf-theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/_content/DotNetForge.UI/dnf.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <script src="~/_content/DotNetForge.UI/dnf.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Head", required: false)
</head>
@*
    Setup, sign-in and access denied (.docs/architecture/design-system.md#auth-layout). Built-in and isolated from
    public themes (.docs/features/themes.md). Styles: the Dnf components (dnf.css) plus /css/auth.css.
*@
<body>
    <a class="dnf-skip-link" href="#main">Skip to content</a>
    <div class="dnf-auth">
        <aside class="dnf-auth__panel">
            <img class="dnf-auth__logo block dark:hidden" src="~/img/logo.svg" alt="DotNetForge" width="196" height="48" />
            <img class="dnf-auth__logo hidden dark:block" src="~/img/logo-dark.svg" alt="DotNetForge" width="196" height="48" />
            <div class="dnf-auth__pitch">
                <p class="dnf-auth__pitch-title">Build, publish and extend - from one place.</p>
                <ul class="dnf-auth__points">
                    <li class="dnf-auth__point"><dnf-icon name="pages" /> Pages, media and SEO in a clean editor</li>
                    <li class="dnf-auth__point"><dnf-icon name="puzzle" /> Extensions without touching the core</li>
                    <li class="dnf-auth__point"><dnf-icon name="shield" /> Roles, audit log and scoped API tokens</li>
                </ul>
            </div>
            <span class="dnf-auth__forge" aria-hidden="true"><span></span><span></span><span></span></span>
        </aside>

        <main class="dnf-auth__main" id="main" tabindex="-1">
            <div class="dnf-auth__top">
                <a class="dnf-auth__mobile-brand" href="/" aria-label="@appName home">
                    <img src="~/img/logo-mark.svg" alt="" width="32" height="32" />
                    <span>@appName</span>
                </a>
                <partial name="_ThemeMenu" />
            </div>
            <div class="dnf-auth__card">
                @RenderBody()
            </div>
            <p class="dnf-auth__foot">@appName · Powered by DotNetForge</p>
        </main>
    </div>
    <partial name="_Feedback" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
