@{
    var appName = ViewData["AppName"] as string ?? "DotNetForge CMS";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")@appName</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
@*
    The setup and login pages use this dedicated, built-in layout. They are intentionally isolated
    from public frontend themes (.docs/architecture/pages.md / .docs/features/themes.md).
*@
<body class="auth">
    <div class="auth-card">
        <h1 class="auth-brand">@appName</h1>
        @RenderBody()
    </div>
</body>
</html>
