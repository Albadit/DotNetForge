@*
    The feedback layer of every built-in layout (.docs/architecture/design-system.md#feedback):
    - toasts for TempData["Success"] (auto-hides), TempData["Error"] and TempData["Info"] (stay until dismissed);
      screens set TempData and redirect (PRG) - they never render their own flash markup;
    - the confirmation dialog used by every form with data-confirm="question" (dnf.js; falls back to window.confirm).
    dnf.js fills #dnf-toast-template for dnfUI.toast() and the [data-confirm-*] parts of #dnf-confirm-dialog.
*@
@{
    var toasts = new List<(string Tone, string Icon, string Message)>();
    if (TempData["Success"] is string success) { toasts.Add(("success", "circle-check", success)); }
    if (TempData["Error"] is string error) { toasts.Add(("danger", "circle-x", error)); }
    if (TempData["Info"] is string info) { toasts.Add(("info", "info", info)); }
}
<div class="dnf-toast-region" data-toasts aria-live="polite">
    @foreach (var toast in toasts)
    {
        <div class="dnf-toast dnf-toast--@toast.Tone" role="@(toast.Tone == "danger" ? "alert" : "status")"
             data-toast data-autohide="@(toast.Tone == "success" ? "true" : null)">
            <dnf-icon name="@toast.Icon" class="dnf-toast__icon" />
            <p class="dnf-toast__message">@toast.Message</p>
            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-toast-close aria-label="Dismiss">
                <dnf-icon name="x" size="Sm" />
            </button>
        </div>
    }
</div>

<template id="dnf-toast-template">
    <div class="dnf-toast" role="status" data-toast>
        <dnf-icon name="info" class="dnf-toast__icon" />
        <p class="dnf-toast__message"></p>
        <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm" data-toast-close aria-label="Dismiss">
            <dnf-icon name="x" size="Sm" />
        </button>
    </div>
</template>

<dialog class="dnf-dialog" id="dnf-confirm-dialog" aria-labelledby="confirm-title" aria-describedby="confirm-text">
    <form method="dialog">
        <div class="dnf-dialog__header">
            <span class="dnf-dialog__icon dnf-dialog__icon--danger" data-confirm-icon><dnf-icon name="triangle-alert" /></span>
            <div>
                <h2 class="dnf-dialog__title" id="confirm-title" data-confirm-title>Are you sure?</h2>
                <p class="dnf-dialog__description" id="confirm-text" data-confirm-text></p>
            </div>
        </div>
        <div class="dnf-dialog__footer">
            <button type="submit" value="cancel" class="dnf-button dnf-button--secondary">Cancel</button>
            <button type="submit" value="confirm" class="dnf-button dnf-button--danger" data-confirm-ok>Confirm</button>
        </div>
    </form>
</dialog>
