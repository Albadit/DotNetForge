@{
    ViewData["Title"] = "Access denied";
    Layout = "_AuthLayout";
}

<div class="dnf-auth__heading dnf-auth__heading--state">
    <span class="dnf-dialog__icon dnf-dialog__icon--danger" aria-hidden="true"><dnf-icon name="lock" /></span>
    <h1>Access denied</h1>
    <p class="text-muted">Your account doesn't have permission to open this page. Ask an administrator if you need access.</p>
</div>

<div class="dnf-stack dnf-stack--sm">
    <a class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width" href="/admin"><dnf-icon name="chevron-left" /> Back to the dashboard</a>
    <form method="post" asp-controller="Account" asp-action="Logout">
        @Html.AntiForgeryToken()
        <button type="submit" class="dnf-button dnf-button--secondary dnf-button--lg dnf-button--full-width"><dnf-icon name="log-out" /> Sign in as someone else</button>
    </form>
</div>
