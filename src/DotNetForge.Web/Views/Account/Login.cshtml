@using DotNetForge.Sdk
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var email = ViewData["Email"] as string;
    var rememberMe = ViewData["RememberMe"] as bool? == true;
    var providers = ViewData["LoginProviders"] as IReadOnlyList<LoginProviderContribution> ?? Array.Empty<LoginProviderContribution>();
    var signUps = ViewData["SignUps"] as bool? == true;
    var canResetPassword = ViewData["CanResetPassword"] as bool? == true;
    var unconfirmed = ViewData["Unconfirmed"] as bool? == true;
}

<div class="auth-heading">
    <h1>Sign in</h1>
    <p class="text-muted">Welcome back. Sign in to manage your site.</p>
</div>

<form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="form">
    @Html.AntiForgeryToken()
    <form-errors />
    <div class="field">
        <label class="field-label" for="email">Email</label>
        <input id="email" name="email" type="email" value="@email" required autocomplete="username" autofocus="@string.IsNullOrEmpty(email)" />
    </div>
    <div class="field">
        <div class="auth-label-row">
            <label class="field-label" for="password">Password</label>
            @if (canResetPassword)
            {
                <a href="/forgot-password">Forgot password?</a>
            }
        </div>
        <div class="input-affix">
            <input id="password" name="password" type="password" required autocomplete="current-password" autofocus="@(!string.IsNullOrEmpty(email))" />
            <button type="button" class="btn btn-ghost btn-icon btn-sm" data-reveal="#password" aria-pressed="false"
                    aria-label="Show password" data-js-only hidden>
                <icon name="eye" data-reveal-icon="show" />
                <icon name="eye-off" data-reveal-icon="hide" hidden />
            </button>
        </div>
    </div>
    <label class="check">
        <input type="checkbox" name="rememberMe" value="true" checked="@rememberMe" />
        <span class="check-text">Remember me<span class="check-hint">Stay signed in on this device for 30 days.</span></span>
    </label>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Sign in</button>
</form>

@if (unconfirmed)
{
    @* Email confirmation is on and this account hasn't confirmed yet (.docs/features/authentication.md). *@
    <form method="post" action="/confirm-email/resend">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@email" />
        <button type="submit" class="btn btn-block"><icon name="mail" /> Send the confirmation link again</button>
    </form>
}

@if (providers.Count > 0)
{
    @* External providers come from enabled authentication extensions (.docs/features/authentication.md). *@
    <div class="auth-divider"><span>or continue with</span></div>
    <div class="stack-sm">
        @foreach (var provider in providers)
        {
            <form method="post" action="/account/external/@Uri.EscapeDataString(provider.Scheme)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="btn btn-lg btn-block"><icon name="log-in" /> Sign in with @provider.DisplayName</button>
            </form>
        }
    </div>
}

@if (signUps)
{
    <p class="auth-switch">No account yet? <a href="/register">Create an account</a></p>
}
