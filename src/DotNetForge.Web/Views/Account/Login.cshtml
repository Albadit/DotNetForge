@using DotNetForge.Web.Services
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var email = ViewData["Email"] as string;
    var rememberMe = ViewData["RememberMe"] as bool? == true;
    var providers = ViewData["LoginProviders"] as IReadOnlyList<LoginOption> ?? Array.Empty<LoginOption>();
    var signUps = ViewData["SignUps"] as bool? == true;
    var canResetPassword = ViewData["CanResetPassword"] as bool? == true;
    var unconfirmed = ViewData["Unconfirmed"] as bool? == true;
}

<div class="dnf-auth__heading">
    <h1>Sign in</h1>
    <p class="text-muted">Welcome back. Sign in to manage your site.</p>
</div>

<form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="dnf-form">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />
    <div class="dnf-field">
        <label class="dnf-field__label" for="email">Email</label>
        <input class="dnf-input" id="email" name="email" type="email" value="@email" required autocomplete="username" autofocus="@string.IsNullOrEmpty(email)" />
    </div>
    <div class="dnf-field">
        <div class="dnf-auth__label-row">
            <label class="dnf-field__label" for="password">Password</label>
            @if (canResetPassword)
            {
                <a href="/forgot-password">Forgot password?</a>
            }
        </div>
        <div class="dnf-input-group">
            <input class="dnf-input" id="password" name="password" type="password" required autocomplete="current-password" autofocus="@(!string.IsNullOrEmpty(email))" />
            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm dnf-input-group__action" data-reveal="#password" aria-pressed="false"
                    aria-label="Show password" data-js-only hidden>
                <dnf-icon name="eye" data-reveal-icon="show" />
                <dnf-icon name="eye-off" data-reveal-icon="hide" hidden />
            </button>
        </div>
    </div>
    <label class="dnf-check">
        <input class="dnf-checkbox" type="checkbox" name="rememberMe" value="true" checked="@rememberMe" />
        <span class="dnf-check__text">Remember me<span class="dnf-check__description">Stay signed in on this device for 30 days.</span></span>
    </label>
    <button type="submit" class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width">Sign in</button>
</form>

@if (unconfirmed)
{
    @* Email confirmation is on and this account hasn't confirmed yet (.docs/features/authentication.md). *@
    <form method="post" action="/confirm-email/resend">
        @Html.AntiForgeryToken()
        <input type="hidden" name="email" value="@email" />
        <button type="submit" class="dnf-button dnf-button--secondary dnf-button--full-width"><dnf-icon name="mail" /> Send the confirmation link again</button>
    </form>
}

@if (providers.Count > 0)
{
    @* Providers: the built-in ones enabled on Providers, then those of enabled authentication extensions (.docs/features/authentication.md). *@
    <div class="dnf-divider dnf-divider--label"><span>or continue with</span></div>
    <div class="dnf-stack dnf-stack--sm">
        @foreach (var provider in providers)
        {
            <form method="post" action="/account/external/@Uri.EscapeDataString(provider.Scheme)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <button type="submit" class="dnf-button dnf-button--secondary dnf-button--lg dnf-button--full-width"><dnf-icon name="log-in" /> Sign in with @provider.DisplayName</button>
            </form>
        }
    </div>
}

@if (signUps)
{
    <p class="dnf-auth__switch">No account yet? <a href="/register">Create an account</a></p>
}
