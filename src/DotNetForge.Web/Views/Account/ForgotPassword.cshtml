@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="auth-heading">
    <h1>Forgot your password?</h1>
    <p class="text-muted">Enter your account's email address and we'll send you a link to choose a new password.</p>
</div>

<form method="post" action="/forgot-password" class="form">
    @Html.AntiForgeryToken()
    <div class="field">
        <label class="field-label" for="email">Email</label>
        <input id="email" name="email" type="email" required autocomplete="username" autofocus />
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block"><icon name="send" /> Send reset link</button>
</form>

<p class="auth-switch"><a href="/login">Back to sign in</a></p>
