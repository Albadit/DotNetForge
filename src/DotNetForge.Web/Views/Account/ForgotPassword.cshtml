@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<div class="dnf-auth__heading">
    <h1>Forgot your password?</h1>
    <p class="text-muted">Enter your account's email address and we'll send you a link to choose a new password.</p>
</div>

<form method="post" action="/forgot-password" class="dnf-form">
    @Html.AntiForgeryToken()
    <div class="dnf-field">
        <label class="dnf-field__label" for="email">Email</label>
        <input class="dnf-input" id="email" name="email" type="email" required autocomplete="username" autofocus />
    </div>
    <button type="submit" class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width"><dnf-icon name="send" /> Send reset link</button>
</form>

<p class="dnf-auth__switch"><a href="/login">Back to sign in</a></p>
