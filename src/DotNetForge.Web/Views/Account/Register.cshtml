@model DotNetForge.Web.Services.RegisterInput
@{
    ViewData["Title"] = "Create an account";
    Layout = "_AuthLayout";
}

<div class="dnf-auth__heading">
    <h1>Create an account</h1>
    <p class="text-muted">Sign up with your email address and a password.</p>
</div>

<form method="post" action="/register" class="dnf-form">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />
    <partial name="_AccountFields" model="Model" />
    <button type="submit" class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width">Create account</button>
</form>

<p class="dnf-auth__switch">Already have an account? <a href="/login">Sign in</a></p>
