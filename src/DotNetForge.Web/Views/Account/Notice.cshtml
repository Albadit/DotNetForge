@*
    A one-message screen for the self-service account flows: "check your email", invalid or expired links
    (.docs/features/authentication.md#self-service-accounts).
*@
@{
    Layout = "_AuthLayout";
    var problem = ViewData["Problem"] as bool? == true;
}

<div class="dnf-auth__heading dnf-auth__heading--state">
    <span class="dnf-dialog__icon@(problem ? " dnf-dialog__icon--danger" : "")" aria-hidden="true"><dnf-icon name="@(problem ? "circle-alert" : "mail")" /></span>
    <h1>@ViewData["Title"]</h1>
    <p class="text-muted">@ViewData["Text"]</p>
</div>

<a class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width" href="/login"><dnf-icon name="chevron-left" /> Back to sign in</a>
