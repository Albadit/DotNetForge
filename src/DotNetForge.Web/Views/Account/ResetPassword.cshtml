@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}

<div class="auth-heading">
    <h1>Choose a new password</h1>
    <p class="text-muted">After this, the link stops working and you sign in with the new password.</p>
</div>

<form method="post" action="/reset-password" class="form">
    @Html.AntiForgeryToken()
    <form-errors />
    <input type="hidden" name="token" value="@(ViewData["Token"] as string)" />
    <div class="field">
        <label class="field-label" for="password">New password</label>
        <div class="input-affix">
            <input id="password" name="password" type="password" required autocomplete="new-password" autofocus aria-describedby="password-hint" />
            <button type="button" class="btn btn-ghost btn-icon btn-sm" data-reveal="#password" aria-pressed="false"
                    aria-label="Show password" data-js-only hidden>
                <icon name="eye" data-reveal-icon="show" />
                <icon name="eye-off" data-reveal-icon="hide" hidden />
            </button>
        </div>
        <span class="field-hint" id="password-hint">At least 8 characters, including a letter and a number.</span>
    </div>
    <div class="field">
        <label class="field-label" for="confirmPassword">Confirm new password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password" />
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Change password</button>
</form>
