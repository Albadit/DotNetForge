@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_AuthLayout";
}

<div class="dnf-auth__heading">
    <h1>Choose a new password</h1>
    <p class="text-muted">After this, the link stops working and you sign in with the new password.</p>
</div>

<form method="post" action="/reset-password" class="dnf-form">
    @Html.AntiForgeryToken()
    <dnf-validation-summary />
    <input type="hidden" name="token" value="@(ViewData["Token"] as string)" />
    <div class="dnf-field">
        <label class="dnf-field__label" for="password">New password</label>
        <div class="dnf-input-group">
            <input class="dnf-input" id="password" name="password" type="password" required autocomplete="new-password" autofocus aria-describedby="password-hint" />
            <button type="button" class="dnf-button dnf-button--ghost dnf-button--icon-only dnf-button--sm dnf-input-group__action" data-reveal="#password" aria-pressed="false"
                    aria-label="Show password" data-js-only hidden>
                <dnf-icon name="eye" data-reveal-icon="show" />
                <dnf-icon name="eye-off" data-reveal-icon="hide" hidden />
            </button>
        </div>
        <span class="dnf-field__description" id="password-hint">At least 8 characters, including a letter and a number.</span>
    </div>
    <div class="dnf-field">
        <label class="dnf-field__label" for="confirmPassword">Confirm new password</label>
        <input class="dnf-input" id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password" />
    </div>
    <button type="submit" class="dnf-button dnf-button--primary dnf-button--lg dnf-button--full-width">Change password</button>
</form>
