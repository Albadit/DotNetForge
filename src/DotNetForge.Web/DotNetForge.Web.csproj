<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    DotNetForge.Web - the ASP.NET Core MVC host and composition root (.docs/architecture/codebase.md).
    Run it from the repository root with "dotnet run" and the project option pointing at src/DotNetForge.Web.
  -->

  <PropertyGroup>
    <UserSecretsId>dotnetforge-cms</UserSecretsId>
    <RootNamespace>DotNetForge.Web</RootNamespace>
    <AssemblyName>DotNetForge.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime Razor compilation so admin extensions can ship their own views under extensions/. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
  </ItemGroup>

  <!--
    Extensions live at the repository root (separate from the core) and are only read at runtime. They are copied
    into the publish output as extensions/ - None items, so the Razor SDK does not precompile extension views as
    part of the host. In development the app reads them from the repository root (see AppPaths).
  -->
  <ItemGroup>
    <None Include="../../extensions/**" LinkBase="extensions" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetForge.Abstractions/DotNetForge.Abstractions.csproj" />
    <ProjectReference Include="../DotNetForge.Shared/DotNetForge.Shared.csproj" />
    <ProjectReference Include="../DotNetForge.Core/DotNetForge.Core.csproj" />
    <ProjectReference Include="../DotNetForge.Data/DotNetForge.Data.csproj" />
    <ProjectReference Include="../DotNetForge.Infrastructure/DotNetForge.Infrastructure.csproj" />
    <ProjectReference Include="../DotNetForge.Extensions/DotNetForge.Extensions.csproj" />
    <ProjectReference Include="../DotNetForge.Api/DotNetForge.Api.csproj" />
  </ItemGroup>

</Project>
