<Project>

  <!--
    Compiles Styles/dnf.css into wwwroot/dnf.css with the Tailwind CSS CLI from npm (.docs/ui/styling.md#build). The
    version is pinned in tools/package.json + tools/package-lock.json at the repository root; the build installs it into
    tools/node_modules/ (git-ignored) with `npm ci` - once, and again only when the lock file changed - and runs it with
    NODE_PATH pointing there, so the stylesheet's `@import "tailwindcss"` resolves. Needs Node.js 20 or newer on the PATH.
    Release builds are minified. Upgrade: `npm install -E @tailwindcss/cli@<version>` in tools/.
  -->

  <PropertyGroup>
    <TailwindRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..'))</TailwindRepoRoot>
    <TailwindTools>$(TailwindRepoRoot)tools/</TailwindTools>
    <TailwindNodeModules>$(TailwindTools)node_modules/</TailwindNodeModules>
    <TailwindInstalled>$(TailwindNodeModules).package-lock.json</TailwindInstalled>
    <TailwindCli>$(TailwindNodeModules)@tailwindcss/cli/dist/index.mjs</TailwindCli>
    <TailwindInput>$(MSBuildProjectDirectory)/Styles/dnf.css</TailwindInput>
    <TailwindOutput>$(MSBuildProjectDirectory)/wwwroot/dnf.css</TailwindOutput>
    <TailwindMinify Condition="'$(Configuration)' == 'Release'">--minify</TailwindMinify>
    <TailwindMinify Condition="'$(Configuration)' != 'Release'">--map</TailwindMinify>
    <TailwindBuiltFor>$(MSBuildProjectExtensionsPath)tailwind.configuration</TailwindBuiltFor>
  </PropertyGroup>

  <!-- Everything the stylesheet depends on: its sources, and the markup Tailwind scans for utility classes. -->
  <ItemGroup>
    <TailwindInputs Include="$(MSBuildProjectDirectory)/Styles/**/*.css" />
    <TailwindInputs Include="$(MSBuildProjectDirectory)/**/*.cs;$(MSBuildProjectDirectory)/wwwroot/*.js" Exclude="$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**" />
    <TailwindInputs Include="$(TailwindRepoRoot)src/DotNetForge.Web/**/*.cshtml;$(TailwindRepoRoot)src/DotNetForge.Web/**/*.cs;$(TailwindRepoRoot)src/DotNetForge.Web/wwwroot/js/**/*.js"
                    Exclude="$(TailwindRepoRoot)src/DotNetForge.Web/obj/**;$(TailwindRepoRoot)src/DotNetForge.Web/bin/**" />
    <TailwindInputs Include="$(TailwindRepoRoot)extensions/**/*.cshtml;$(TailwindRepoRoot)extensions/**/*.cs;$(TailwindRepoRoot)extensions/**/*.js" Exclude="$(TailwindRepoRoot)extensions/**/bin/**;$(TailwindRepoRoot)extensions/**/obj/**" />
  </ItemGroup>

  <!-- `npm ci` in tools/ when node_modules is missing or older than the lock file (first build, after an upgrade). -->
  <Target Name="DnfTailwindInstall" Inputs="$(TailwindTools)package.json;$(TailwindTools)package-lock.json" Outputs="$(TailwindInstalled)">
    <Exec Command="node --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_TailwindNodeExit" />
    </Exec>
    <Error Condition="'$(_TailwindNodeExit)' != '0'"
           Text="Node.js 20 or newer is needed to build the UI stylesheet (Tailwind CSS from npm): install it from https://nodejs.org and build again (.docs/guides/development.md#tailwind-css-on-the-first-build)." />
    <Message Importance="high" Text="Installing the Tailwind CSS CLI (npm ci in tools/) - once, and after an upgrade." />
    <!-- No install scripts: the CLI needs none (@parcel/watcher's only builds from source, for watch mode). -->
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(TailwindTools)" StandardOutputImportance="low" />
    <Touch Files="$(TailwindInstalled)" />
  </Target>

  <ItemGroup>
    <Content Remove="wwwroot\dnf.css" />
  </ItemGroup>

  <!-- dnf.css is one file for every configuration, and up to date by its sources alone: a Release build right after a
       Debug one would ship the readable stylesheet. So switching configuration builds it again. -->
  <Target Name="DnfTailwindConfiguration" BeforeTargets="DnfTailwindBuild" Condition="'$(DnfSkipTailwind)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_TailwindLastBuiltFor Condition="Exists('$(TailwindBuiltFor)')">$([System.IO.File]::ReadAllText('$(TailwindBuiltFor)').Trim())</_TailwindLastBuiltFor>
    </PropertyGroup>
    <Delete Files="$(TailwindOutput)" Condition="'$(_TailwindLastBuiltFor)' != '$(Configuration)'" />
    <WriteLinesToFile File="$(TailwindBuiltFor)" Lines="$(Configuration)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Before the static web assets are collected, so a clean build already serves the fresh dnf.css. Not in IDE
       design-time builds: they need no stylesheet, and would run npm next to the real build.
       DnfSkipTailwind=true: compile only (parallel builds of one checkout must not all write wwwroot/dnf.css). -->
  <Target Name="DnfTailwindBuild" Condition="'$(DesignTimeBuild)' != 'true' And ('$(DnfSkipTailwind)' != 'true' Or !Exists('$(TailwindOutput)'))"
          BeforeTargets="BeforeBuild;ResolveProjectStaticWebAssets" DependsOnTargets="DnfTailwindInstall"
          Inputs="@(TailwindInputs);$(TailwindInstalled);$(MSBuildThisFileFullPath)" Outputs="$(TailwindOutput)">
    <Exec Command="node &quot;$(TailwindCli)&quot; --input &quot;$(TailwindInput)&quot; --output &quot;$(TailwindOutput)&quot; $(TailwindMinify)"
          WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="NODE_PATH=$(TailwindNodeModules)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" />
    <!-- The default Content glob skips the compiled file (above): it is added here, after it was written, so even a
         clean build serves it. -->
    <ItemGroup>
      <Content Include="wwwroot/dnf.css" />
    </ItemGroup>
  </Target>

</Project>
