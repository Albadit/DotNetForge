@using DotNetForge.Shared.Entities
@model Page
@{
    Layout = null;
    var title = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;
    var routeValues = ViewData["RouteValues"] as IDictionary<string, string>;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (!string.IsNullOrWhiteSpace(Model.MetaDescription))
    {
        <meta name="description" content="@Model.MetaDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(Model.CanonicalUrl))
    {
        <link rel="canonical" href="@Model.CanonicalUrl" />
    }
    <style>
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: #0f172a; background: #fff; }
        main { max-width: 720px; margin: 0 auto; padding: 64px 24px; }
        h1 { font-size: 32px; margin: 0 0 8px; }
        .slug { color: #64748b; font-size: 14px; }
        .note { margin-top: 32px; padding: 16px; border: 1px dashed #cbd5e1; border-radius: 12px; color: #475569; font-size: 14px; }
        a { color: #4f46e5; }
    </style>
</head>
<body>
    <main>
        <h1>@Model.Title</h1>
        <div class="slug">/@Model.Slug</div>
        @if (routeValues is { Count: > 0 })
        {
            <div class="slug">
                Dynamic route parameters: @string.Join(", ", routeValues.Select(kv => $"{kv.Key} = {kv.Value}"))
            </div>
        }
        <div class="note">
            This page is published, but it has no builder content yet. The public page builder, themes, and
            layouts are not part of the foundation. Manage this page in the
            <a href="/admin/content">Content Manager</a>.
        </div>
    </main>
</body>
</html>
