  "css": ".pe-root.pe-n-n0{display:flex;flex-direction:column;gap:16px;align-items:stretch;justify-content:flex-start;flex-wrap:nowrap}\n.pe-root a.pe-n-n1{display:flex;flex-direction:column;gap:157px;align-items:flex-end;justify-content:flex-start;flex-wrap:nowrap;max-width:110px;padding:24px 79px 77px 44px;margin:-8px 47px 64px 61px;overflow:clip;font-style:normal}\n.pe-root a.pe-n-n2{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:111px;column-gap:16px;row-gap:16px;min-width:134px;justify-self:auto;padding:46px 73px 27px 28px;text-transform:capitalize}\n.pe-root .pe-n-n3{grid-column:12 / span 1;grid-row:6 / span 1;border-top:14px solid currentColor}\n@media (max-width:1023.98px){.pe-root .pe-n-n3{grid-column:1 / span 1;grid-row:3 / span 6}}\n@media (max-width:639.98px){.pe-root .pe-n-n3{max-width:119.93px;rotate:164.44deg;z-index:256;padding:19px 12px 61px 43px;margin:6px 2px -22px 71px;font-family:Georgia,Cambria,\"Times New Roman\",Times,serif;letter-spacing:4.83px}}\n.pe-root .pe-n-n4{grid-column:span 4;grid-row:span 6;min-width:392px;border-width:17px;border-style:solid;color:hsl(200 50% 50%);font-weight:800}\n.pe-root .pe-n-n6>.pe-in{display:flex;flex-direction:row;gap:16px;align-items:stretch;justify-content:flex-start;flex-wrap:nowrap;max-width:865px;margin-inline:auto}\n@media (min-width:1024px){.pe-root .pe-hide-d{display:none!important}}\n@media (min-width:640px) and (max-width:1023.98px){.pe-root .pe-hide-t{display:none!important}}\n@media (max-width:639.98px){.pe-root .pe-hide-m{display:none!important}}"
