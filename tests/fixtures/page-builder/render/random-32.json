  "css": ".pe-root.pe-n-n0{display:flex;flex-direction:column;gap:16px;align-items:stretch;justify-content:flex-start;flex-wrap:nowrap}\n.pe-root .pe-n-n1{flex:1 1 0px;min-height:420.15px;z-index:47;aspect-ratio:5.54;background-color:#fff;background-size:auto;overflow:visible;color:rgb(10, 20, 30)}.pe-root .pe-n-n1>.pe-in{display:block;position:relative;height:21px;max-width:1122px;margin-inline:auto}\n.pe-root a.pe-n-n2{display:flex;flex-direction:column;gap:240px;align-items:stretch;justify-content:flex-start;flex-wrap:nowrap;position:absolute;left:0px;top:210px;width:124px;height:599px;aspect-ratio:9.8;border-width:22px;border-style:solid;font-family:Georgia,Cambria,\"Times New Roman\",Times,serif;letter-spacing:17.52px;font-style:normal}\n@media (max-width:1023.98px){.pe-root a.pe-n-n2{flex-direction:row;gap:296px;max-height:30px;z-index:-12;border-radius:26px 14px 22px 65px;line-height:3}}\n.pe-root .pe-n-n3{z-index:170;background-size:cover;border-style:dotted;font-weight:300;font-style:normal;--a:1px}\n@media (max-width:639.98px){.pe-root .pe-n-n3{aspect-ratio:2.86;overflow:hidden;color:rgb(10, 20, 30);font-size:87px;letter-spacing:13.11px}}\n.pe-root .pe-n-n5{position:absolute;left:0px;top:43px;width:240px;height:120px;outline-style:dashed}\n@media (max-width:1023.98px){.pe-root .pe-n-n5{left:118px;top:261px;width:269px;height:172px}}\n@media (max-width:639.98px){.pe-root .pe-n-n5{left:220px;width:149px;max-width:200px;align-self:end;z-index:354;aspect-ratio:5.43;background-repeat:repeat-y;outline-style:none;box-shadow:none;overflow:visible;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace;letter-spacing:36.64px;text-align:center;text-transform:capitalize}}\n.pe-root .pe-n-n6>.pe-in{display:flex;flex-direction:row;gap:16px;align-items:center;justify-content:flex-start;flex-wrap:wrap;max-width:69px;margin-inline:auto}\n@media (max-width:639.98px){.pe-root .pe-n-n6{padding:78px 51px 41px 49px;border-style:dashed;border-color:rgb(10, 20, 30);line-height:3.33;border-width:23px 37px 0px 19px}}\n.pe-root .pe-n-n7{z-index:369;background-color:var(--dnn-color-primary);width:229px;height:229px}\n@media (max-width:1023.98px){.pe-root .pe-n-n7{background-size:contain;border-radius:66px 55px 33px 12px}}\n@media (min-width:1024px){.pe-root .pe-hide-d{display:none!important}}\n@media (min-width:640px) and (max-width:1023.98px){.pe-root .pe-hide-t{display:none!important}}\n@media (max-width:639.98px){.pe-root .pe-hide-m{display:none!important}}"
