  "html": "<div class=\"pe-root pe-node pe-t-page pe-n-root\"><section class=\"pe-node pe-t-section pe-n-dash\"><div class=\"pe-in\"><figure class=\"pe-node pe-t-image pe-n-banner pe-fit-cover\"><img src=\"/Portals/0/banner.jpg\" alt=\"Centrum De Binnenstad\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"pe-node pe-t-module pe-n-activity\" data-pe-module=\"2472\"><!--pe:module:2472--></div><div class=\"pe-node pe-t-container pe-n-discover\"><h3 class=\"pe-node pe-t-heading pe-n-dtitle\">Ontdek</h3><nav class=\"pe-node pe-t-links pe-n-dlinks pe-links-column\"><ul><li><a href=\"/community\">Community</a></li></ul></nav></div><div class=\"pe-node pe-t-module pe-n-groups\" data-pe-module=\"2473\"><!--pe:module:2473--></div></div></section></div>",
  "css": ".pe-root.pe-n-root{display:flex;flex-direction:column;gap:0px;align-items:stretch;justify-content:flex-start;flex-wrap:nowrap}\n.pe-root .pe-n-dash{padding:24px 24px 24px 24px;background-color:#f6f7f9}.pe-root .pe-n-dash>.pe-in{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:120px;column-gap:16px;row-gap:16px}\n@media (max-width:1023.98px){.pe-root .pe-n-dash>.pe-in{grid-template-columns:repeat(6,minmax(0,1fr))}}\n@media (max-width:639.98px){.pe-root .pe-n-dash>.pe-in{grid-template-columns:repeat(1,minmax(0,1fr));grid-auto-rows:minmax(120px,auto)}}\n.pe-root .pe-n-banner{grid-column:1 / span 8;grid-row:1 / span 2;border-radius:12px 12px 12px 12px}\n@media (max-width:1023.98px){.pe-root .pe-n-banner{grid-column:span 6;grid-row:span 2}}\n@media (max-width:639.98px){.pe-root .pe-n-banner{grid-column:span 1}}\n.pe-root .pe-n-activity{grid-column:9 / span 4;grid-row:1 / span 4}\n@media (max-width:1023.98px){.pe-root .pe-n-activity{grid-column:span 4;grid-row:span 4}}\n@media (max-width:639.98px){.pe-root .pe-n-activity{grid-column:span 1}}\n.pe-root .pe-n-discover{display:block;position:relative;height:200px;grid-column:1 / span 8;grid-row:3 / span 2;padding:16px 16px 16px 16px;background-color:#ffffff;border-radius:12px 12px 12px 12px;box-shadow:0 1px 2px rgba(0,0,0,.08)}\n@media (max-width:1023.98px){.pe-root .pe-n-discover{grid-column:span 6;grid-row:span 2}}\n@media (max-width:639.98px){.pe-root .pe-n-discover{grid-column:span 1}}\n.pe-root .pe-n-dtitle{position:absolute;left:0px;top:0px;width:240px;height:120px}\n.pe-root .pe-n-dlinks{position:absolute;left:0px;top:0px;width:240px;height:120px}\n.pe-root .pe-n-groups{grid-column:1 / span 12;grid-row:5 / span 2}\n@media (max-width:1023.98px){.pe-root .pe-n-groups{grid-column:span 6;grid-row:span 2}}\n@media (max-width:639.98px){.pe-root .pe-n-groups{grid-column:span 1}}\n@media (min-width:1024px){.pe-root .pe-hide-d{display:none!important}}\n@media (min-width:640px) and (max-width:1023.98px){.pe-root .pe-hide-t{display:none!important}}\n@media (max-width:639.98px){.pe-root .pe-hide-m{display:none!important}}"
