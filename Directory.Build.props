<Project>

  <!--
    Shared MSBuild properties for every DotNetForge CMS project.
    Centralizes the .NET 10 target framework and language settings so each
    .csproj stays small. Project layout: .docs/architecture/codebase.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
