# DotNetForge CMS configuration (.docs/features/configuration.md).
# Copy this file to ".env" for local development. Real environment variables override values here.
# To develop against a local S3 server (RustFS or Ceph) and SMTP (Mailpit) instead, copy ".env.developer".
# Secrets live in ".env" or in your host's secret store and must NEVER be committed (see .gitignore).
#
# Development (ASPNETCORE_ENVIRONMENT=Development): set DATABASE_CONNECTION_STRING to a local PostgreSQL
# (docker compose -f docker/databases/postgres.yml up -d); uploaded media go to storage/ at the repository root.
# Outside Development the deployment directory is read-only, so the database and media must be configured
# explicitly (PostgreSQL, and S3-compatible storage) - see .docs/guides/deployment.md.

# ---- Database ------------------------------------------------------------------------------------
# The CMS runs on PostgreSQL (.docs/database/configuration.md); DATABASE_CONNECTION_STRING is required - startup stops
# without it. The local server of docker/databases/postgres.yml (also in docker/compose.dev.yml) is:
#   Host=localhost;Port=5432;Database=dotnetforge;Username=postgres;Password=postgres;GSS Encryption Mode=Disable
# In production e.g. Host=db.example.com;Port=5432;Database=dotnetforge;Username=dotnetforge;Password=<secret>;GSS Encryption Mode=Disable
DATABASE_CONNECTION_STRING=

# More databases for your own data (optional), e.g. for extensions and custom API endpoints - any of sqlite,
# postgresql, sqlserver, mysql, mongodb: DATABASES_<NAME>_PROVIDER and DATABASES_<NAME>_CONNECTION_STRING, e.g.
#   DATABASES_REPORTS_PROVIDER=sqlserver
#   DATABASES_REPORTS_CONNECTION_STRING=Server=reports.example.com;Initial Catalog=reports;User Id=reader;Password=<secret>;TrustServerCertificate=true

# ---- Application ---------------------------------------------------------------------------------
APP_NAME=DotNetForge CMS
APP_URL=http://localhost:5000

# ---- File storage (uploaded media): any S3-compatible service --------------------------------------
# Leave all empty in Development to store uploads in storage/media; required everywhere else.
# The service is chosen by the endpoint, not by a provider name:
# - Cloudflare R2: STORAGE_S3_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com (region defaults to auto)
# - AWS S3:        leave STORAGE_S3_SERVICE_URL empty and set STORAGE_S3_REGION (e.g. eu-central-1)
# - MinIO, Supabase, the local server from docker/s3/seaweedfs.yml (http://localhost:8333):
#                  set the endpoint and STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_SERVICE_URL=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_REGION=
STORAGE_S3_FORCE_PATH_STYLE=false

# ---- Email (SMTP) - optional ------------------------------------------------------------------------
# Needed for "Forgot password?" and email confirmation (.docs/features/email.md). Leave all empty to send no email.
# SMTP_HOST and SMTP_FROM are required once a host, sender or credential is set. Defaults: SMTP_PORT=587,
# SMTP_TLS=true (STARTTLS), SMTP_FROM_NAME = APP_NAME.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_TLS=
