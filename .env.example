# DotNetForge CMS configuration (.docs/features/configuration.md).
# Copy this file to ".env" for local development. Real environment variables override values here.
# Secrets live in ".env" or in your host's secret store and must NEVER be committed (see .gitignore).
#
# Development (ASPNETCORE_ENVIRONMENT=Development) works with this file as-is: SQLite and uploaded
# media go to ./storage/. Outside Development the deployment directory is read-only, so the database
# and media must be configured explicitly (PostgreSQL or an absolute SQLite path on a volume, and
# S3-compatible storage or an absolute local path on a volume) - see .docs/guides/deployment.md.

# ---- Database ------------------------------------------------------------------------------------
# "sqlite" (default) or "postgresql".
DATABASE_PROVIDER=sqlite

# - sqlite: leave empty in Development (uses ./storage/dotnetforge.db); elsewhere an absolute path,
#   e.g. Data Source=/data/dotnetforge.db
# - postgresql: required, e.g.
#   Host=localhost;Port=5432;Database=dotnetforge;Username=postgres;Password=<secret>;GSS Encryption Mode=Disable
DATABASE_CONNECTION_STRING=

# ---- Application ---------------------------------------------------------------------------------
APP_NAME=DotNetForge CMS
APP_URL=http://localhost:5000

# ---- File storage (uploaded media) ---------------------------------------------------------------
# "local" (default) or "s3" (Cloudflare R2, AWS S3, MinIO, Supabase Storage S3 endpoint, ...).
STORAGE_PROVIDER=local

# local: leave empty in Development (uses ./storage/media); elsewhere an absolute path on a volume.
STORAGE_LOCAL_PATH=

# s3: required when STORAGE_PROVIDER=s3. Example for Cloudflare R2:
#   STORAGE_S3_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_S3_REGION=auto
# AWS S3: leave STORAGE_S3_SERVICE_URL empty and set STORAGE_S3_REGION (e.g. eu-central-1).
# Local S3 server from compose.dev.yml: http://localhost:8333 with STORAGE_S3_FORCE_PATH_STYLE=true.
STORAGE_S3_SERVICE_URL=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_REGION=
STORAGE_S3_FORCE_PATH_STYLE=false
