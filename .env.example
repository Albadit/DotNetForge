# DotNetForge CMS configuration (.docs/features/configuration.md).
# Copy this file to ".env" for local development. Real environment variables override values here.
# Secrets live in ".env" or in your host's secret store and must NEVER be committed (see .gitignore).
#
# Development (ASPNETCORE_ENVIRONMENT=Development) works with this file as-is: SQLite and uploaded
# media go to storage/ at the repository root. Outside Development the deployment directory is
# read-only, so the database and media must be configured explicitly (PostgreSQL or an absolute SQLite
# path on a volume, and S3-compatible storage or an absolute local path on a volume) - see
# .docs/guides/deployment.md.

# ---- Database ------------------------------------------------------------------------------------
# DATABASE_PROVIDER: sqlite, postgresql, sqlserver, mysql or mongodb (.docs/database/configuration.md).
# Leave it empty to detect it from the connection string (MySQL is never detected: set it).
DATABASE_PROVIDER=

# Leave empty in Development for SQLite at storage/dotnetforge.db. Examples:
# - sqlite:     Data Source=/data/dotnetforge.db   (an absolute path outside Development)
# - postgresql: Host=localhost;Port=5432;Database=dotnetforge;Username=postgres;Password=<secret>;GSS Encryption Mode=Disable
# - sqlserver:  Server=localhost,1433;Initial Catalog=dotnetforge;User Id=sa;Password=<secret>;TrustServerCertificate=true
# - mysql:      Server=localhost;Port=3306;Database=dotnetforge;Uid=root;Pwd=<secret>
# - mongodb:    mongodb://<user>:<secret>@localhost:27017/dotnetforge?replicaSet=rs0   (needs a replica set or Atlas)
DATABASE_CONNECTION_STRING=

# MongoDB only, when the database name is not in the URL path.
DATABASE_NAME=

# More databases for IDatabaseService (optional): DATABASES_<NAME>_PROVIDER, DATABASES_<NAME>_CONNECTION_STRING,
# DATABASES_<NAME>_NAME, e.g. DATABASES_REPORTS_PROVIDER=postgresql

# ---- Application ---------------------------------------------------------------------------------
APP_NAME=DotNetForge CMS
APP_URL=http://localhost:5000

# ---- File storage (uploaded media): any S3-compatible service --------------------------------------
# Leave all empty in Development to store uploads in storage/media; required everywhere else.
# The service is chosen by the endpoint, not by a provider name:
# - Cloudflare R2: STORAGE_S3_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com (region defaults to auto)
# - AWS S3:        leave STORAGE_S3_SERVICE_URL empty and set STORAGE_S3_REGION (e.g. eu-central-1)
# - MinIO, Supabase, the local server from docker/compose.dev.yml (http://localhost:8333):
#                  set the endpoint and STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_SERVICE_URL=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_REGION=
STORAGE_S3_FORCE_PATH_STYLE=false
