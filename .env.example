# DotNetForge CMS configuration.
# Copy this file to ".env" and adjust the values before first run.
# Secrets live in ".env" and must NEVER be committed to Git (see .gitignore).

# Database provider: "sqlite" (default) or "postgresql".
DATABASE_PROVIDER=sqlite

# Connection string for the chosen provider.
#   - sqlite: may be left empty to use the default local file (storage/dotnetforge.db).
#   - postgresql: REQUIRED and non-empty, e.g.
#     Host=localhost;Port=5432;Database=dotnetforge;Username=postgres;Password=postgres
DATABASE_CONNECTION_STRING=

# Display name of the application.
APP_NAME=DotNetForge CMS

# Public base URL used for absolute links/redirects.
APP_URL=http://localhost:5000
