@model SettingsIndexViewModel
@{
    ViewData["Title"] = "Settings";
}

@if (TempData["Success"] is string ok)
{
    <p class="flash ok">@ok</p>
}

<p class="muted">Key/value settings for <strong>@Model.AppName</strong>. Global settings (no tenant) are read-only here; saving creates or updates a tenant-scoped value.</p>

<div class="content-layout">
    <section class="panel">
        @if (Model.Settings.Count == 0)
        {
            <p class="muted">No settings yet.</p>
        }
        else
        {
            <table class="data">
                <thead><tr><th>Key</th><th>Value</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Settings)
                    {
                        <tr><td><code>@s.Key</code></td><td>@s.Value</td></tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <aside class="panel">
        <h2>Add / update</h2>
        <div asp-validation-summary="All" class="validation-summary"></div>
        <form method="post" asp-area="Admin" asp-controller="Settings" asp-action="Save" class="form-narrow">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <label for="key">Key <span class="req">*</span></label>
                <input id="key" name="key" required />
            </div>
            <div class="form-row">
                <label for="value">Value</label>
                <input id="value" name="value" />
            </div>
            <button type="submit" class="btn primary">Save setting</button>
        </form>
    </aside>
</div>
