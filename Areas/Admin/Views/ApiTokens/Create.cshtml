@{
    ViewData["Title"] = "Create API token";
    var permissions = ViewBag.Permissions as IReadOnlyList<string> ?? Array.Empty<string>();
}

<div asp-validation-summary="All" class="validation-summary"></div>

<form method="post" asp-action="Create" class="form-narrow">
    @Html.AntiForgeryToken()
    <div class="form-row">
        <label for="name">Name <span class="req">*</span></label>
        <input id="name" name="name" required />
    </div>
    <div class="form-row">
        <label for="description">Description</label>
        <input id="description" name="description" />
    </div>
    <div class="form-row">
        <label for="duration">Duration</label>
        <select id="duration" name="duration">
            <option value="7">7 days</option>
            <option value="30" selected>30 days</option>
            <option value="90">90 days</option>
            <option value="unlimited">Unlimited</option>
        </select>
    </div>
    <div class="form-row">
        <label>Permissions <span class="req">*</span></label>
        <div class="checkbox-grid">
            @foreach (var permission in permissions)
            {
                <label class="check"><input type="checkbox" name="permissions" value="@permission" /> <code>@permission</code></label>
            }
        </div>
    </div>
    <button type="submit" class="btn primary">Generate token</button>
    <a class="btn" href="/admin-legacy/api-tokens">Cancel</a>
</form>
