@model IReadOnlyList<DotNetForge.Web.Areas.Admin.Models.PageTreeNode>
@{
    var selectedId = ViewData["SelectedId"] as Guid?;
}
<ul class="page-tree">
    @foreach (var node in Model)
    {
        var isSelected = selectedId == node.Id;
        var dot = node.Disabled ? "off" : node.Published ? "on" : "draft";
        <li class="tree-item" draggable="true" data-id="@node.Id">
            <div class="tree-row @(isSelected ? "active" : "")">
                <span class="drag-handle" title="Drag to reorder">⠿</span>
                <a class="tree-link" href="/admin/content?selected=@node.Id">
                    <span class="dot @dot" title="@dot"></span>
                    @node.Title <span class="muted">/@node.Slug.TrimStart('/')</span>
                </a>
                <button type="submit" class="tree-add" form="treeActions"
                        formaction="/admin/content/create?parent=@node.Id" title="Add child page">+</button>
            </div>
            @if (node.Children.Count > 0)
            {
                <partial name="_TreeNodes" model="node.Children" />
            }
        </li>
    }
</ul>
