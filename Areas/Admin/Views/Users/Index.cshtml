@model List<UsersController.UserListItem>
@{
    ViewData["Title"] = "Users";
}

<p class="muted">Users with access to this tenant.</p>

<table class="data">
    <thead>
        <tr><th>Email</th><th>Name</th><th>Roles</th><th>Status</th><th>Last login</th></tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td><strong>@user.Email</strong></td>
            <td>@user.Name</td>
            <td>@string.Join(", ", user.Roles)</td>
            <td><span class="badge @(user.Status == "Enabled" ? "ok" : "warn")">@user.Status</span></td>
            <td class="muted">@(user.LastLogin?.ToString("u") ?? "never")</td>
        </tr>
    }
    </tbody>
</table>
