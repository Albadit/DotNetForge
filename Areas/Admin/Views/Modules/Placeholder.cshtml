@model ModulePlaceholderViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="panel">
    <h2>@Model.Title</h2>
    <p>@Model.Description</p>
    <p class="muted">
        This module is part of the DotNetForge CMS specification
        (<code>prompt/@Model.SpecFile</code>). Its data model and foundation are in place;
        the full admin UI is layered on top of this scaffold.
    </p>
</div>
