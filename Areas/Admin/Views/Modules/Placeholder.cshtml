@model ModulePlaceholderViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="panel">
    <h2>@Model.Title</h2>
    <p>@Model.Description</p>
    <p class="muted">
        This module is planned but not built yet. Its planned behaviour is documented in
        <code>@Model.DocPath</code> (section "Planned (not implemented)").
    </p>
</div>
