@model List<RolesController.RoleListItem>
@{
    ViewData["Title"] = "Roles";
}

<p class="muted">RBAC roles for the active tenant. Built-in roles cannot be deleted or renamed.</p>

<table class="data">
    <thead>
        <tr><th>Name</th><th>Description</th><th>Type</th><th>Users</th><th>Permissions</th></tr>
    </thead>
    <tbody>
    @foreach (var role in Model)
    {
        <tr>
            <td><strong>@role.Name</strong></td>
            <td class="muted">@role.Description</td>
            <td>@(role.IsBuiltIn ? "Built-in" : "Custom")</td>
            <td>@role.Users</td>
            <td>@role.Permissions</td>
        </tr>
    }
    </tbody>
</table>
