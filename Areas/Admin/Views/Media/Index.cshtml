@model IReadOnlyList<MediaRowViewModel>
@{
    ViewData["Title"] = "Media";
}

<p class="muted">Uploaded files for the active tenant. Uploading is handled through the API / file manager (file_manager.md).</p>

@if (Model.Count == 0)
{
    <div class="panel"><p class="muted">No media files yet.</p></div>
}
else
{
    <table class="data">
        <thead>
            <tr><th>File</th><th>Type</th><th>Size</th><th>Access</th><th>Uploaded</th></tr>
        </thead>
        <tbody>
            @foreach (var file in Model)
            {
                <tr>
                    <td>@file.FileName</td>
                    <td><code>@file.ContentType</code></td>
                    <td>@($"{file.SizeBytes / 1024.0:0.#} KB")</td>
                    <td>
                        @if (file.IsPublic)
                        {
                            <span class="badge ok">Public</span>
                        }
                        else
                        {
                            <span class="badge warn">Private</span>
                        }
                    </td>
                    <td>@file.UploadedDate.ToString("u")</td>
                </tr>
            }
        </tbody>
    </table>
}
