# DotNetForge CMS - development against production-like services (.docs/guides/development.md#production-like-s3-and-email).
#
# Media go to a real S3 server with access keys and signed requests, and email goes over SMTP with a sign-in - the
# same code paths as in production - while everything runs locally in Docker. All values below are public development
# credentials for the containers of docker/compose.dev.yml: never use them anywhere else.
#
#   1. cp .env.developer .env
#   2. docker compose -f docker/compose.dev.yml up -d          (PostgreSQL + RustFS + Mailpit)
#      Ceph instead of RustFS: docker compose -f docker/databases/postgres.yml -f docker/s3/ceph.yml -f docker/mail/mailpit.yml up -d
#      and swap the S3 blocks below (Ceph needs about a minute on its first start).
#   3. dotnet run --project src/DotNetForge.Web
#
# The keys are the .env.example contract (.docs/features/configuration.md); real environment variables still win.

# ---- Database: PostgreSQL 17 (docker/databases/postgres.yml) -------------------------------------------------------
# Port 5432 taken by another PostgreSQL? Start compose with DNF_POSTGRES_PORT=5433 (PowerShell: $env:DNF_POSTGRES_PORT=5433)
# and set Port=5433 below. The CMS always runs on PostgreSQL; other databases can be added as DATABASES_<NAME>_*.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=dotnetforge;Username=postgres;Password=postgres;GSS Encryption Mode=Disable

# ---- Application ---------------------------------------------------------------------------------
APP_NAME=DotNetForge CMS
APP_URL=http://localhost:5000

# ---- File storage: choose ONE S3 server ------------------------------------------------------------
# Both use path-style URLs (http://host/bucket/key) like most self-hosted S3 servers, and region us-east-1.

# RustFS (docker/s3/rustfs.yml) - S3 API http://localhost:9000, console http://localhost:9001/rustfs/console/ (sign in with the keys)
STORAGE_S3_SERVICE_URL=http://localhost:9000
STORAGE_S3_BUCKET=dotnetforge
STORAGE_S3_ACCESS_KEY_ID=dotnetforge-dev
STORAGE_S3_SECRET_ACCESS_KEY=dotnetforge-dev-secret
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# ---- Email: Mailpit (docker/mail/mailpit.yml) ---------------------------------------------------------------
# Every email lands in the inbox at http://localhost:8026 - nothing reaches a real mailbox. Mailpit requires the
# sign-in below like a production server; TLS is off because its certificate would be self-signed.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USERNAME=dotnetforge
SMTP_PASSWORD=dotnetforge-dev
SMTP_FROM=cms@dotnetforge.test
SMTP_FROM_NAME=DotNetForge CMS (dev)
SMTP_TLS=false

# ---- Video compression: optional ------------------------------------------------------------------
# Set to your ffmpeg executable to try video compression (Settings > Media Library); empty = videos stay as uploaded.
FFMPEG_PATH=

# ---- SMS codes: optional ----------------------------------------------------------------------------
# Twilio credentials for SMS sign-in codes (Two-factor (MFA)); set all three or none. Empty = SMS codes unavailable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
